            <script type="text/javascript">
                var playlist;

                function buildJplayerPlaylist(page, data) {
                    playlist = new Array();
                    var media;

                    $('.rss-tracks ul').html('');
                    $.each(data[Object.keys(data)[page]], function(index, value) {
                        var media_mime_supported = true;
                        media = {
                            title: value.CcFiles.track_title,
                            artist: value.CcFiles.artist_name,
                        }

                        if (value.mime == "mp3" || value.mime == "ogg" || value.mime == "m4a" || value.mime == "wav") {
                            media.src = value.download_url;
                        } else {
                            media_mime_supported = false;
                        }

                        var podcast_title_link = "<a class='podcast_title jp-playlist-item' tabindex='0' href='#'>" + value.CcFiles.track_title + "</a>";
                        var podcast_title_no_link = "<div class='podcast_title'>" + value.CcFiles.track_title + "</div>";
                        var playlist_metadata = "<span class='podcast_date'>" + value.publication_date + "</span>" +
                            "<span class='podcast_length'>" + value.CcFiles.length + "</span>" +
                            "<span class='podcast_desc_btn'>Description</span>" +
                            "<div class='podcast_desc'>" + value.CcFiles.description + "</div>";

                        if (media_mime_supported) {
                            playlist.push(media);

                            var playlist_item = "<li class='jp-playlist-item'><div class='podcast_info'>";

                            playlist_item += podcast_title_link + playlist_metadata;

                            playlist_item += "<div class='podcast_btn_group'>" +
                                "<span class='podcast_play podcast_action_btn'><a href='#' id='rss-track' data-rss-playlist-id='" + index + "'><img src='css/radio-page/img/podcast_play.png'></a></span>" +
                                "<span class='podcast_download podcast_action_btn'><a id='rss-download-link' href='" + value.download_url + "'><img src='css/radio-page/img/podcast_download.png'></a></span> </div></div></li>";

                        } else {
                            // add empty media item to playlist so indexes stay inline with the corret
                            // audio and metadata
                            playlist.push({});

                            var playlist_item = "<div class='playlist-item-no-preview podcast_info'>";
                            playlist_item += podcast_title_no_link + playlist_metadata;
                            playlist_item += "<div class='podcast_btn_group'>" +
                                "<span class='podcast_no_play'><img src='css/radio-page/img/podcast_no_play.png'></span>" +
                                "<span class='podcast_download podcast_action_btn'><a id='rss-download-link' href='" + value.download_url + "'><img src='css/radio-page/img/podcast_download.png'></a></span> </div></div>";
                        }

                        $('.rss-tracks ul').append(playlist_item);

                    });

                    _podcastPlayer.setPlaylist(playlist);

                    $('.podcast_play').on('click', function() {
                        _podcastPlayer.play($(this).find('#rss-track').attr('data-rss-playlist-id'));

                        // manually highlight the track that play was clicked on
                        $(this).parents('li').addClass('jp-playlist-current');

                        return false;
                    });

                    $('.podcast_desc_btn').click(function() {
                        $(this).toggleClass('current');
                        $(this).next('.podcast_desc').slideToggle();
                    });

                } //buildPlaylist

                // RASTATIME 2026-06-01 (JS-modernization, jPlayer part 3/3):
                // vanilla native-<audio> playlist player driving the existing
                // jPlayer-style GUI (#jp_container_1). Replaces jPlayerPlaylist.
                var _podcastPlayer = (function () {
                    var audio = null;       // the native <audio> element
                    var $root = null;       // #jp_container_1 (GUI ancestor)
                    var tracks = [];        // [{ title, artist, src }]
                    var current = 0;
                    var loadedIndex = -1;

                    function $f(sel) { return $root.find(sel); }

                    function fmtTime(sec) {
                        if (isNaN(sec) || sec < 0) { sec = 0; }
                        var m = Math.floor(sec / 60);
                        var s = Math.floor(sec % 60);
                        return m + ":" + (s < 10 ? "0" : "") + s;
                    }

                    // jPlayer toggled play/pause button visibility via display.
                    function showPlaying(isPlaying) {
                        $f(".jp-play").css("display", isPlaying ? "none" : "");
                        $f(".jp-pause").css("display", isPlaying ? "" : "none");
                    }

                    function updateProgress() {
                        var dur = audio.duration;
                        var pct = (dur > 0) ? (audio.currentTime / dur * 100) : 0;
                        $f(".jp-play-bar").css("width", pct + "%");
                        $f(".jp-current-time").text(fmtTime(audio.currentTime));
                    }

                    function updateVolumeUi() {
                        var v = audio.muted ? 0 : audio.volume;
                        $f(".jp-volume-bar-value").css("width", (v * 100) + "%");
                        $f(".jp-mute").css("display", audio.muted ? "none" : "");
                        $f(".jp-unmute").css("display", audio.muted ? "" : "none");
                    }

                    function highlight(index) {
                        var $items = $(".rss-tracks li");
                        $items.removeClass("jp-playlist-current");
                        $items.find("a.jp-playlist-item").removeClass("jp-playlist-current");
                        var $cur = $items.eq(index);
                        $cur.addClass("jp-playlist-current");
                        $cur.find("a.jp-playlist-item").addClass("jp-playlist-current");
                    }

                    function play(index) {
                        if (typeof index !== "undefined" && index !== null) {
                            current = parseInt(index, 10) || 0;
                        }
                        var t = tracks[current];
                        if (!t || !t.src) { return; }
                        if (loadedIndex !== current) {
                            audio.src = t.src;
                            loadedIndex = current;
                        }
                        audio.play();
                        $(".current-track span").html(t.title || "");
                        highlight(current);
                    }

                    function init() {
                        audio = document.getElementById("podcast_audio_el");
                        $root = $("#jp_container_1");

                        $f(".jp-play").on("click", function () { play(); return false; });
                        $f(".jp-pause").on("click", function () { audio.pause(); return false; });
                        $f(".jp-stop").on("click", function () {
                            audio.pause();
                            audio.currentTime = 0;
                            return false;
                        });
                        $f(".jp-seek-bar").on("click", function (e) {
                            var ratio = (e.pageX - $(this).offset().left) / $(this).width();
                            ratio = Math.max(0, Math.min(1, ratio));
                            if (audio.duration > 0) { audio.currentTime = ratio * audio.duration; }
                            return false;
                        });
                        $f(".jp-volume-bar").on("click", function (e) {
                            var ratio = (e.pageX - $(this).offset().left) / $(this).width();
                            ratio = Math.max(0, Math.min(1, ratio));
                            audio.muted = false;
                            audio.volume = ratio;
                            return false;
                        });
                        $f(".jp-mute").on("click", function () { audio.muted = true; return false; });
                        $f(".jp-unmute").on("click", function () { audio.muted = false; return false; });
                        $f(".jp-volume-max").on("click", function () {
                            audio.muted = false;
                            audio.volume = 1;
                            return false;
                        });

                        $(audio).on("play", function () { showPlaying(true); });
                        $(audio).on("pause", function () { showPlaying(false); });
                        $(audio).on("timeupdate", updateProgress);
                        $(audio).on("volumechange", updateVolumeUi);
                        $(audio).on("ended", function () {
                            if (current < tracks.length - 1) { play(current + 1); }
                            else { showPlaying(false); }
                        });

                        showPlaying(false);
                        updateVolumeUi();
                    }

                    return {
                        init: init,
                        setPlaylist: function (list) { tracks = list; current = 0; loadedIndex = -1; },
                        play: play
                    };
                })();

                $(document).ready(function () {
                    _podcastPlayer.init();

                    var episodes = <?php echo $this->episodes ?>;
                    var empty_podcast_message = "<?php echo $this->emptyPodcastMessage ?>";

                    if (Object.keys(episodes).length <= 0) {
                        $(".jp-playlist").append(empty_podcast_message);
                    } else {
                        buildJplayerPlaylist(0, episodes);

                        // build pagination menu
                        var pages = "<li data-page-index='0'><</li>";
                        $.each(episodes, function(index, value) {
                            var page_number = +index + 1;
                            pages += "<li data-page-index='" + index + "'>" + page_number + "</li>";
                        });
                        var last_index = Object.keys(episodes).length - 1;
                        pages += "<li data-page-index='" + last_index + "'>></li>";
                        $("ul.pagination").append(pages);
                        $("ul.pagination").find("li:contains('1')").addClass('current');

                        // pagination click
                        $("ul.pagination li").click(function() {
                            buildJplayerPlaylist($(this).attr("data-page-index"), episodes);
                            $(this).siblings().removeClass('current');
                            if ($(this).text() === "<") {
                                $(this).next().addClass("current");
                            } else if ($(this).text() === ">") {
                                $(this).prev().addClass("current");
                            } else {
                                $(this).addClass('current');
                            }
                        });

                        //turn off player bar when podcast track is played
                        $("a.jp-playlist-item, .jp-play, .podcast_play").click(function() {
                            if ($("#player_iframe").contents().find('.play').hasClass('pause')) {
                                $("#player_iframe").contents().find('.play').click();
                            }
                        });
                    }
                });
            </script>
        </div>
    <?php
    }
