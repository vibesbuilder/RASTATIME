<?php /* RASTATIME 2026-05-31 (JS-modernization stage 0c): native <audio> audio
       * preview — replaces the jPlayerPlaylist markup + jPlayer skin CSS.
       * The hidden <span> elements still carry the preview parameters; player
       * logic lives in js/airtime/audiopreview/preview_audio.js (vanilla). */ ?>
<style>
  body { margin: 0; font-family: Arial, Helvetica, sans-serif; }
  .audio-preview { padding: 10px; }
  .audio-preview-logo img { max-height: 40px; margin-bottom: 8px; }
  .audio-preview-nowplaying { font-weight: bold; margin-bottom: 8px; word-break: break-word; }
  #preview_audio_el { width: 100%; }
  .audio-preview-nav { margin-top: 8px; }
  .audio-preview-nav button { padding: 3px 10px; cursor: pointer; }
  .audio-preview-playlist { list-style: none; margin: 8px 0 0; padding: 0; max-height: 240px; overflow-y: auto; }
  .audio-preview-playlist li { padding: 4px 6px; cursor: pointer; border-bottom: 1px solid #eee; }
  .audio-preview-playlist li:hover { background: #f0f0f0; }
  .audio-preview-playlist li.preview-current { background: #d9edf7; font-weight: bold; }
</style>
<div id="jp_container_1" class="audio-preview">
    <?php if (isset($this->playlistID)) : ?>
        <span class="playlistID" style="display:none;"><?php echo "$this->playlistID" ?></span>
        <span class="playlistIndex" style="display:none;"><?php echo "$this->playlistIndex" ?></span>
    <?php elseif (isset($this->blockId)) : ?>
        <span class="blockId" style="display:none;"><?php echo "$this->blockId" ?></span>
        <span class="blockIndex" style="display:none;"><?php echo "$this->blockIndex" ?></span>
    <?php elseif (isset($this->uri)) : ?>
        <span class="audioUri" style="display:none;"><?php echo "$this->uri" ?></span>
        <span class="audioMime" style="display:none;"><?php echo "$this->mime" ?></span>
        <span class="audioFileTitle" style="display:none;"><?php echo "$this->audioFileTitle" ?></span>
        <span class="audioFileArtist" style="display:none;"><?php echo "$this->audioFileArtist" ?></span>
    <?php elseif (isset($this->showID)) : ?>
        <span class="showID" style="display:none;"><?php echo "$this->showID" ?></span>
        <span class="showIndex" style="display:none;"><?php echo "$this->showIndex" ?></span>
    <?php endif; ?>

    <?php if (isset($this->logo) && $this->logo) : ?>
        <div class="audio-preview-logo"><img src="<?php echo $this->logo ?>" alt="" /></div>
    <?php endif; ?>

    <div id="preview_nowplaying" class="audio-preview-nowplaying"></div>

    <audio id="preview_audio_el" controls autoplay preload="auto"></audio>

    <div id="preview_nav" class="audio-preview-nav" style="display:none;">
        <button type="button" id="preview_prev"><?php echo _("Previous") ?></button>
        <button type="button" id="preview_next"><?php echo _("Next") ?></button>
    </div>

    <ul id="preview_playlist" class="audio-preview-playlist" style="display:none;"></ul>
</div>
