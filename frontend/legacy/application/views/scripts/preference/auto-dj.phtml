<script type="text/javascript">
(function ($) {
    var baseUrl = "<?php echo Config::getBasePath(); ?>";

    // RASTATIME 2026-05-21 — qtip on the "Default Playlist" label.
    // Mirrors the show_record_help_icon pattern in add-show.js so the
    // full sentences only show when the operator hovers, keeping the
    // form heading tidy.  The tooltip carries both the short
    // "what's this field for" sentence and the longer
    // "how to configure the playlist for best results" tip — the
    // tip used to be a paragraph under the dropdown, but the
    // operator preferred a single hover surface.
    $(".auto_dj_playlist_help_icon").rtTooltip({
        content: {
            text: $.i18n._("Used as autoplaylist for created shows.")
                + " <br/><br/>" + $.i18n._(
                    "Tip: use a playlist that contains a Smart Block with "
                    + "\"Limit to: Time remaining in show\" so the slot is "
                    + "filled exactly."
                )
        },
        hide:  { delay: 500, fixed: true },
        style: {
            border: { width: 0, radius: 4 },
            classes: "ui-tooltip-dark ui-tooltip-rounded"
        },
        position: { my: "left bottom", at: "right center" }
    });

    // RASTATIME 2026-05-21 — Show-Logo tooltip with the file-type
    // and size constraint.  Same qtip pattern as Default Playlist.
    $(".auto_dj_logo_help_icon").rtTooltip({
        content: {
            text: $.i18n._("Upload a JPG / PNG / GIF (max 2 MB).")
        },
        hide:  { delay: 500, fixed: true },
        style: {
            border: { width: 0, radius: 4 },
            classes: "ui-tooltip-dark ui-tooltip-rounded"
        },
        position: { my: "left bottom", at: "right center" }
    });

    $(document).on("click", "#auto-dj-upload-logo", function () {
        var $file = $("#auto_dj_logo_file");
        var $status = $("#auto-dj-upload-status");
        if (!$file[0].files || $file[0].files.length === 0) {
            $status.text("No file selected.").css("color", "#c66");
            return;
        }
        var f = $file[0].files[0];
        if (f.size > 2 * 1024 * 1024) {
            $status.text("File too large (max 2 MB).").css("color", "#c66");
            return;
        }
        var fd = new FormData();
        fd.append("file", f);
        $status.text("Uploading…").css("color", "#aaa");
        $.ajax({
            url: baseUrl + "Preference/auto-dj-upload-logo",
            type: "POST",
            data: fd,
            cache: false,
            contentType: false,
            processData: false,
            success: function () {
                $status.text("Uploaded.  Reloading…").css("color", "#6c6");
                setTimeout(function () { location.reload(); }, 600);
            },
            error: function (xhr) {
                $status.text("Upload failed: " + (xhr.responseText || xhr.status))
                       .css("color", "#c66");
            }
        });
    });

    $(document).on("click", "#auto-dj-remove-logo", function () {
        if (!confirm("Remove the default Auto DJ logo?")) return;
        $.post(baseUrl + "Preference/auto-dj-remove-logo", function () {
            location.reload();
        });
    });
})(jQuery);
</script>
