        <div style="clear:both"></div>
    </div>



    <script>
    (function ($) {
        var pollTimer = null;

        var TXT = {
            saved:       "<?php echo addslashes(_('Backup settings saved.')) ?>",
            checked:     "<?php echo addslashes(_('The folder is usable.')) ?>",
            noFolder:    "<?php echo addslashes(_('Choose and save a backup folder first.')) ?>",
            running:     "<?php echo addslashes(_('Backup running …')) ?>",
            phaseDb:     "<?php echo addslashes(_('Backing up database + configuration …')) ?>",
            phaseMedia:  "<?php echo addslashes(_('Mirroring media library …')) ?>",
            phaseVerify: "<?php echo addslashes(_('Verifying media mirror …')) ?>",
            cancelled:   "<?php echo addslashes(_('Cancelled - the ZIP is complete, the media mirror resumes on the next run.')) ?>",
            done:        "<?php echo addslashes(_('Backup finished:')) ?>",
            doneMedia:   "<?php echo addslashes(_('media mirror synced')) ?>",
            failed:      "<?php echo addslashes(_('Backup failed:')) ?>",
            interrupted: "<?php echo addslashes(_('The last backup was interrupted - run it again.')) ?>",
            none:        "<?php echo addslashes(_('No backups yet.')) ?>",
            download:    "<?php echo addslashes(_('Download')) ?>",
            requestFail: "<?php echo addslashes(_('Request failed.')) ?>"
        };

        function mb(bytes) { return ((bytes || 0) / 1048576).toFixed(1) + " MB"; }
        function msg(text, ok) { $("#backup_status_msg").text(text).css("color", ok ? "#5cb85c" : "#d9534f"); }
        function post(action, data, done, fail) {
            data.csrf_token = $("#csrf").val();
            $.post(baseUrl + "preference/" + action, data, done, "json").fail(function (xhr) {
                var errs = (xhr.responseJSON && xhr.responseJSON.errors) || [TXT.requestFail];
                fail(errs.join(" "));
            });
        }

        function renderJob(job) {
            var info = $("#backup_job_info");
            var mediaRunning = job.state === "running" && job.phase === "media";
            $("#backup_cancel").toggle(mediaRunning);
            if (job.state === "running" && job.include_media && job.media_total_bytes) {
                var pct = Math.min(100, Math.round(100 * (job.media_done_bytes || 0) / job.media_total_bytes));
                $("#backup_progress").show();
                $("#backup_progress_bar").css("width", pct + "%");
            } else {
                $("#backup_progress").hide();
            }
            if (job.state === "running") {
                var phase = job.phase === "media" ? TXT.phaseMedia +
                        " " + mb(job.media_done_bytes) + " / " + mb(job.media_total_bytes)
                    : job.phase === "verifying" ? TXT.phaseVerify
                    : TXT.phaseDb;
                info.text(TXT.running + " " + phase);
                startPolling();
            } else if (job.state === "done") {
                var text = TXT.done + " " + (job.file || "") + ", " + mb(job.bytes);
                if (job.media_synced_at) {
                    text += " · " + TXT.doneMedia + " (" + (job.media_done_files || 0) +
                            " files, " + mb(job.media_done_bytes) + ")";
                }
                info.text(text);
            } else if (job.state === "cancelled") {
                info.text(TXT.cancelled);
            } else if (job.state === "failed") {
                info.text(TXT.failed + " " + (job.error || ""));
            } else if (job.state === "interrupted") {
                info.text(TXT.interrupted);
            } else {
                info.text("");
            }
        }

        function renderList(backups) {
            var rows = $("#backup_rows").empty();
            if (!backups || !backups.length) {
                rows.append($("<tr>").append($("<td>", {colspan: 4, text: TXT.none})));
                return;
            }
            $.each(backups, function (_i, b) {
                var link = $("<a>", {
                    href: baseUrl + "preference/backup-download?name=" + encodeURIComponent(b.name),
                    text: TXT.download
                });
                rows.append($("<tr>")
                    .append($("<td>", {text: b.name, style: "font-family: monospace;"}))
                    .append($("<td>", {text: mb(b.bytes)}))
                    .append($("<td>", {text: (b.created_at || "").replace("T", " ").replace(/\+.*$/, "")}))
                    .append($("<td>").append(link)));
            });
        }

        var mediaTouched = false;
        var autoTouched = false;

        function renderStatus(d) {
            if (d.folder && !$("#backup_folder").is(":focus") && !$("#backup_folder").val()) {
                $("#backup_folder").val(d.folder.replace(/\//g, "\\"));
            }
            if (!mediaTouched) {
                $("#backup_include_media").prop("checked", !!d.include_media);
            }
            if (!autoTouched && d.auto) {
                $("#backup_auto_enabled").prop("checked", !!d.auto.enabled);
                $("#backup_auto_every").val(d.auto.every_days);
                $("#backup_auto_retention").val(d.auto.retention_days);
            }
            $("#backup_run").prop("disabled", !d.configured || (d.job || {}).state === "running");
            renderJob(d.job || {state: "idle"});
            renderList(d.backups);
        }

        // RASTATIME 2026-10-27 - the two sections of the page's Save
        // (pagesave.js), marked saved once the first status filled them
        var folderSection = RtPageSave.register("backup_folder", "#backup_folder, #backup_include_media", function () {
            var done = $.Deferred();
            post("backup-folder", {
                folder: $("#backup_folder").val(),
                include_media: $("#backup_include_media").is(":checked") ? "true" : "false"
            }, function (d) {
                msg(TXT.saved, true);
                mediaTouched = false;
                renderStatus(d);
                done.resolve();
            }, function (err) { msg(err, false); done.reject(); });
            return done.promise();
        });
        var autoSection = RtPageSave.register("backup_auto", "#backup_auto_enabled, #backup_auto_every, #backup_auto_retention", function () {
            var done = $.Deferred();
            $.post(baseUrl + "preference/backup-auto", {
                csrf_token: $("#csrf").val(),
                enabled: $("#backup_auto_enabled").is(":checked") ? "true" : "false",
                every_days: $("#backup_auto_every").val(),
                retention_days: $("#backup_auto_retention").val()
            }, function (d) {
                $("#backup_auto_msg").text("<?php echo addslashes(_('Saved.')) ?>").css("color", "#5cb85c");
                autoTouched = false;
                renderStatus(d);
                done.resolve();
            }, "json").fail(function (xhr) {
                var errs = (xhr.responseJSON && xhr.responseJSON.errors) || ["<?php echo addslashes(_('Save failed.')) ?>"];
                $("#backup_auto_msg").text(errs.join(" ")).css("color", "#d9534f");
                done.reject();
            });
            return done.promise();
        });

        function refresh() {
            $.getJSON(baseUrl + "preference/backup-status", function (d) {
                renderStatus(d);
                if (folderSection.saved === null) {
                    RtPageSave.markSaved(folderSection);
                    RtPageSave.markSaved(autoSection);
                }
            });
        }

        function startPolling() {
            if (pollTimer) { return; }
            pollTimer = setInterval(function () {
                $.getJSON(baseUrl + "preference/backup-status", function (d) {
                    if ((d.job || {}).state !== "running") {
                        clearInterval(pollTimer);
                        pollTimer = null;
                    }
                    renderStatus(d);
                });
            }, 2000);
        }

        $("#backup_check").on("click", function () {
            post("backup-validate", {folder: $("#backup_folder").val()}, function (d) {
                if (d.ok) { msg(TXT.checked, true); } else { msg((d.errors || []).join(" "), false); }
            }, function (err) { msg(err, false); });
        });

        $("#backup_include_media").on("change", function () { mediaTouched = true; });
        $("#backup_auto_enabled, #backup_auto_every, #backup_auto_retention")
            .on("change input", function () { autoTouched = true; });

        $("#backup_run").on("click", function () {
            msg("", true);
            post("backup-run", {}, function (d) {
                renderJob((d && d.job) || {state: "running"});
                startPolling();
            }, function (err) { msg(err, false); });
        });

        $("#backup_cancel").on("click", function () {
            post("backup-cancel", {}, function () { refresh(); },
                 function (err) { msg(err, false); });
        });

        $(function () {
            refresh();
            $("[data-rt-tip]").each(function () {
                $(this).rtTooltip({
                    content: $(this).attr("data-rt-tip"),
                    placement: "right",
                    interactive: true,
                });
            });
        });
    })(jQuery);
    </script>

    <?php /* CSRF token used by the POSTs above. */ ?>
    <input type="hidden" id="csrf" value="<?php
        $csrfNs = new Zend_Session_Namespace('csrf_namespace');
        echo htmlspecialchars($csrfNs->authtoken ?? '', ENT_QUOTES);
    ?>" />
