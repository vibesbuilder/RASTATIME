    <h3><?php echo _("Existing backups") ?><span class="help_icon" data-rt-tip="<?php echo $rtTip(_("Every backup in the folder, newest first.  Download saves the ZIP through the browser; the files on disk stay untouched - delete old ones by hand or keep them all.")); ?>"></span></h3>

