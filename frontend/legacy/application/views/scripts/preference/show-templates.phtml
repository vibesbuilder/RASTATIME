<?php
// RASTATIME 2026-05-19 — Show-Templates settings page (Section 23.16).
// Read-only listing + per-row inline rename + delete; full Create
// flow happens in the Calendar's New-Show dialog (Save as Template).
?>
<div class="ui-widget ui-widget-content block-shadow alpha-block padded">
    <h2><?php echo _("Show Templates") ?></h2>
    <p style="margin-bottom: 1em; color: #888;">
        <?php echo _("Templates are created from the Calendar's 'New Show' dialog (Save as Template). Here you can rename or delete existing templates."); ?>
    </p>

    <?php if (empty($this->templates)): ?>
        <p style="padding: 1em; background: #2a2a2a; border-radius: 4px;">
            <?php echo _("No templates saved yet. Create one in Calendar → New Show → Save as Template."); ?>
        </p>
    <?php else: ?>
        <table class="datatable" style="width: 100%; max-width: 60em;">
            <thead>
                <tr>
                    <th style="text-align: left; padding: 6px;"><?php echo _("Name") ?></th>
                    <th style="text-align: left; padding: 6px;"><?php echo _("Created") ?></th>
                    <th style="text-align: left; padding: 6px;"><?php echo _("Last update") ?></th>
                    <th style="text-align: left; padding: 6px;"><?php echo _("Actions") ?></th>
                </tr>
            </thead>
            <tbody>
                <?php foreach ($this->templates as $t): ?>
                    <tr data-template-id="<?php echo (int) $t['id']; ?>">
                        <td style="padding: 6px;">
                            <span class="tpl-name"><?php echo htmlspecialchars($t['name'], ENT_QUOTES, 'UTF-8'); ?></span>
                            <input type="text" class="tpl-name-edit" style="display:none; width: 18em;"
                                   value="<?php echo htmlspecialchars($t['name'], ENT_QUOTES, 'UTF-8'); ?>" />
                        </td>
                        <td style="padding: 6px;"><?php echo htmlspecialchars($t['created_at'], ENT_QUOTES, 'UTF-8'); ?></td>
                        <td style="padding: 6px;"><?php echo htmlspecialchars($t['updated_at'], ENT_QUOTES, 'UTF-8'); ?></td>
                        <td style="padding: 6px;">
                            <button type="button" class="btn btn-small tpl-rename"><?php echo _("Rename") ?></button>
                            <button type="button" class="btn btn-small tpl-save-rename" style="display:none;"><?php echo _("Save") ?></button>
                            <button type="button" class="btn btn-small tpl-cancel-rename" style="display:none;"><?php echo _("Cancel") ?></button>
                            <button type="button" class="btn btn-small btn-danger tpl-delete" style="margin-left: 1em;"><?php echo _("Delete") ?></button>
                            <span class="tpl-status" style="margin-left: 1em;"></span>
                        </td>
                    </tr>
                <?php endforeach; ?>
            </tbody>
        </table>
    <?php endif; ?>
</div>

<script type="text/javascript">
// RASTATIME 2026-05-19 — inline rename / delete handlers for the
// Show-Templates settings page.  Pure jQuery, talks to the JSON
// endpoints already defined on ScheduleController.
(function ($) {
    var baseUrl = "<?php echo Config::getBasePath(); ?>";

    function setStatus($row, msg, isError) {
        $row.find(".tpl-status")
            .text(msg || "")
            .css("color", isError ? "#c66" : "#6c6");
    }

    $(document).on("click", ".tpl-rename", function () {
        var $row = $(this).closest("tr");
        $row.find(".tpl-name").hide();
        $row.find(".tpl-name-edit").show().focus();
        $row.find(".tpl-rename").hide();
        $row.find(".tpl-save-rename, .tpl-cancel-rename").show();
        setStatus($row, "");
    });

    $(document).on("click", ".tpl-cancel-rename", function () {
        var $row = $(this).closest("tr");
        $row.find(".tpl-name").show();
        $row.find(".tpl-name-edit").hide();
        $row.find(".tpl-rename").show();
        $row.find(".tpl-save-rename, .tpl-cancel-rename").hide();
        setStatus($row, "");
    });

    $(document).on("click", ".tpl-save-rename", function () {
        var $row = $(this).closest("tr");
        var id = $row.data("template-id");
        var newName = $row.find(".tpl-name-edit").val().trim();
        if (newName === "") {
            setStatus($row, "Name cannot be empty.", true);
            return;
        }
        $.post(
            baseUrl + "Schedule/rename-show-template/format/json",
            { format: "json", id: id, name: newName },
            function (json) {
                if (json && json.error) {
                    setStatus($row, json.error, true);
                    return;
                }
                $row.find(".tpl-name").text(newName).show();
                $row.find(".tpl-name-edit").hide();
                $row.find(".tpl-rename").show();
                $row.find(".tpl-save-rename, .tpl-cancel-rename").hide();
                setStatus($row, "Renamed.");
            }
        );
    });

    $(document).on("click", ".tpl-delete", function () {
        var $row = $(this).closest("tr");
        var id = $row.data("template-id");
        var name = $row.find(".tpl-name").text();
        if (!confirm("Delete template \"" + name + "\"?")) return;
        $.post(
            baseUrl + "Schedule/delete-show-template/format/json",
            { format: "json", id: id },
            function (json) {
                if (json && json.error) {
                    setStatus($row, json.error, true);
                    return;
                }
                $row.fadeOut(200, function () { $row.remove(); });
            }
        );
    });
})(jQuery);
</script>
