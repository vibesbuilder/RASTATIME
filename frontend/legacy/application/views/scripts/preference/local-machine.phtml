// RASTATIME 2026-06-06 — rtTooltip content helper.  Double-escapes so the
// text survives BOTH the HTML attribute AND rtTooltip's innerHTML render
// (e.g. "<YYYY-MM-DD>" shows as literal text instead of being parsed as a tag).
$rtTip = function ($text) {
    return htmlspecialchars(htmlspecialchars($text, ENT_QUOTES), ENT_QUOTES);
};
