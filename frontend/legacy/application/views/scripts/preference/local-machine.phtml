                        <?php
                        // RASTATIME 2026-09-03 - show what is ACTUALLY driving
                        // the monitor, not just what is stored.  The two can
                        // differ in two ways: the operator saved a device but
                        // has not applied it yet, or the device was rejected
                        // by every PortAudio host API (the Tascam US-16x08
                        // output is, so it silently falls back).  Rendering
                        // only the stored value is what made the page mislead
                        // the operator in the first place.
                        $rtActive = function_exists('rastatime_active_main_output')
                            ? rastatime_active_main_output()
                            : ['known' => false, 'os_default' => false, 'endpoint_id' => ''];

                        $rtSavedId = '';
                        $rtSavedName = '';
                        $rtCurl = curl_init('http://localhost:8765/api/v2/audio/soundcard-settings');
                        curl_setopt_array($rtCurl, [
                            CURLOPT_RETURNTRANSFER => true,
                            CURLOPT_TIMEOUT => 3,
                        ]);
                        $rtBody = curl_exec($rtCurl);
                        curl_close($rtCurl);
                        if (is_string($rtBody)) {
                            $rtJson = json_decode($rtBody, true) ?: [];
                            $rtSavedId = trim((string) ($rtJson['main_output_id'] ?? ''));
                            $rtSavedName = trim((string) ($rtJson['main_output_name'] ?? ''));
                        }

                        $rtMismatch = false;
                        $rtActiveText = '';
                        if ($rtActive['known']) {
                            if ($rtActive['os_default']) {
                                $rtActiveText = _('system default output');
                                $rtMismatch = ($rtSavedId !== '');
                            } else {
                                $rtActiveText = $rtSavedName !== '' && $rtActive['endpoint_id'] === $rtSavedId
                                    ? $rtSavedName
                                    : $rtActive['endpoint_id'];
                                $rtMismatch = ($rtSavedId !== '' && $rtActive['endpoint_id'] !== $rtSavedId);
                            }
                        }
                        ?>
                        <?php if ($rtActive['known']): ?>
                            <p class="rt-output-active <?php echo $rtMismatch ? 'rt-mismatch' : 'rt-ok' ?>">
