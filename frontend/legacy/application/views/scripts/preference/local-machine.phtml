    <p style="max-width: 60em; color: #555;">
        <?php echo _("Folder where per-show recordings are written.  Each show flagged as \"Record this show\" produces a single .mp3 of the on-air output, named <YYYY-MM-DD HH-MM> - <show-name>.mp3 under a per-day subfolder.  Leave empty to disable recording."); ?>
    </p>

    <fieldset class="padded stream-setting-global">
        <dl class="zend_form">
            <dt><label for="local_recording_folder"><?php echo _("Folder path") ?></label></dt>
            <dd>
                <input id="local_recording_folder" name="local_recording_folder"
                       type="text" class="input_text"
                       style="width: 100%; max-width: 50em;"
