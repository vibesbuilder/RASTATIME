                                        '<strong>' . htmlspecialchars($rtActiveText, ENT_QUOTES) . '</strong>',
                                        htmlspecialchars($rtSavedName !== '' ? $rtSavedName : $rtSavedId, ENT_QUOTES)
                                    ) ?>
                                <?php else: ?>
                                    <?php echo sprintf(
                                        _('Currently active: %s'),
                                        '<strong>' . htmlspecialchars($rtActiveText, ENT_QUOTES) . '</strong>'
                                    ) ?>
                                <?php endif; ?>
                            </p>
                        <?php endif; ?>

