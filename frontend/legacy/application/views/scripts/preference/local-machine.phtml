    <script>
    (function ($) {
        // Save the configured folder path.
        $("#local_import_save").on("click", function () {
            var path = $("#local_import_folder").val();
            $.post(
                baseUrl + "preference/local-import-save",
                {
                    folder: path,
                    csrf_token: $("#csrf").val()
                },
                function (resp) {
                    var msg = $("#local_import_status_msg");
                    if (resp && resp.ok) {
                        msg.text("✓ " + (path ? "Saved." : "Disabled (empty path)."))
                           .css("color", "#5cb85c");
                        // Enable/disable the Scan Now button based on the saved state.
                        $("#local_import_scan_now").prop("disabled", !path);
                    } else {
                        msg.text("✗ " + (resp.error || "Save failed."))
                           .css("color", "#d9534f");
                    }
                },
                "json"
            ).fail(function () {
                $("#local_import_status_msg").text("✗ Network error.").css("color", "#d9534f");
            });
        });

        // Trigger an immediate scan (bypasses the 5-minute throttle).
        $("#local_import_scan_now").on("click", function () {
            var btn = $(this);
            btn.prop("disabled", true);
            $("#local_import_status_msg").text("Scanning…").css("color", "#555");
            $.post(
                baseUrl + "preference/local-import-scan-now",
                { csrf_token: $("#csrf").val() },
                function (resp) {
                    var msg = $("#local_import_status_msg");
                    if (resp && resp.ok) {
                        msg.text("✓ Imported " + resp.imported + ", failed " + resp.failed + ".")
                           .css("color", "#5cb85c");
                    } else {
                        msg.text("✗ " + (resp.error || "Scan failed."))
                           .css("color", "#d9534f");
                    }
                    btn.prop("disabled", false);
                },
                "json"
            ).fail(function () {
                $("#local_import_status_msg").text("✗ Network error.").css("color", "#d9534f");
                btn.prop("disabled", false);
            });
        });

        // RASTATIME 2026-05-17 - Recording Folder save handler.
        $("#local_recording_save").on("click", function () {
            var path = $("#local_recording_folder").val();
            $.post(
                baseUrl + "preference/local-recording-save",
                {
                    folder: path,
                    csrf_token: $("#csrf").val()
                },
                function (resp) {
                    var msg = $("#local_recording_status_msg");
                    if (resp && resp.ok) {
                        msg.text("✓ " + (path ? "Saved." : "Disabled (empty path)."))
                           .css("color", "#5cb85c");
                    } else {
                        msg.text("✗ " + (resp.error || "Save failed."))
                           .css("color", "#d9534f");
                    }
                },
                "json"
            ).fail(function () {
                $("#local_recording_status_msg").text("✗ Network error.").css("color", "#d9534f");
            });
        });

        // RASTATIME 2026-06-05 - 24/7 Recording save handler.
        $("#rec247_save").on("click", function () {
            var msg = $("#rec247_status_msg");
            msg.text("…").css("color", "#666");
            $.post(
                baseUrl + "preference/local-247-recording-save",
                {
                    enabled: $("#rec247_enabled").is(":checked") ? "true" : "false",
                    folder: $("#rec247_folder").val(),
                    format: $("#rec247_format").val(),
                    bitrate: $("#rec247_bitrate").val(),
                    retention_days: $("#rec247_retention").val(),
                    csrf_token: $("#csrf").val()
                },
                function (resp) {
                    if (resp && resp.ok) {
                        msg.text("✓ Saved.  Restart the playout service to apply.")
                           .css("color", "#5cb85c");
                    } else {
                        msg.text("✗ " + (resp.error || "Save failed."))
                           .css("color", "#d9534f");
                    }
                },
                "json"
            ).fail(function () {
                msg.text("✗ Network error.").css("color", "#d9534f");
            });
        });

        // RASTATIME 2026-06-06 — bottom Save mirrors the top "Local Machine
        // Settings" (soundcard) Save so the operator needn't scroll up.
        $("#soundcard_save_bottom").on("click", function () {
            $("#soundcard_save").trigger("click");
        });

        // RASTATIME 2026-09-03 — "Apply now" for Main Output.  The device is
        // compiled into rastatime.liq at RASTATIME-PLAYOUT startup, so it only
        // reaches the local monitor once playout AND liquidsoap restart.  We
        // never do that implicitly on Save: it drops the stream for a few
        // seconds, so the operator triggers it knowingly.
        $("#soundcard_restart_chain").on("click", function () {
            var i18n = (window.AIRTIME && AIRTIME.i18n) || {};
            var $btn = $(this);
            var $msg = $("#soundcard-restart-msg");

            if (!window.confirm(i18n.restartConfirm ||
                    "This restarts the audio chain and interrupts the stream " +
                    "for a few seconds. Continue?")) {
                return;
            }

            $btn.prop("disabled", true);
            $msg.removeClass("ok error")
                .text(i18n.restartRunning || "Restarting audio chain …");

            $.post(
                baseUrl + "preference/restart-audio-chain",
                { csrf_token: $("#csrf").val() },
                null,
                "json"
            ).done(function (resp) {
                if (resp && resp.valid) {
                    $msg.addClass("ok").text(resp.message || "OK");
                } else {
                    $msg.addClass("error").text(
                        (resp && resp.error) ||
                        i18n.restartError || "Could not restart the audio chain."
                    );
                }
            }).fail(function () {
                // A restart tears down the request path it was asked over, so
                // a transport error here does NOT mean the restart failed.
                $msg.addClass("error").text(
                    i18n.restartError || "Could not restart the audio chain."
                );
            }).always(function () {
                $btn.prop("disabled", false);
            });
        });

        // RASTATIME 2026-06-06 — rich tooltips (rtTooltip / Floating UI) for the
        // section descriptions + field hints.  Each .help_icon shows its
        // data-rt-tip text on hover; interactive so longer text stays readable.
        $("[data-rt-tip]").each(function () {
            $(this).rtTooltip({
                content: $(this).attr("data-rt-tip"),
                placement: "right",
                interactive: true,
            });
        });
    })(jQuery);
    </script>

    <?php /* CSRF token used by the two POSTs above. */ ?>
    <input type="hidden" id="csrf" value="<?php
        $csrfNs = new Zend_Session_Namespace('csrf_namespace');
        echo htmlspecialchars($csrfNs->authtoken ?? '', ENT_QUOTES);
    ?>" />
