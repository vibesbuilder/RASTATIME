<?php
/* RASTATIME 2026-11-16 - Settings -> Show Types: the show types
 * (cc_show_types, ARCHITECTURE 23.120).  Rendered by show-types.phtml and
 * re-rendered by TracktypeController save/remove-showtype (showtype.js
 * swaps #showtype_panel). */
$h = static function ($s) { return htmlspecialchars((string) $s, ENT_QUOTES, 'UTF-8'); };
$types = $this->showTypes ?? [];
?>
<div class="ui-widget prefpanel clearfix padded-strong showtype-management" id="showtype_panel">
    <h2><?php echo _("Manage Show Types") ?>
        <span class="help_icon" data-rt-tip="<?php echo $h(_("The type of a show, chosen under Edit Show next to Genre. Analytics → Programme Minutes counts a show as a repeat when its type is marked \"Counts as repeat\", and adds up the minutes per show type.")); ?>"></span>
    </h2>
<?php if (empty($this->showTypesReady)) { ?>
    <p class="showtype-pending"><?php echo _("The show types are available once database migration 0088 has run.") ?></p>
<?php } else { ?>
    <div class="button-holder">
        <button type="button" id="add_showtype_button" class="add-button btn btn-small btn-new"><i class="icon-white icon-plus"></i><span><?php echo _("New Show Type") ?></span></button>
    </div>
    <table cellspacing="0" cellpadding="0" id="showtypes_table" class="datatable showtype-table">
        <thead>
            <tr>
                <th><?php echo _("Code") ?></th>
                <th><?php echo _("Label") ?></th>
                <th><?php echo _("Counts as repeat") ?></th>
                <th><?php echo _("Order") ?></th>
                <th><?php echo _("Shows") ?></th>
                <th>&nbsp;</th>
            </tr>
        </thead>
        <tbody>
<?php if (!$types) { ?>
            <tr><td colspan="6" class="showtype-empty"><?php echo _("No show types yet.") ?></td></tr>
<?php } ?>
<?php foreach ($types as $t) { ?>
            <tr data-id="<?php echo (int) $t['id']; ?>" data-code="<?php echo $h($t['code']); ?>" data-name="<?php echo $h($t['type_name']); ?>" data-repeat="<?php echo $t['counts_as_repeat'] ? '1' : '0'; ?>" data-order="<?php echo (int) $t['sort_order']; ?>" data-shows="<?php echo (int) $t['shows']; ?>">
                <td><?php echo $h($t['code']); ?></td>
                <td><?php echo $h($t['type_name']); ?></td>
                <td><?php echo $t['counts_as_repeat'] ? $h(_("Yes")) : ''; ?></td>
                <td><?php echo (int) $t['sort_order']; ?></td>
                <td><?php echo (int) $t['shows']; ?></td>
                <td class="showtype-actions">
                    <a href="#" class="showtype-edit" title="<?php echo $h(_("Edit")); ?>"><i class="icon-pencil"></i></a>
                    <a href="#" class="showtype-delete" title="<?php echo $h(_("Delete")); ?>"><i class="icon-trash"></i></a>
                </td>
            </tr>
<?php } ?>
        </tbody>
    </table>
    <form id="showtype_form" class="showtype-form simple-formblock" style="display:none" onsubmit="return false;">
        <input type="hidden" name="id" id="showtype_id" value="">
        <div class="showtype-errors errors" style="display:none"></div>
        <dl class="zend_form">
            <dt><label for="showtype_code"><?php echo _("Code:") ?></label></dt>
            <dd><input type="text" class="input_text" name="code" id="showtype_code" maxlength="16" autocomplete="off"></dd>
            <dt><label for="showtype_name"><?php echo _("Label:") ?></label></dt>
            <dd><input type="text" class="input_text" name="type_name" id="showtype_name" maxlength="64" autocomplete="off"></dd>
            <dt><label for="showtype_repeat"><?php echo _("Counts as repeat:") ?></label>
                <span class="help_icon" data-rt-tip="<?php echo $h(_("Shows of this type count as repeats in Analytics → Programme Minutes (own productions: first broadcast or repeat). The \"Repeat of another show\" setting of a show only copies content and does not count.")); ?>"></span></dt>
            <dd><input type="checkbox" name="counts_as_repeat" id="showtype_repeat" value="1"></dd>
            <dt><label for="showtype_order"><?php echo _("Order:") ?></label></dt>
            <dd><input type="text" class="input_text" name="sort_order" id="showtype_order" maxlength="6" autocomplete="off"></dd>
        </dl>
        <div class="showtype-buttons">
            <button type="button" id="showtype_save" class="btn btn-small"><?php echo _("Save") ?></button>
            <button type="button" id="showtype_cancel" class="btn btn-small"><?php echo _("Cancel") ?></button>
        </div>
    </form>
<?php } ?>
</div>
