<?php
// RASTATIME 2026-05-22 — Next / Latest Shows Widget shared template.
//
// Lists up to N instances of a single recurring show as a small
// chronological table.  Shared between the next-shows action
// (ASC, future) and the latest-shows action (DESC, past) — the
// only structural difference is the title row and the per-row
// time labels, both driven from $this->direction.
//
// View variables (all populated by EmbedController):
//   direction   - 'next' or 'latest'
//   showMeta    - ['id', 'name', 'url', 'description'] or null
//   instances   - [['starts'=>ISO, 'ends'=>ISO], ...]
//   limit       - resolved limit (1..20)
//   emptyLabel  - operator-configurable empty-state placeholder
//   themeClass  - 'np-theme-auto' / 'np-theme-dark' / 'np-theme-light'
//   overflowClass - 'np-overflow-ellipsis' / 'np-overflow-marquee'
//   dataUrl     - JSON refresh endpoint (already query-stringed)
//   cacheTtl    - integer seconds for the JS poll cadence
//   widgetCss / widgetJs - asset URLs
$direction  = $this->direction;
$showMeta   = $this->showMeta;
$instances  = $this->instances;
$emptyLabel = $this->emptyLabel;
$title      = $showMeta ? $showMeta['name'] : $emptyLabel;
?>
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><?php
        echo htmlspecialchars(
            ($direction === 'latest' ? _('Latest Shows') : _('Next Shows'))
            . ($showMeta ? ' — ' . $showMeta['name'] : ''),
            ENT_QUOTES, 'UTF-8'
        );
    ?></title>
    <link rel="stylesheet" href="<?php echo $this->widgetCss; ?>">
</head>
<body class="np-widget np-shows-list <?php echo htmlspecialchars($this->themeClass, ENT_QUOTES, 'UTF-8'); ?> <?php echo htmlspecialchars($this->overflowClass, ENT_QUOTES, 'UTF-8'); ?>"
      data-widget="<?php echo htmlspecialchars($direction === 'latest' ? 'latest-shows' : 'next-shows', ENT_QUOTES, 'UTF-8'); ?>"
      data-direction="<?php echo htmlspecialchars($direction, ENT_QUOTES, 'UTF-8'); ?>"
      data-data-url="<?php echo htmlspecialchars($this->dataUrl, ENT_QUOTES, 'UTF-8'); ?>"
      data-cache-ttl="<?php echo (int) $this->cacheTtl; ?>"
      data-label-empty="<?php echo htmlspecialchars($emptyLabel, ENT_QUOTES, 'UTF-8'); ?>">

    <div class="np-row np-row-title">
        <span class="np-name" data-np="title"><?php
            echo htmlspecialchars($title, ENT_QUOTES, 'UTF-8');
        ?></span>
    </div>

    <ul class="np-list" data-np="list">
        <?php if (empty($instances)) { ?>
            <li class="np-list-empty" data-np="empty">
                <span class="np-name"><?php
                    echo htmlspecialchars($emptyLabel, ENT_QUOTES, 'UTF-8');
                ?></span>
            </li>
        <?php } else {
            foreach ($instances as $inst) { ?>
            <li class="np-list-row">
                <span class="np-list-date"
                      data-starts="<?php echo htmlspecialchars($inst['starts'] ?? '', ENT_QUOTES, 'UTF-8'); ?>"
                      data-ends="<?php echo htmlspecialchars($inst['ends'] ?? '', ENT_QUOTES, 'UTF-8'); ?>">
                    <?php /* Date rendered by JS once the page boots */ ?>
                </span>
                <span class="np-list-time"
                      data-starts="<?php echo htmlspecialchars($inst['starts'] ?? '', ENT_QUOTES, 'UTF-8'); ?>"
                      data-ends="<?php echo htmlspecialchars($inst['ends'] ?? '', ENT_QUOTES, 'UTF-8'); ?>">
                    <?php /* HH:MM - HH:MM rendered by JS once the page boots */ ?>
                </span>
            </li>
        <?php }
        } ?>
    </ul>

    <script src="<?php echo $this->widgetJs; ?>" defer></script>
</body>
</html>
