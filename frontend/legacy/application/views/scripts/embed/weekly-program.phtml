<?php
// RASTATIME 2026-05-22 — Weekly Schedule Widget v2.
//
// Modernised replacement for the upstream jQuery 1.8.3 + Handlebars
// template.  Vanilla JS, transparent background, Wave-1 widget
// conventions throughout.
//
// Layout:
//
//   ┌─────────────────────────────────────────────────┐
//   │ ◀  21 May – 27 May 2026               ▶         │  ← header
//   │ Mon  Tue  Wed  Thu  Fri  Sat  Sun                │  ← day tabs
//   ├─────────────────────────────────────────────────┤
//   │ 06:00 – 08:00   Morning Show                     │  ← rows
//   │ 08:00 – 10:00   Newslink (link, link=plain)      │
//   │ ...                                              │
//   └─────────────────────────────────────────────────┘
//
// View variables (all populated by EmbedController::weeklyProgramAction):
//   schedule_data   - JSON dump of WidgetHelper::getWeekInfoV2(weekOffset)
//   weekOffset      - integer ±N from current week
//   themeClass      - 'np-theme-auto' / 'np-theme-dark' / 'np-theme-light'
//   overflowClass   - 'np-overflow-ellipsis' / 'np-overflow-marquee'
//   linkClass       - 'np-link-plain' / 'np-link-underline'
//   timezone        - resolved IANA zone
//   currentDayOfMonth - "today" day-number for the tab highlight
//   cacheTtl        - integer seconds for the JS refresh cadence
//   backgroundUrl   - optional URL for the cover-background image
//   emptyLabel      - operator-configurable per-day empty-state text
//   widgetCss / widgetJs - asset URLs

$bgStyle = '';
if (!empty($this->backgroundUrl)) {
    // CSS-variable approach lets the stylesheet switch between
    // transparent fill (default) and image-cover via the variable's
    // presence/absence — no extra body class needed.
    $bgStyle = '--np-bg-image: url(\''
             . addslashes(htmlspecialchars($this->backgroundUrl, ENT_QUOTES, 'UTF-8'))
             . '\');';
}
?>
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><?php echo _('Weekly Schedule'); ?></title>
    <link rel="stylesheet" href="<?php echo $this->widgetCss; ?>">
</head>
<body class="np-widget np-weekly-schedule <?php echo htmlspecialchars($this->themeClass, ENT_QUOTES, 'UTF-8'); ?> <?php echo htmlspecialchars($this->overflowClass, ENT_QUOTES, 'UTF-8'); ?> <?php echo htmlspecialchars($this->linkClass, ENT_QUOTES, 'UTF-8'); ?>"
      data-widget="weekly-schedule"
      data-week-offset="<?php echo (int) $this->weekOffset; ?>"
      data-current-dom="<?php echo htmlspecialchars($this->currentDayOfMonth, ENT_QUOTES, 'UTF-8'); ?>"
      data-cache-ttl="<?php echo (int) $this->cacheTtl; ?>"
      data-timezone="<?php echo htmlspecialchars($this->timezone, ENT_QUOTES, 'UTF-8'); ?>"
      data-label-empty="<?php echo htmlspecialchars($this->emptyLabel, ENT_QUOTES, 'UTF-8'); ?>"
      <?php if ($bgStyle): ?>style="<?php echo $bgStyle; ?>"<?php endif; ?>>

    <div class="np-ws-header">
        <button type="button" class="np-ws-nav" data-np="prev-week" aria-label="<?php echo _('Previous week'); ?>">&#x25C0;</button>
        <span class="np-ws-range" data-np="range"><?php /* date range rendered by JS once the page boots */ ?></span>
        <button type="button" class="np-ws-nav" data-np="next-week" aria-label="<?php echo _('Next week'); ?>">&#x25B6;</button>
    </div>

    <ul class="np-ws-tabs" data-np="tabs">
        <?php /* day tabs rendered by JS — placeholders kept empty so the markup is small even before JS boots */ ?>
    </ul>

    <div class="np-ws-content" data-np="content">
        <?php /* day-of-week panels rendered by JS */ ?>
    </div>

    <script id="np-ws-data" type="application/json">
<?php echo $this->schedule_data; ?>
</script>

    <script src="<?php echo $this->widgetJs; ?>" defer></script>
</body>
</html>
