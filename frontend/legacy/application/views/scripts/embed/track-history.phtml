<?php
// RASTATIME 2026-05-22 — Track History widget template.
//
// Wave-1-style iframe shell: header band with date-picker +
// time-picker + Now + pagesize-dropdown, then a list of
// track rows (HH:MM
// Artist - Title), then a "Load more" button capped at 100
// rows total.  Click a track → modal with full metadata +
// show context.
//
// View variables (all populated by EmbedController::
// trackHistoryAction):
//   dayLocal         - YYYY-MM-DD currently displayed
//   minDate          - earliest allowed date (today - 6 days)
//   maxDate          - latest allowed date (today)
//   pagesize         - initial page size (10|20|50|100)
//   themeClass       - 'np-theme-auto' / 'np-theme-dark' / 'np-theme-light'
//   timezone         - resolved IANA zone
//   cacheTtl         - integer seconds for JS poll cadence
//   backgroundUrl / backgroundColor - optional cover image / colour
//   emptyLabel       - operator-configurable empty-state text
//   widgetCss / widgetJs - asset URLs

$bgStyleParts = [];
if (!empty($this->backgroundUrl)) {
    $bgStyleParts[] = '--np-bg-image: url(\''
        . addslashes(htmlspecialchars($this->backgroundUrl, ENT_QUOTES, 'UTF-8'))
        . '\');';
}
if (!empty($this->backgroundColor)) {
    $bgStyleParts[] = '--np-bg-color: '
        . htmlspecialchars($this->backgroundColor, ENT_QUOTES, 'UTF-8') . ';';
}
$bgStyle = implode(' ', $bgStyleParts);
?>
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><?php echo _('Track History'); ?></title>
    <link rel="stylesheet" href="<?php echo $this->widgetCss; ?>">
</head>
<body class="np-widget np-track-history <?php echo htmlspecialchars($this->themeClass, ENT_QUOTES, 'UTF-8'); ?>"
      data-widget="track-history"
      data-day-local="<?php echo htmlspecialchars($this->dayLocal, ENT_QUOTES, 'UTF-8'); ?>"
      data-time-local="<?php echo htmlspecialchars($this->timeLocal, ENT_QUOTES, 'UTF-8'); ?>"
      data-min-date="<?php echo htmlspecialchars($this->minDate, ENT_QUOTES, 'UTF-8'); ?>"
      data-max-date="<?php echo htmlspecialchars($this->maxDate, ENT_QUOTES, 'UTF-8'); ?>"
      data-pagesize="<?php echo (int) $this->pagesize; ?>"
      data-timezone="<?php echo htmlspecialchars($this->timezone, ENT_QUOTES, 'UTF-8'); ?>"
      data-cache-ttl="<?php echo (int) $this->cacheTtl; ?>"
      data-label-empty="<?php echo htmlspecialchars($this->emptyLabel, ENT_QUOTES, 'UTF-8'); ?>"
      data-art="<?php echo $this->artEnabled ? '1' : '0'; ?>"
      data-art-url="<?php echo htmlspecialchars($this->artUrlPrefix, ENT_QUOTES, 'UTF-8'); ?>"
      <?php if ($bgStyle): ?>style="<?php echo $bgStyle; ?>"<?php endif; ?>>

    <!-- ─── Header band ─── -->
    <div class="np-th-header">
        <input type="date" class="np-th-date" data-np="date"
               value="<?php echo htmlspecialchars($this->dayLocal, ENT_QUOTES, 'UTF-8'); ?>"
               min="<?php echo htmlspecialchars($this->minDate, ENT_QUOTES, 'UTF-8'); ?>"
               max="<?php echo htmlspecialchars($this->maxDate, ENT_QUOTES, 'UTF-8'); ?>">
        <input type="time" class="np-th-time" data-np="time"
               value="<?php echo htmlspecialchars($this->timeLocal, ENT_QUOTES, 'UTF-8'); ?>">
        <button type="button" class="np-th-now" data-np="now"><?php echo _('Now'); ?></button>
        <select class="np-th-pagesize" data-np="pagesize">
            <?php foreach ([10, 20, 50, 100] as $opt) { ?>
                <option value="<?php echo $opt; ?>"
                        <?php if ($opt === (int) $this->pagesize) echo 'selected'; ?>
                ><?php echo $opt; ?></option>
            <?php } ?>
        </select>
    </div>

    <!-- ─── Track list ─── -->
    <ul class="np-th-list" data-np="list">
        <?php /* rows rendered by JS once the first fetch returns */ ?>
    </ul>

    <!-- ─── Load-more footer ─── -->
    <div class="np-th-footer" data-np="footer">
        <button type="button" class="np-th-loadmore" data-np="loadmore"
                style="display: none;"><?php echo _('Load more'); ?></button>
        <span class="np-th-status" data-np="status"></span>
    </div>

    <!-- ─── Modal ─── -->
    <div class="np-th-modal-overlay" data-np="modal-overlay"></div>
    <div class="np-th-modal" data-np="modal" role="dialog" aria-modal="true">
        <button type="button" class="np-th-modal-close" data-np="modal-close" aria-label="<?php echo _('Close'); ?>">&times;</button>
        <h3 class="np-th-modal-title" data-np="modal-title"></h3>
        <p class="np-th-modal-artist" data-np="modal-artist"></p>
        <p class="np-th-modal-time" data-np="modal-time"></p>
        <p class="np-th-modal-show-intro" data-np="modal-show-intro"><?php echo _('Played in the show:'); ?></p>
        <p class="np-th-modal-show" data-np="modal-show"></p>
        <a class="np-th-modal-link" data-np="modal-link" href="#" target="_blank" rel="noopener noreferrer"><?php echo _('Open show page'); ?> &rarr;</a>
    </div>

    <script src="<?php echo $this->widgetJs; ?>" defer></script>
</body>
</html>
