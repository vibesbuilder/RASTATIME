<script>
(function () {
    "use strict";
    var CFG = <?php echo $cfg; ?>;

    var root = document.getElementById("pl_root");
    var btn = document.getElementById("pl_btn");
    var elTrack = document.getElementById("pl_now_track");
    var elShow = document.getElementById("pl_now_show");
    var elNext = document.getElementById("pl_next");
    var elVol = document.getElementById("pl_vol");
    var elCover = document.getElementById("pl_cover");
    var elCoverImg = elCover ? elCover.querySelector("img") : null;

    // A "localhost" Icecast host only resolves on the server itself —
    // rewrite it to the host this page is served from so a remote
    // listener reaches the stream.  Explicit hosts stay untouched.
    function reachableUrl(url) {
        if (!url) { return url; }
        return url.replace(/^(https?:\/\/)(?:localhost|127\.0\.0\.1)\b/i,
            "$1" + window.location.hostname);
    }

    var MIME = {
        mp3: "audio/mpeg", aac: "audio/aac", aacplus: "audio/aac",
        mp4: "audio/mp4", ogg: "audio/ogg", vorbis: "audio/ogg",
        opus: 'audio/ogg; codecs="opus"'
    };

    // Build the try-order: preferred device class first, the other one
    // appended; browser-playable codecs first within each class.  The
    // probe element is throwaway.
    function buildQueue() {
        if (CFG.mode !== "auto") {
            return CFG.url ? [{ url: CFG.url, codec: CFG.codec || "" }] : [];
        }
        var mobile = window.matchMedia
            ? window.matchMedia("(max-width: 760px)").matches
            : (screen.width <= 760);
        var pref = mobile ? CFG.streams.mobile : CFG.streams.desktop;
        var rest = mobile ? CFG.streams.desktop : CFG.streams.mobile;
        var all = (pref || []).concat(rest || []);
        var probe = document.createElement("audio");
        var playable = [], fallback = [];
        all.forEach(function (s) {
            var mime = MIME[(s.codec || "").toLowerCase()] || "";
            if (mime && probe.canPlayType && probe.canPlayType(mime) !== "") {
                playable.push(s);
            } else {
                fallback.push(s);
            }
        });
        return playable.concat(fallback);
    }

    var queue = buildQueue().map(function (s) {
        return { url: reachableUrl(s.url), codec: s.codec };
    });
    var qIndex = 0;
    var attempts = 0;
    var wantPlaying = false;

    var audio = new Audio();
    audio.preload = "none";

    function setState(playing) {
        root.classList.toggle("pl-playing", playing);
        btn.classList.remove("pl-busy");
    }

    function startCurrent() {
        if (queue.length === 0) {
            elTrack.textContent = CFG.labels.offline;
            elTrack.classList.add("pl-err");
            return;
        }
        btn.classList.add("pl-busy");
        // A fresh src per start reconnects at the live edge instead of
        // resuming a stale buffer.
        audio.src = queue[qIndex].url;
        var p = audio.play();
        if (p && typeof p.catch === "function") {
            p.catch(function () { tryNext(); });
        }
    }

    function tryNext() {
        if (!wantPlaying) { return; }
        attempts += 1;
        if (attempts >= queue.length) {
            wantPlaying = false;
            setState(false);
            elTrack.textContent = CFG.labels.offline;
            elTrack.classList.add("pl-err");
            return;
        }
        qIndex = (qIndex + 1) % queue.length;
        startCurrent();
    }

    audio.addEventListener("playing", function () {
        attempts = 0;
        elTrack.classList.remove("pl-err");
        setState(true);
    });
    audio.addEventListener("error", function () { tryNext(); });

    function play() {
        wantPlaying = true;
        attempts = 0;
        startCurrent();
    }

    function stop() {
        wantPlaying = false;
        audio.pause();
        // Drop the connection entirely — a paused live stream would
        // otherwise keep buffering (and keep a listener slot busy).
        audio.removeAttribute("src");
        try { audio.load(); } catch (e) { /* ignore */ }
        setState(false);
    }

    btn.addEventListener("click", function () {
        if (wantPlaying) { stop(); } else { play(); }
    });

    if (elVol) {
        try {
            var saved = localStorage.getItem("rt_player_vol");
            if (saved !== null) {
                elVol.value = saved;
                audio.volume = Math.min(1, Math.max(0, saved / 100));
            }
        } catch (e) { /* private mode etc. */ }
        elVol.addEventListener("input", function () {
            audio.volume = Math.min(1, Math.max(0, elVol.value / 100));
            try { localStorage.setItem("rt_player_vol", elVol.value); } catch (e) { /* ignore */ }
        });
    }

    // ───── metadata: widget-family JSON endpoint, smart refresh ─────
    var metaTimer = null;

    function scheduleMeta(ms) {
        if (metaTimer) { clearTimeout(metaTimer); }
        metaTimer = setTimeout(refreshMeta, ms);
    }

    // W4.1 — show the cover only for a track that has one; never point
    // the <img> at a cover-less id (0-byte 200 = hanging image).
    // RASTATIME 2026-09-30 — without a track cover the show's image is
    // the cover (webstream, line-in, cover-less track); a show whose
    // image file is gone answers with the station logo, never 0 bytes.
    // RASTATIME 2026-10-01 — the picture follows the Stream Label: with
    // "Station - Show" (2) the listener is not told the track, so the
    // show's image comes first and the track's cover never; the default
    // cover (Settings → Widgets → Player) closes every chain.
    var showLevel = CFG.streamLabelFormat === 2;
    function paintCover(track, show) {
        if (!elCover || !elCoverImg || !CFG.art) { return; }
        var url = null;
        if (!showLevel && track && track.hasArtwork && track.fileId) {
            url = CFG.artUrlPrefix + encodeURIComponent(track.fileId);
        } else if (show && show.hasImage && show.id && CFG.showLogoUrlPrefix) {
            url = CFG.showLogoUrlPrefix + encodeURIComponent(show.id);
        } else if (CFG.defaultCoverUrl) {
            url = CFG.defaultCoverUrl;
        }
        if (url) {
            if (elCoverImg.getAttribute("src") !== url) {
                elCoverImg.setAttribute("src", url);
            }
            // Class, not style.display="" — the base rule is
            // display:none, so clearing the inline style would just
            // fall back to hidden.
            elCover.classList.add("pl-cover-on");
        } else {
            elCover.classList.remove("pl-cover-on");
            elCoverImg.removeAttribute("src");
        }
    }

    function refreshMeta() {
        fetch(CFG.dataUrl, { cache: "default" })
            .then(function (r) { return r.json(); })
            .then(function (d) {
                var nextPollMs = 20000;
                var track = d.track || {};
                var show = d.show || {};
                if (!elTrack.classList.contains("pl-err")) {
                    if (track.current) {
                        // RASTATIME 2026-10-01 — "Station - Show": the
                        // headline is the show, the track is not named
                        elTrack.textContent = showLevel
                            ? (show.current ? show.current.name : CFG.labels.onAir)
                            : (track.current.artist
                                ? track.current.artist + " — " + track.current.title
                                : track.current.title);
                        var ends = Date.parse(track.current.ends);
                        if (!isNaN(ends)) {
                            // Re-poll just after the running track ends
                            // (+3 s so the server has updated), clamped.
                            nextPollMs = Math.min(120000,
                                Math.max(5000, ends - Date.now() + 3000));
                        }
                    } else if (show.current) {
                        elTrack.textContent = showLevel && show.current.name
                            ? show.current.name : CFG.labels.onAir;
                    } else {
                        elTrack.textContent = CFG.labels.offAir;
                    }
                }
                paintCover(track.current, show.current);
                elShow.textContent = showLevel
                    ? (show.current ? (CFG.stationName || "") : "")
                    : (show.current ? show.current.name : "");
                var next = showLevel
                    ? ((show.next && show.next.name) || "")
                    : ((track.next && track.next.title)
                        || (show.next && show.next.name) || "");
                elNext.textContent = next
                    ? CFG.labels.next + ": " + next : "";
                scheduleMeta(nextPollMs);
            })
            .catch(function () { scheduleMeta(30000); });
    }

    refreshMeta();
}());
</script>

</body>
</html>
