<?php
// RASTATIME 2026-05-22 — Now-Playing Track Widget template.
// Two-line iframe content; CSS + JS shipped from public/.
$payload = $this->initialPayload;
$current = $payload['track']['current'] ?? null;
$next    = $payload['track']['next'] ?? null;
$labels  = $this->emptyLabels;

/**
 * Render "Artist - Title" or just "Title" when artist is empty.
 */
function rastatime_format_track_label($track)
{
    if (empty($track)) {
        return null;
    }
    $title = trim((string) ($track['title'] ?? ''));
    $artist = trim((string) ($track['artist'] ?? ''));
    if ($title === '' && $artist === '') {
        return null;
    }
    if ($artist === '') {
        return $title;
    }
    if ($title === '') {
        return $artist;
    }
    return $artist . ' - ' . $title;
}

$currentLabel = rastatime_format_track_label($current);
$nextLabel    = rastatime_format_track_label($next);
?>
<!DOCTYPE html>
<html lang="<?php /* RASTATIME 2026-10-25 - station language */ echo htmlspecialchars($this->widgetLang ?: 'en', ENT_QUOTES, 'UTF-8'); ?>">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><?php echo _('Now Playing — Track'); ?></title>
    <link rel="stylesheet" href="<?php echo $this->widgetCss; ?>">
    <?php /* RASTATIME 2026-09-29 - the station's primary colour (Settings -> General) */ echo Application_Model_AccentColor::styleTag() ?>
</head>
<body class="np-widget np-now-playing <?php echo htmlspecialchars($this->themeClass, ENT_QUOTES, 'UTF-8'); ?> <?php echo htmlspecialchars($this->overflowClass, ENT_QUOTES, 'UTF-8'); ?>"
      data-widget="track"
      data-data-url="<?php echo htmlspecialchars($this->dataUrl, ENT_QUOTES, 'UTF-8'); ?>"
      data-cache-ttl="<?php echo (int) $this->cacheTtl; ?>"
      data-label-no-current="<?php echo htmlspecialchars($labels['noCurrentTrack'], ENT_QUOTES, 'UTF-8'); ?>"
      data-label-no-upcoming="<?php echo htmlspecialchars($labels['noUpcomingTrack'], ENT_QUOTES, 'UTF-8'); ?>"
      data-art="<?php echo $this->artEnabled ? '1' : '0'; ?>"
      data-art-url="<?php echo htmlspecialchars($this->artUrlPrefix, ENT_QUOTES, 'UTF-8'); ?>"
      data-show-logo-url="<?php echo htmlspecialchars($this->showLogoUrlPrefix, ENT_QUOTES, 'UTF-8'); ?>"
      data-default-cover-url="<?php echo htmlspecialchars((string) $this->defaultCoverUrl, ENT_QUOTES, 'UTF-8'); ?>">

<?php if ($this->artEnabled):
    // RASTATIME 2026-09-30 - the show's image is the fallback cover;
    // 2026-10-01 - the default cover (Settings -> Widgets -> Player) the last
    $currentShow = $payload['show']['current'] ?? null;
    if (!empty($current['hasArtwork']) && !empty($current['fileId'])) {
        $initArt = $this->artUrlPrefix . (int) $current['fileId'];
    } elseif (!empty($currentShow['hasImage']) && !empty($currentShow['id'])) {
        $initArt = $this->showLogoUrlPrefix . (int) $currentShow['id'];
    } elseif ($current !== null && !empty($this->defaultCoverUrl)) {
        $initArt = $this->defaultCoverUrl;
    } else {
        $initArt = null;
    }
?>
    <div class="np-art-wrap">
        <span class="np-cover<?php echo $initArt !== null ? ' np-cover-on' : ''; ?>" data-np="cover"><img alt=""<?php
            echo $initArt !== null
                ? ' src="' . htmlspecialchars($initArt, ENT_QUOTES, 'UTF-8') . '"'
                : '';
        ?> /></span>
        <div class="np-art-rows">
<?php endif; ?>
    <div class="np-row np-row-current">
        <span class="np-name" data-np="current-name"><?php
            echo htmlspecialchars($currentLabel ?? $labels['noCurrentTrack'], ENT_QUOTES, 'UTF-8');
        ?></span>
        <span class="np-time" data-np="current-time"
              data-starts="<?php echo htmlspecialchars($current['starts'] ?? '', ENT_QUOTES, 'UTF-8'); ?>"
              data-ends="<?php echo htmlspecialchars($current['ends'] ?? '', ENT_QUOTES, 'UTF-8'); ?>">
        </span>
    </div>

    <div class="np-row np-row-next">
        <span class="np-name" data-np="next-name"><?php
            echo htmlspecialchars($nextLabel ?? $labels['noUpcomingTrack'], ENT_QUOTES, 'UTF-8');
        ?></span>
        <span class="np-time" data-np="next-time"
              data-starts="<?php echo htmlspecialchars($next['starts'] ?? '', ENT_QUOTES, 'UTF-8'); ?>"
              data-ends="<?php echo htmlspecialchars($next['ends'] ?? '', ENT_QUOTES, 'UTF-8'); ?>">
        </span>
    </div>

<?php if ($this->artEnabled): ?>
        </div>
    </div>
<?php endif; ?>

    <script src="<?php echo $this->widgetJs; ?>" defer></script>
    <?php /* RASTATIME 2026-11-12 - grows with its content when the embedding page runs /embed/widgets.js */ ?>
    <script src="<?php echo Assets::url('js/airtime/embed/autoheight.js'); ?>" defer></script>
</body>
</html>
