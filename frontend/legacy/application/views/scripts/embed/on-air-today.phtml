<?php
// RASTATIME 2026-05-22 — On-Air-Today widget template.
//
// Layout (matches the uploaded operator screenshot):
//
//   On Air Today                 ← header band (accent colour)
//   ────────────────────────────
//   16:00 - 16:30   Newslink     ← row: time-of-day window + name
//   16:30 - 17:00   Pages of His-…
//   17:00 - 17:30   L'Info Chez-Vous
//   ...
//
// Names that are linked to a cc_show.url render as <a target=
// "_blank">; names without a URL render as plain text.  The
// currently-airing row gets the `np-row-current` class so the
// CSS can highlight it (bold, slight accent tint).
//
// View variables (all populated by EmbedController):
//   shows       - [{name, url, starts, ends, isCurrent, showId}, …]
//   isToday     - bool
//   dayLabel    - null when isToday, else "Sat, 25 May 2026"
//   dayLocal    - YYYY-MM-DD (used by the JS for refresh queries)
//   limit       - resolved limit (1..20)
//   emptyLabel  - operator-configurable empty-state placeholder
//   themeClass  - 'np-theme-auto' / 'np-theme-dark' / 'np-theme-light'
//   overflowClass - 'np-overflow-ellipsis' / 'np-overflow-marquee'
//   dataUrl     - JSON refresh endpoint (already query-stringed)
//   cacheTtl    - integer seconds for the JS poll cadence
//   widgetCss / widgetJs - asset URLs
$shows      = $this->shows;
$isToday    = $this->isToday;
$dayLabel   = $this->dayLabel;
$emptyLabel = $this->emptyLabel;
$headerText = $isToday ? _('On Air Today') : sprintf(_('On Air %s'), $dayLabel);
?>
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><?php echo htmlspecialchars($headerText, ENT_QUOTES, 'UTF-8'); ?></title>
    <link rel="stylesheet" href="<?php echo $this->widgetCss; ?>">
    <?php /* RASTATIME 2026-09-29 - the station's primary colour (Settings -> General) */ echo Application_Model_AccentColor::styleTag() ?>
</head>
<body class="np-widget np-on-air-today <?php echo htmlspecialchars($this->themeClass, ENT_QUOTES, 'UTF-8'); ?> <?php echo htmlspecialchars($this->overflowClass, ENT_QUOTES, 'UTF-8'); ?> <?php echo htmlspecialchars($this->linkClass, ENT_QUOTES, 'UTF-8'); ?>"
      data-widget="on-air-today"
      data-data-url="<?php echo htmlspecialchars($this->dataUrl, ENT_QUOTES, 'UTF-8'); ?>"
      data-cache-ttl="<?php echo (int) $this->cacheTtl; ?>"
      data-is-today="<?php echo $isToday ? '1' : '0'; ?>"
      data-day-local="<?php echo htmlspecialchars($this->dayLocal, ENT_QUOTES, 'UTF-8'); ?>"
      data-label-empty="<?php echo htmlspecialchars($emptyLabel, ENT_QUOTES, 'UTF-8'); ?>">

    <div class="np-header" data-np="header">
        <span class="np-header-text"><?php
            echo htmlspecialchars($headerText, ENT_QUOTES, 'UTF-8');
        ?></span>
    </div>

    <ul class="np-list" data-np="list">
        <?php if (empty($shows)) { ?>
            <li class="np-list-empty" data-np="empty">
                <span class="np-name"><?php
                    echo htmlspecialchars($emptyLabel, ENT_QUOTES, 'UTF-8');
                ?></span>
            </li>
        <?php } else {
            foreach ($shows as $s) {
                $rowClass = 'np-list-row np-on-air-row';
                if (!empty($s['isCurrent'])) {
                    $rowClass .= ' np-row-current';
                }
                $hasLink = !empty($s['url']);
                ?>
            <li class="<?php echo htmlspecialchars($rowClass, ENT_QUOTES, 'UTF-8'); ?>">
                <span class="np-on-air-time"
                      data-starts="<?php echo htmlspecialchars($s['starts'] ?? '', ENT_QUOTES, 'UTF-8'); ?>"
                      data-ends="<?php echo htmlspecialchars($s['ends'] ?? '', ENT_QUOTES, 'UTF-8'); ?>">
                    <?php /* HH:MM - HH:MM rendered by JS once the page boots */ ?>
                </span>
                <span class="np-on-air-name np-name">
                    <?php if ($hasLink) { ?>
                        <a href="<?php echo htmlspecialchars($s['url'], ENT_QUOTES, 'UTF-8'); ?>"
                           target="_blank" rel="noopener noreferrer"><?php
                            echo htmlspecialchars($s['name'], ENT_QUOTES, 'UTF-8');
                        ?></a>
                    <?php } else {
                        echo htmlspecialchars($s['name'], ENT_QUOTES, 'UTF-8');
                    } ?>
                </span>
            </li>
        <?php }
        } ?>
    </ul>

    <script src="<?php echo $this->widgetJs; ?>" defer></script>
</body>
</html>
