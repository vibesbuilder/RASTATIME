<?php
// RASTATIME 2026-05-22 — Multi-View Schedule widget template.
//
// FullCalendar 6.1.10 (locally hosted) renders a time-grid
// calendar with operator-switchable Day / 2-Day / Week views.
// Wave-1 conventions throughout: theme, cache, transparent
// background, optional bg image / colour.
//
// Layout:
//
//   ┌──────────────────────────────────────────────┐
//   │ ◀  Fri 22 May 2026               ▶  [D 2D W] │  ← header
//   ├──────────────────────────────────────────────┤
//   │ 06:00  ┌───────────────┐                      │
//   │        │ Morning Show  │                      │
//   │ 07:00  │ 06:00 – 08:00 │                      │
//   │        └───────────────┘                      │
//   │ 08:00  ┌───────────────┐                      │
//   │        │ Newslink      │                      │
//   │ ...    └───────────────┘                      │
//   └──────────────────────────────────────────────┘
//   (now-line in accent colour, current event glows;
//   click → modal with description + URL button)
//
// View variables (all populated by EmbedController::
// multiViewScheduleAction):
//   defaultView      - 'day' | '2day' | 'week'
//   themeClass       - 'np-theme-auto' / 'np-theme-dark' / 'np-theme-light'
//   timezone         - resolved IANA zone
//   fcLocale         - two-letter locale for FullCalendar
//   cacheTtl         - integer seconds (default 300 = 5 min)
//   backgroundUrl    - optional cover-image URL
//   backgroundColor  - optional hex background colour
//   emptyLabel       - operator-configurable empty-state text
//   widgetCss / widgetJs        - asset URLs
//   fullCalendarJs / fullCalendarLoc - vendored FullCalendar 6 + locales

$bgStyleParts = [];
if (!empty($this->backgroundUrl)) {
    $bgStyleParts[] = '--np-bg-image: url(\''
        . addslashes(htmlspecialchars($this->backgroundUrl, ENT_QUOTES, 'UTF-8'))
        . '\');';
}
if (!empty($this->backgroundColor)) {
    $bgStyleParts[] = '--np-bg-color: '
        . htmlspecialchars($this->backgroundColor, ENT_QUOTES, 'UTF-8') . ';';
}
$bgStyle = implode(' ', $bgStyleParts);
?>
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><?php echo _('Multi-View Schedule'); ?></title>
    <link rel="stylesheet" href="<?php echo $this->widgetCss; ?>">
</head>
<body class="np-widget np-multi-view-schedule <?php echo htmlspecialchars($this->themeClass, ENT_QUOTES, 'UTF-8'); ?>"
      data-widget="multi-view-schedule"
      data-default-view="<?php echo htmlspecialchars($this->defaultView, ENT_QUOTES, 'UTF-8'); ?>"
      data-timezone="<?php echo htmlspecialchars($this->timezone, ENT_QUOTES, 'UTF-8'); ?>"
      data-locale="<?php echo htmlspecialchars($this->fcLocale, ENT_QUOTES, 'UTF-8'); ?>"
      data-clock="<?php echo htmlspecialchars($this->clock, ENT_QUOTES, 'UTF-8'); ?>"
      data-cache-ttl="<?php echo (int) $this->cacheTtl; ?>"
      data-label-empty="<?php echo htmlspecialchars($this->emptyLabel, ENT_QUOTES, 'UTF-8'); ?>"
      <?php if ($bgStyle): ?>style="<?php echo $bgStyle; ?>"<?php endif; ?>>

    <!-- ─── Header band: nav buttons + date label + view switcher ─── -->
    <div class="np-mv-header">
        <button type="button" class="np-mv-nav" data-np="prev" aria-label="<?php echo _('Previous'); ?>">&#x25C0;</button>
        <span class="np-mv-range" data-np="range"><?php /* date label rendered by JS */ ?></span>
        <button type="button" class="np-mv-nav" data-np="next" aria-label="<?php echo _('Next'); ?>">&#x25B6;</button>
        <button type="button" class="np-mv-today" data-np="today"><?php echo _('Today'); ?></button>
        <span class="np-mv-views">
            <button type="button" class="np-mv-view" data-view="day"><?php echo _('Day'); ?></button>
            <button type="button" class="np-mv-view" data-view="2day"><?php echo _('2 Days'); ?></button>
            <button type="button" class="np-mv-view" data-view="week"><?php echo _('Week'); ?></button>
        </span>
    </div>

    <!-- ─── FullCalendar mount point ─── -->
    <div class="np-mv-calendar" id="np-mv-calendar"></div>

    <!-- ─── Modal (hidden by default) ─── -->
    <div class="np-mv-modal-overlay" data-np="modal-overlay"></div>
    <div class="np-mv-modal" data-np="modal" role="dialog" aria-modal="true">
        <button type="button" class="np-mv-modal-close" data-np="modal-close" aria-label="<?php echo _('Close'); ?>">&times;</button>
        <h3 class="np-mv-modal-title" data-np="modal-title"></h3>
        <p class="np-mv-modal-time" data-np="modal-time"></p>
        <p class="np-mv-modal-description" data-np="modal-description"></p>
        <a class="np-mv-modal-link" data-np="modal-link" href="#" target="_blank" rel="noopener noreferrer"><?php echo _('Open show page'); ?> &rarr;</a>
    </div>

    <!-- ─── Vendored FullCalendar 6 + locales ─── -->
    <script src="<?php echo $this->fullCalendarJs; ?>"></script>
    <script src="<?php echo $this->fullCalendarLoc; ?>"></script>

    <!-- ─── Widget-specific runtime ─── -->
    <script src="<?php echo $this->widgetJs; ?>" defer></script>
</body>
</html>
