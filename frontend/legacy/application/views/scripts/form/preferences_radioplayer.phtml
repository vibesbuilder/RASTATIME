<?php
/* RASTATIME 2026-11-10 - Radioplayer feed for ORF Sound (Settings -> General, below Live Text Info). */
$feedUrl = rtrim(Config::getPublicUrl(), '/') . '/embed/radioplayer-events';
$key = Application_Model_Preference::getRadioplayerKey();
if ($key !== '') {
    $feedUrl .= '?key=' . rawurlencode($key);
}
?>
<fieldset class="padded radioplayer-settings">
    <p class="input-settings-inline-p">
        <?php echo _("A JSON feed in the format of the Radioplayer \"events\" lookup (previous / now / next) that ORF Sound polls for private stations: the last played tracks, the running track with its cover, or the running show for webstreams, Line-In and live DJs. Independent of Live Text Info and of the public API switch.") ?>
    </p>
    <dl class="zend_form">
        <?php if ($this->element->getElement("enable_radioplayer")->hasErrors()) {
            echo $this->element->getElement('enable_radioplayer')->renderErrors();
        } ?>
        <?php echo $this->element->getElement('enable_radioplayer')->renderViewHelper() ?>
        <?php echo $this->element->getElement('enable_radioplayer')->renderLabel() ?>
        <p class="input-settings-inline-p">
            <?php echo _("Feed address:") ?> <a href="<?php echo htmlspecialchars($feedUrl, ENT_QUOTES); ?>" target="_blank"><?php echo htmlspecialchars($feedUrl); ?></a>
        </p>

        <?php echo $this->element->getElement('radioplayer_key')->render() ?>
        <?php echo $this->element->getElement('radioplayer_rp_id')->render() ?>
        <?php echo $this->element->getElement('radioplayer_service_description')->render() ?>
        <?php echo $this->element->getElement('radioplayer_previous')->render() ?>
        <?php echo $this->element->getElement('radioplayer_min_seconds')->render() ?>
        <?php echo $this->element->getElement('radioplayer_poll_seconds')->render() ?>
    </dl>
</fieldset>
