<?php
// RASTATIME 2026-11-24 - "Host names" in Edit Show → What (§23.133): the
// value is a JSON list in a hidden field; add-show.js setupHostNames draws
// the names as chips with a remove button and an input with suggestions
// (data-rt-people: every name of the register).  Read-only in Edit Episode
// (AddShowWhat::makeReadonly sets the attribute).
$el = $this->element;
$name = $el->getName();
$h = fn ($v) => htmlspecialchars((string) $v, ENT_QUOTES, 'UTF-8');
$value = $el->getValue();
if (is_array($value)) {
    $value = json_encode(array_values($value), JSON_UNESCAPED_UNICODE);
}
$readonly = (bool) $el->getAttrib('readonly');
?>
<dt id="<?php echo $name; ?>-label" class="<?php echo $h($this->class); ?>">
    <label for="<?php echo $name; ?>_input"><?php echo $h($el->getLabel()); ?></label><span class="help_icon" data-rt-tip="<?php echo $h($el->getDescription()); ?>"></span>
</dt>
<dd id="<?php echo $name; ?>-element" class="<?php echo $h($this->class); ?>">
    <input type="hidden" name="<?php echo $name; ?>" id="<?php echo $name; ?>" class="rt-people-value" value="<?php echo $h($value ?: '[]'); ?>"
           data-rt-people="<?php echo $h($el->getAttrib('data-rt-people') ?: '[]'); ?>"<?php echo $readonly ? ' data-readonly="1"' : ''; ?> />
    <span class="rt-people-list"></span>
    <?php if (!$readonly): ?>
        <input type="text" id="<?php echo $name; ?>_input" class="input_text rt-people-input" maxlength="128" autocomplete="off"
               placeholder="<?php echo $h(_('Add a name')); ?>" />
    <?php endif; ?>
    <?php if ($el->hasErrors()) {
        echo $this->formErrors($el->getMessages());
    } ?>
</dd>
