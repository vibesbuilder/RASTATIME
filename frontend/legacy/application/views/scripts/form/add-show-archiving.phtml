<?php
// RASTATIME 2026-11-03 - archiving stage 1: "Archiving" section of the
// show form (Application_Form_AddShowArchiving).  Labels above their field,
// help icons right of the label (tooltip convention), errors below.
// Stage 2: CBA account, visibility, topic list, the licence matrix as an
// HTML tooltip (data-rt-tip-html, operator 2026-11-03).
$h = fn ($v) => htmlspecialchars((string) $v, ENT_QUOTES);
$f = $this->element;
$tips = [
    'add_show_editor_profiles' => _('The people behind this show. They are sent to cba.media as editors with every episode. Profiles are managed under Settings → Editorial Team.'),
    'add_show_participants' => _('How many people usually take part in an episode, for the yearly statistics (Analytics → Participants). A single episode can differ: Episode... in the calendar.'),
    'add_show_cba_series_id' => _('The number of the podcast (series) on cba.media that the episodes of this show belong to.'),
    'add_show_cba_account' => _('The CBA user the episodes are archived under. Accounts are managed by admins under Settings → CBA Accounts.'),
    'add_show_cba_status' => _('Public: listed on cba.media. Unlisted: reachable by its address only. Private: visible to the CBA user only.'),
    'add_show_cba_category_id' => $f->getElement('add_show_cba_category_id') instanceof Zend_Form_Element_Select
        ? _('The topic (category) on cba.media.')
        : _('The number of the topic (category) on cba.media. The list appears once the background service has fetched it.'),
    'add_show_cba_languages' => _('Up to three language codes the CBA knows, such as "de, en".'),
    'add_show_cba_tags' => _('Comma-separated tags for cba.media.'),
    'add_show_cba_teaser' => _('Used for every episode that has no teaser of its own.'),
    'add_show_cba_contains_copyright' => _('The episodes usually contain music that is subject to copyright (AKM).'),
];
$row = function ($name, $wide = true) use ($f, $h, $tips) {
    $el = $f->getElement($name);
    $id = $name . '_label';
    echo '<dt id="' . $id . '" class="rt-archiving-label"><label for="' . $name . '">' . $h($el->getLabel()) . '</label>';
    if ($name === 'add_show_cba_license') {
        // the matrix: which licence answers attribution / commercial use / adaptations
        echo '<span class="help_icon" data-rt-tip-html="' . $h(Application_Service_ArchivingService::licenseMatrixHtml()) . '"></span></dt>';
    } else {
        echo '<span class="help_icon" data-rt-tip="' . $h($tips[$name]) . '"></span></dt>';
    }
    echo '<dd id="' . $name . '-element"' . ($wide ? ' class="rt-archiving-field"' : '') . '>' . $el;
    if ($errs = $el->getMessages()) {
        echo '<ul class="errors">';
        foreach ($errs as $e) {
            echo '<li>' . $h($e) . '</li>';
        }
        echo '</ul>';
    }
    echo '</dd>';
};
?>
<fieldset class="rt-archiving">
    <dl>
        <?php if (!Application_Service_ArchivingService::tablesReady()): ?>
            <p class="rt-archiving-note"><?php echo _("The archiving tables are missing - run the database migrations 0074 and 0075 first."); ?></p>
        <?php else: ?>
            <?php $row('add_show_editor_profiles'); ?>
            <?php if (!$f->getElement('add_show_editor_profiles')->getMultiOptions()): ?>
                <p class="rt-archiving-note"><?php echo _("No profile yet - add the people under Settings → Editorial Team."); ?></p>
            <?php endif; ?>
            <?php $row('add_show_participants'); ?>
            <?php $row('add_show_cba_account'); ?>
            <?php if (count($f->getElement('add_show_cba_account')->getMultiOptions()) < 2): ?>
                <p class="rt-archiving-note"><?php echo _("No CBA account yet - an admin adds them under Settings → CBA Accounts."); ?></p>
            <?php endif; ?>
            <?php $row('add_show_cba_status'); ?>
            <?php $row('add_show_cba_series_id'); ?>
            <?php $row('add_show_cba_license'); ?>
            <?php $row('add_show_cba_category_id'); ?>
            <?php $row('add_show_cba_languages'); ?>
            <?php $row('add_show_cba_tags'); ?>
            <?php $row('add_show_cba_teaser'); ?>
            <dt id="add_show_cba_contains_copyright_label" class="rt-archiving-label rt-archiving-check">
                <?php echo $f->getElement('add_show_cba_contains_copyright'); ?>
                <label for="add_show_cba_contains_copyright"><?php echo $h($f->getElement('add_show_cba_contains_copyright')->getLabel()); ?></label>
                <span class="help_icon" data-rt-tip="<?php echo $h($tips['add_show_cba_contains_copyright']); ?>"></span>
            </dt>
        <?php endif; ?>
    </dl>
</fieldset>
