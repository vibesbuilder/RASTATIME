<?php
// RASTATIME 2026-11-04 - one row of the show form with a help icon right of
// the label (tooltip convention); the tip is the element's description.
// Used for "Own production" and "Number of involved people" (What).
$el = $this->element;
$name = $el->getName();
$h = fn ($v) => htmlspecialchars((string) $v, ENT_QUOTES, 'UTF-8');
?>
<dt id="<?php echo $name; ?>-label" class="<?php echo $h($this->class); ?>">
    <?php echo $this->formLabel($name, $el->getLabel()); ?><span class="help_icon" data-rt-tip="<?php echo $h($el->getDescription()); ?>"></span>
</dt>
<dd id="<?php echo $name; ?>-element" class="<?php echo $h($this->class); ?>">
    <?php echo $this->{$el->helper}($name, $el->getValue(), $el->getAttribs(), $el->options ?? null); ?>
    <?php if ($el->hasErrors()) {
        echo $this->formErrors($el->getMessages());
    } ?>
</dd>
