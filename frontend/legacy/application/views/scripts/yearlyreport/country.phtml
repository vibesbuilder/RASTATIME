<?php
// RASTATIME 2026-11-08 - Analytics → Music by Country: plays and minutes of
// the music (track type code 'music') per country, from the playout
// history, one year selector (Application_Service_MusicCountryReportService).
$h = fn ($v) => htmlspecialchars((string) $v, ENT_QUOTES, 'UTF-8');
$base = Config::getBasePath();
$r = $this->report;
$t = $r['totals'];
$fmt = fn ($n) => number_format((int) $n, 0, ',', '.');
$pct = fn ($v) => number_format((float) $v, 1, ',', '.') . ' %';
?>
<div class="ui-widget prefpanel clearfix padded-strong rt-participants rt-yearly rt-music-country">
    <h2><?php echo _("Music by Country"); ?></h2>
    <form method="get" action="<?php echo $h($base . 'yearlyreport/country'); ?>" class="rt-participants-filter">
        <label for="rt_country_year"><?php echo _("Year"); ?></label>
        <select name="year" id="rt_country_year" class="input_select" onchange="this.form.submit()">
            <?php foreach ($this->years as $y): ?>
                <option value="<?php echo (int) $y; ?>"<?php echo $y === $this->year ? ' selected' : ''; ?>><?php echo (int) $y; ?></option>
            <?php endforeach; ?>
        </select>
        <?php if ($this->isCurrentYear): ?>
            <span class="rt-participants-note"><?php echo sprintf(_("%d so far (up to %s)."), (int) $this->year, $h($this->today)); ?></span>
        <?php endif; ?>
    </form>

    <p class="rt-participants-note">
        <?php echo sprintf(
            _("Where the music that aired comes from, for the music quota. Counted are the plays in the playout history of tracks with the track type \"%s\", with the country of the track (Edit Track → Country, read from the COUNTRY tag on import). Tracks without a country count as \"No country\". Music played live by DJs, line-ins and webstreams are not in the playout history."),
            $h($r['music_type'] ?? 'Music')
        ); ?>
    </p>
    <?php if ($t['first_play'] !== null && $t['first_play'] > sprintf('%04d-01-07', (int) $this->year)): ?>
        <p class="rt-participants-note"><?php echo sprintf(_("The playout history of this year starts on %s."), $h($t['first_play'])); ?></p>
    <?php endif; ?>
    <?php if (!$r['ready']): ?>
        <p class="rt-participants-warn"><?php echo _("The column for the country is missing - run the database migration 0081 first. Until then every track counts as \"No country\"."); ?></p>
    <?php endif; ?>
    <?php if ($r['music_type'] === null): ?>
        <p class="rt-participants-warn"><?php echo _("There is no track type with the code \"music\" (Settings → Track Types), so no track counts as music."); ?></p>
    <?php endif; ?>
    <p>
        <a class="btn" href="<?php echo $h($base . 'yearlyreport/country-csv?year=' . (int) $this->year); ?>"><?php echo _("Download CSV"); ?></a>
    </p>
    <div class="rt-participants-totals">
        <div><strong><?php echo $fmt($t['minutes']); ?></strong><span><?php echo _("Minutes of music"); ?></span></div>
        <div><strong><?php echo $fmt($t['plays']); ?></strong><span><?php echo _("Plays"); ?></span></div>
        <div><strong><?php echo $fmt($t['countries']); ?></strong><span><?php echo _("Countries"); ?></span></div>
        <div><strong><?php echo $pct($t['share_tagged']); ?></strong><span><?php echo _("Share of minutes with a country"); ?></span></div>
    </div>

    <?php if (empty($r['rows'])): ?>
        <p class="rt-participants-empty"><?php echo _("No music aired in this year."); ?></p>
    <?php else: ?>
        <table class="datatable rt-participants-table rt-country-rows">
            <thead>
                <tr>
                    <th><?php echo _("Country"); ?></th>
                    <th class="num"><?php echo _("Plays"); ?></th>
                    <th class="num"><?php echo _("Share of plays"); ?></th>
                    <th class="num"><?php echo _("Minutes"); ?></th>
                    <th class="num"><?php echo _("Share of minutes"); ?></th>
                </tr>
            </thead>
            <tbody>
                <?php $i = 0; foreach ($r['rows'] as $row): ?>
                    <tr class="<?php echo $i++ & 1 ? 'even' : 'odd'; ?><?php echo $row['country'] === null ? ' rt-yearly-other' : ''; ?>">
                        <td><?php echo $row['country'] === null ? _("No country") : $h($row['country']); ?></td>
                        <td class="num"><?php echo $fmt($row['plays']); ?></td>
                        <td class="num"><?php echo $pct($row['share_plays']); ?></td>
                        <td class="num"><?php echo $fmt($row['minutes']); ?></td>
                        <td class="num"><?php echo $pct($row['share_minutes']); ?></td>
                    </tr>
                <?php endforeach; ?>
            </tbody>
        </table>

        <table class="datatable rt-participants-table rt-yearly-months">
            <thead>
                <tr>
                    <th><?php echo _("Month"); ?></th>
                    <th class="num"><?php echo _("Plays"); ?></th>
                    <th class="num"><?php echo _("Minutes"); ?></th>
                    <th class="num"><?php echo _("Minutes with a country"); ?></th>
                    <th class="num"><?php echo _("Share with a country"); ?></th>
                </tr>
            </thead>
            <tbody>
                <?php $i = 0; foreach ($r['months'] as $mon => $row): ?>
                    <tr class="<?php echo $i++ & 1 ? 'even' : 'odd'; ?>">
                        <td><?php echo $h($this->monthNames[$mon]); ?></td>
                        <td class="num"><?php echo $row['plays'] ? $fmt($row['plays']) : ''; ?></td>
                        <td class="num"><?php echo $row['minutes'] ? $fmt($row['minutes']) : ''; ?></td>
                        <td class="num"><?php echo $row['plays'] ? $fmt($row['minutes_tagged']) : ''; ?></td>
                        <td class="num"><?php echo $row['plays'] ? $pct($row['share_tagged']) : ''; ?></td>
                    </tr>
                <?php endforeach; ?>
            </tbody>
        </table>

        <?php if (!empty($r['untagged'])): ?>
            <h3><?php echo _("Most played music without a country"); ?></h3>
            <p class="rt-participants-note"><?php echo _("Enter the country in Edit Track (or for several tracks at once in the bulk editor); the report counts it for the past plays too."); ?></p>
            <table class="datatable rt-participants-table rt-country-untagged">
                <thead>
                    <tr>
                        <th class="num"><?php echo _("ID"); ?></th>
                        <th><?php echo _("Title"); ?></th>
                        <th><?php echo _("Creator"); ?></th>
                        <th class="num"><?php echo _("Plays"); ?></th>
                        <th class="num"><?php echo _("Minutes"); ?></th>
                    </tr>
                </thead>
                <tbody>
                    <?php $i = 0; foreach ($r['untagged'] as $row): ?>
                        <tr class="<?php echo $i++ & 1 ? 'even' : 'odd'; ?>">
                            <td class="num"><?php echo (int) $row['id']; ?></td>
                            <td><?php echo $h($row['title']); ?></td>
                            <td><?php echo $h($row['artist']); ?></td>
                            <td class="num"><?php echo $fmt($row['plays']); ?></td>
                            <td class="num"><?php echo $fmt($row['minutes']); ?></td>
                        </tr>
                    <?php endforeach; ?>
                </tbody>
            </table>
        <?php endif; ?>
    <?php endif; ?>
</div>
