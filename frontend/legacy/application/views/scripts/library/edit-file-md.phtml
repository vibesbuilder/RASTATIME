<script>
(function ($) {
  // RASTATIME 2026-10-16 - "Teaser for shows" as the Song-Request-Pool
  // dropdown (preferences.js setupRequestablePoolDropdown, styles .rt-sbdd):
  // a button that opens a dark panel of checkboxes.  The checkbox markup
  // is only wrapped, the form posts teaser_show_id[] as before.  Scoped to
  // THIS dialog: closed dialogs may still sit in the DOM.
  var $form = $("#track_edit_<?php echo (int) $this->id; ?>");
  var $type = $form.find("#teaser_type");
  var $boxes = $form.find('input[name="teaser_show_id[]"]');
  if ($boxes.length === 0 || $form.find(".rt-sbdd").length > 0) {
    return;
  }
  var $dd = $boxes.first().closest("dd");
  var $panel = $('<div class="rt-sbdd-panel rt-sbdd-wide"></div>').append($dd.children("label, br"));
  var $btn = $('<button type="button" class="rt-sbdd-button"></button>');
  var $wrap = $('<div class="rt-sbdd"></div>').append($btn, $panel);
  $dd.prepend($wrap);
  var word = $.i18n._("Shows");
  function label() {
    var n = $boxes.filter(":checked").not('[value="none"]').length;
    $btn.text(n ? word + " (" + n + ")" : word);
  }
  function sync() {
    var on = $type.val() !== "" && $type.val() !== null;
    $boxes.prop("disabled", !on);
    $btn.prop("disabled", !on);
    $wrap.toggleClass("rt-off", !on);
    if (!on) {
      $boxes.prop("checked", false);
      $wrap.removeClass("open");
    }
    label();
  }
  $btn.on("click", function (e) {
    e.stopPropagation();
    $wrap.toggleClass("open");
  });
  $(document).on("click", function (e) {
    if ($(e.target).closest(".rt-sbdd").length === 0) {
      $wrap.removeClass("open");
    }
  });
  $boxes.on("change", label);
  $type.on("change", sync);
  sync();
})(jQuery);
(function ($) {
  // RASTATIME 2026-11-08 - "Track disabled" and the expiry date keep each
  // other in step before the save (operator rules): an expiry date that has
  // passed ticks the box; moving it ahead or clearing it unticks the box
  // only when the expiry (not the operator) had ticked it; unticking the box
  // empties an expiry date that has passed (the hourly expiry run would
  // disable the track again).  An expiry date counts from 00:00 of that day.
  var $form = $("#track_edit_<?php echo (int) $this->id; ?>");
  var $box = $form.find('input[type="checkbox"][name="disabled"]');
  var $expiry = $form.find('input[name="expires_at"]');
  if ($box.length === 0 || $expiry.length === 0) {
    return;
  }
  var today = $box.attr("data-today") || "";
  var byExpiry = $box.attr("data-by-expiry") === "1";
  var isDate = function (v) {
    return /^\d{4}-\d{2}-\d{2}$/.test(v);
  };
  var passed = function (v) {
    return isDate(v) && today !== "" && v <= today;
  };
  $expiry.on("input change", function () {
    var v = $.trim($expiry.val());
    if (v !== "" && !isDate(v)) {
      return; // still typing
    }
    if (passed(v)) {
      if (!$box.prop("checked")) {
        $box.prop("checked", true);
        byExpiry = true;
      }
    } else if (byExpiry && $box.prop("checked")) {
      $box.prop("checked", false);
      byExpiry = false;
    }
  });
  $box.on("change", function () {
    byExpiry = false; // the operator decides from here
    if (!$box.prop("checked") && passed($.trim($expiry.val()))) {
      $expiry.val("");
    }
  });
})(jQuery);
</script>
