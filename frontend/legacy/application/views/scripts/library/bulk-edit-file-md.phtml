<?php /* RASTATIME 2026-10-08 - dialog body for the bulk metadata editor (library toolbar "Edit" with several tracks selected) */ ?>
<div class="bulk-md-dialog">
    <p class="description" style="margin: 0 0 0.8em 0;">
        <?php echo $this->escape(sprintf(_('Editing the metadata of %s tracks. Empty fields stay unchanged; a filled field is written to every selected track.'), (int) $this->count)); ?>
    </p>
    <?php echo $this->form; ?>
<script>
(function ($) {
  // RASTATIME 2026-10-16 - the shows list opens once a teaser type is chosen;
  // back on "None" / "Leave unchanged" it is emptied and disabled (a
  // disabled multiselect is not posted - the save then clears the links
  // in the track editor and leaves them alone in the bulk editor)
  var $type = $("#teaser_type").last();
  var $form = $type.closest("form");
  var $shows = $form.find('input[name="teaser_show_id[]"]');
  function sync() {
    var on = $type.val() !== "" && $type.val() !== null;
    $shows.prop("disabled", !on);
    $shows.closest(".rt-teaser-shows, dd").toggleClass("rt-teaser-shows-off", !on);
    if (!on) {
      $shows.prop("checked", false);
    }
  }
  $type.on("change", sync);
  sync();
})(jQuery);
</script>
</div>
