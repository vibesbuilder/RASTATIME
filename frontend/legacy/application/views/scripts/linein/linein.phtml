<?php if (isset($this->obj)) : ?>
    <input class="obj_id"        type="hidden" value="<?php echo $this->escape($this->obj->getId()); ?>" />
    <input class="obj_lastMod"   type="hidden" value="1" />
    <input class="obj_type"      type="hidden" value="linein" />
    <input class="obj_device_id" type="hidden" value="<?php echo $this->escape($this->obj->getDeviceId()); ?>" />
    <div class="status" style="display:none;"></div>

    <div class="inner_editor_title">
        <H2><?php echo (_("Editing ")); ?>"<span class="title_obj_name"><?php
            if (isset($this->unsavedName)) {
                echo $this->unsavedName;
            } else {
                echo $this->escape($this->obj->getName());
            }
        ?></span>"</H2>
    </div>

    <div class="inner_editor_wrapper">
        <dl class="zend_form side_playlist playlist_editor">
            <dt>
                <label><?php echo (_("Name:")); ?></label>
            </dt>
            <dd>
                <div id="name-error" class="errors" style="display:none;"></div>
                <input class="playlist_name_display" type="text"
                       contenteditable="true"
                       value="<?php echo $this->escape($this->obj->getName()); ?>">
            </dd>

            <dt id="description-label">
                <label for="description"><?php echo _("Description") ?></label>
            </dt>
            <dd id="description-element">
                <textarea cols="80" rows="6" id="description" name="description"><?php
                    echo $this->escape($this->obj->getDescription());
                ?></textarea>
            </dd>

            <div id="device-error" class="errors" style="display:none;"></div>
            <dt id="lineindevice-label">
                <label for="linein-device"><?php echo _("Device:"); ?></label>
            </dt>
            <dd id="lineindevice-element">
                <select id="linein-device" name="device_id" style="width:100%">
                    <option value=""><?php echo _("— Loading devices …") ?></option>
                </select>
            </dd>

            <?php
            // RASTATIME 2026-09-17 (operator go: consolidation) — this
            // dialog is the ONE line-in editor now.  The channel picker
            // moved here from the former Settings → Local Machine →
            // Line-In Sources section, which is gone.  The enabled
            // toggle was dropped the same day (operator: a line-in that
            // exists may be used); the DB column stays true for the
            // API/playout contract.
            ?>
            <input class="obj_channel_mapping" type="hidden"
                   value="<?php echo $this->escape(implode(',', $this->obj->getChannelMapping())); ?>" />
            <div id="channels-error" class="errors" style="display:none;"></div>
            <dt id="lineinchannels-label">
                <label for="linein-channels"><?php echo _("Channels:"); ?></label>
            </dt>
            <dd id="lineinchannels-element">
                <select id="linein-channels" style="width:100%"></select>
                <p style="margin:0.4em 0 0 0; font-size:0.9em; color:#888;">
                    <?php echo _("A stereo pair or a mono channel of the picked device — a multichannel interface can serve one studio per pair."); ?>
                </p>
            </dd>

            <div id="length-error" class="errors" style="display:none;"></div>
            <dt id="streamlength-label">
                <label for="streamlength"><?php echo _("Default Length:"); ?></label>
            </dt>
            <dd id="streamlength-element">
                <input type="text" value="<?php echo $this->escape($this->obj->getDefaultLength()); ?>" />
            </dd>
        </dl>
