    <div class="btn-toolbar clearfix">
        <div class="btn-group pull-right">
            <button class="btn" type="button" id="linein_cancel" name="submit"><?php echo _("Cancel") ?></button>
        </div>
        <div class="btn-group pull-right">
            <button class="btn" type="submit" id="linein_save" name="submit"><?php echo _("Save") ?></button>
