<?php /* RASTATIME 2026-06-01 (JS-modernization stage 1): AngularJS removed.
       * Wired by the vanilla podcast.js (bootstrapPodcastEditor): form fields
       * carry data-field="<podcast property>", buttons data-action, and the
       * former ng-show row is .auto-expiry-row (toggled in JS). */ ?>
<div class="angular_wrapper">
    <div class="inner_editor_title">
        <h2>
            <?php echo _("Editing ") ?>"<span class="title_obj_name"></span>"
        </h2>
    </div>
    <div class="inner_editor_wrapper">
        <form class="podcast-metadata">
            <input class="obj_id" type="hidden" />
            <div class="podcast-metadata-row">
                <label for="podcast_name"><?php echo _("Podcast Name: ") ?></label>
                <input name="podcast_name" type="text" data-field="title">
            </div>
            <div class="podcast-metadata-row">
                <label for="podcast_url"><?php echo _("Podcast URL: ") ?></label>
                <a href="" target="_blank" class="podcast-url"></a>
            </div>
            <div class="podcast-metadata-row">
                <label for="podcast_auto_ingest"><?php echo _("Download latest episodes:") ?></label>
                <div>
                    <input name="podcast_auto_ingest" id="podcast_auto_ingest" data-field="auto_ingest" type="checkbox" />
                </div>
            </div>

            <?php /* RASTATIME 2026-05-16 - Auto-Expiry controls.
                   When checkbox is on, episodes downloaded for this podcast
                   get cc_files.expires_at = now() + days at import time.
                   This wins over any ID3 'Expiry' tag the publisher set
                   (precedence decision B, 2026-05-16). */ ?>
            <div class="podcast-metadata-row">
                <label for="podcast_auto_expiry_enabled"><?php echo _("Auto-Expiry:") ?></label>
                <div>
                    <input name="podcast_auto_expiry_enabled" id="podcast_auto_expiry_enabled"
                           data-field="auto_expiry_enabled" type="checkbox" />
                </div>
            </div>
            <div class="podcast-metadata-row auto-expiry-row" style="display:none;">
                <label for="podcast_auto_expiry_days"><?php echo _("Auto-Expiry (days):") ?></label>
                <div>
                    <input name="podcast_auto_expiry_days" id="podcast_auto_expiry_days"
                           data-field="auto_expiry_days" type="number" min="1" max="3650" step="1"
                           style="width: 6em;" />
                    <?php /* RASTATIME 2026-05-21 — help-text moved into a qtip
                           hover tooltip (initialised in podcast.js).  Same
                           pattern as .album_names.help_icon above; keeps the
                           row visually compact while preserving the
                           operator-visible explanation. */ ?>
                    <span class="auto_expiry_help_icon help_icon"
                          aria-describedby="ui-tooltip-podcast-auto-expiry"
                          style="margin-left: 0.5em;"></span>
                </div>
            </div>

            <?php /* RASTATIME 2026-05-17 - Per-podcast default Track-Type.
                   When set, every episode imported from this podcast
                   (manual or auto-ingest) gets cc_files.track_type_id
                   pre-filled with this value at download time.  Empty
                   value = no default (track-type stays at the analyzer
                   inference, which is typically empty for podcasts). */ ?>
            <div class="podcast-metadata-row">
                <label for="podcast_default_track_type"><?php echo _("Track Type:") ?></label>
                <div>
                    <?php // RASTATIME 2026-05-17 — track-type options are
                          // rendered into a JS literal that podcast.js picks up
                          // at init time and appends as <option>s, so we avoid
                          // an extra REST round-trip to /api/v2/libraries. ?>
                    <select name="podcast_default_track_type" id="podcast_default_track_type"
                            data-field="default_track_type_id">
                        <option value="">— <?php echo _("None") ?> —</option>
                    </select>
                </div>
            </div>

            <div class="podcast-metadata-row">
                <label><?php echo _("Scheduling:") ?></label>
                <div>
                    <button data-action="smartblock" class="btn" type="button" name="smartblock">
                        <?php echo _("Generate Smartblock and Playlist") ?>
                    </button>
                    <div class='pc-sb-success success' style='display:none'>&quot;<span class="pc-sb-title"></span>&quot; <br> <?php echo _("Smartblock and Playlist generated") ?></div>
                </div>
            </div>
        </form>
    </div>

    <table class="datatable podcast_episodes" cellpadding="0" cellspacing="0"></table>

    <div class="btn-toolbar clearfix">
        <div class="btn-group pull-right">
            <button data-action="discard" class="btn" type="button" name="cancel">
                <?php echo _("Cancel") ?>
            </button>
        </div>
        <div class='btn-group pull-right'>
            <button data-action="save" class="btn" title='<?php echo _("Save podcast") ?>' type="button">
                <?php echo _("Save") ?>
            </button>
        </div>
        <div class='pc-save-success success' style='display:none'></div>
    </div>
</div>
