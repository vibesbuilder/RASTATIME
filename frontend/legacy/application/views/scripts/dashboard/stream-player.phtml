    <script>
        // RASTATIME 2026-06-01: native <audio> + custom LibreTime-style GUI for
        // the Dashboard live-stream popup.
        var streamAudio = null;
        var currentUrl = "";

        // The stream host may be configured as "localhost", which only resolves
        // on the server itself. For a remote browser, rewrite localhost /
        // 127.0.0.1 to the host the app is served from (window.location), so the
        // stream URL is actually reachable. An explicit host (a domain or a
        // dedicated Icecast box) is left untouched.
        function reachableStreamUrl(url) {
            return url.replace(
                /^(https?:\/\/)(?:localhost|127\.0\.0\.1)\b/i,
                "$1" + window.location.hostname
            );
        }

        function showPlaying(isPlaying) {
            document.getElementById("stream_play").style.display = isPlaying ? "none" : "";
            document.getElementById("stream_pause").style.display = isPlaying ? "" : "none";
        }

        function updateVolume() {
            var v = streamAudio.muted ? 0 : streamAudio.volume;
            document.getElementById("stream_vol_val").style.width = (v * 100) + "%";
            document.getElementById("content").classList[streamAudio.muted ? "add" : "remove"]("lt-muted");
        }

        function ensureAudio() {
            if (streamAudio === null) {
                streamAudio = document.getElementById("stream_audio_el");
                // a live stream that "ends" (e.g. a dropout) should try to
                // resume, mirroring the old jPlayer ended->play behaviour.
                streamAudio.addEventListener("ended", function () {
                    streamAudio.play().catch(function () {});
                });
                streamAudio.addEventListener("play", function () { showPlaying(true); });
                streamAudio.addEventListener("pause", function () { showPlaying(false); });
                streamAudio.addEventListener("volumechange", updateVolume);
            }
            return streamAudio;
        }

        function setStream(rawUrl, serverType) {
            var url = reachableStreamUrl(rawUrl);
            if (serverType == 'shoutcast') {
                url = url + ";stream/1";
            }
            currentUrl = url;
            var a = ensureAudio();
            a.src = url;
            a.load();
            a.play().catch(function () {});
        }

        function playStream() {
            var a = ensureAudio();
            if (!a.getAttribute("src") && currentUrl) {
                // resume after a Stop (which dropped the connection)
                a.src = currentUrl;
                a.load();
            }
            a.play().catch(function () {});
        }

        function stopStream() {
            var a = ensureAudio();
            a.pause();
            a.removeAttribute("src"); // drop the live connection
            a.load();
            showPlaying(false);
        }

        $(document).ready(function () {
            ensureAudio();

            $("#combo-box").change(function () {
                var elem = $("#combo-box option:selected");
                setStream(elem.attr("data-url"), elem.attr("server-type"));
            });

            $("#stream_play").click(function () { playStream(); return false; });
            $("#stream_pause").click(function () { ensureAudio().pause(); return false; });
            $("#stream_stop").click(function () { stopStream(); return false; });
            $("#stream_mute").click(function () {
                var a = ensureAudio();
                a.muted = !a.muted;
                return false;
            });
            $("#stream_vol").click(function (e) {
                var a = ensureAudio();
                var rect = this.getBoundingClientRect();
                var ratio = (e.clientX - rect.left) / rect.width;
                ratio = Math.max(0, Math.min(1, ratio));
                a.muted = false;
                a.volume = ratio;
                return false;
            });

            <?php
            if (count($ids) > 0) {
                $id = $ids[0];
                $streamData = Application_Model_StreamSetting::getStreamData($id);
                $url = $streamData["{$id}_public_url"];
                $serverType = $streamData["{$id}_output"];
                echo "setStream('" . $url . "', '" . $serverType . "');";
            }
            ?>

            updateVolume();

            $("#popup-link").click(function () {
                $("#popup-share").show("slow");
                $("#popup-share-link").val(reachableStreamUrl($("#combo-box option:selected").attr("data-url")));
            });

            $("#popup-close").click(function () {
                $("#popup-share").hide("slow");
            });
        });
    </script>
