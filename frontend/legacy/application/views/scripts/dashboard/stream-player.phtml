<?php /* RASTATIME 2026-05-31 (JS-modernization stage 0, jPlayer part 2/3):
       * native <audio> live-stream player — replaces the jPlayer GUI + jPlayer
       * skin CSS for the Dashboard "Listen" popup. The stream <select> drives a
       * vanilla setStream(); the native controls give play/pause/volume/mute.
       * The old shoutcast ";stream/1" trick and the ended->play reconnect are
       * preserved. */ ?>
<div id="content" class="jp-container">
    <h1><?php echo _("Live stream") ?></h1>
    <a id="popup-link" href="#"><?php echo _("Share") ?></a>
    <?php $ids = Application_Model_StreamSetting::getEnabledStreamIds(); ?>
    <style>
        body { margin: 0; font-family: Arial, Helvetica, sans-serif; }
        #content { padding: 8px; }
        #content h1 { font-size: 14px; margin: 0 0 4px; display: inline-block; }
        #popup-link { font-size: 11px; margin-left: 8px; }
        .jp-logo img { max-height: 40px; }
        .jp-stream { margin: 6px 0; }
        .jp-stream-text { font-size: 11px; margin-bottom: 2px; }
        #combo-box { max-width: 100%; }
        #stream_audio_el { width: 100%; margin-top: 4px; }
        #popup-share { display: none; margin-top: 6px; }
        #popup-share-link { width: 90%; }
    </style>
    <script>
        // RASTATIME 2026-05-31 (JS-modernization stage 0, jPlayer part 2/3):
        // native <audio> replaces jPlayer for the Dashboard live-stream popup.
        var streamAudio = null;

        // The stream host may be configured as "localhost", which only resolves
        // on the server itself. For a remote browser, rewrite localhost /
        // 127.0.0.1 to the host the app is served from (window.location), so the
        // stream URL is actually reachable. An explicit host (a domain or a
        // dedicated Icecast box) is left untouched.
        function reachableStreamUrl(url) {
            return url.replace(
                /^(https?:\/\/)(?:localhost|127\.0\.0\.1)\b/i,
                "$1" + window.location.hostname
            );
        }

        function setStream(url, serverType) {
            url = reachableStreamUrl(url);
            if (serverType == 'shoutcast') {
                url = url + ";stream/1";
            }
            if (streamAudio === null) {
                streamAudio = document.getElementById("stream_audio_el");
                // a live stream that "ends" (e.g. a dropout) should try to
                // resume, mirroring the old jPlayer ended->play behaviour.
                streamAudio.addEventListener("ended", function () {
                    streamAudio.play().catch(function () {});
                });
            }
            streamAudio.src = url;
            streamAudio.load();
            streamAudio.play().catch(function () {});
        }

        $(document).ready(function () {
            $("#combo-box").change(function () {
                var elem = $("#combo-box option:selected");
                setStream(elem.attr("data-url"), elem.attr("server-type"));
            });

            <?php
            if (count($ids) > 0) {
                $id = $ids[0];
                $streamData = Application_Model_StreamSetting::getStreamData($id);
                $url = $streamData["{$id}_public_url"];
                $serverType = $streamData["{$id}_output"];
                echo "setStream('" . $url . "', '" . $serverType . "');";
            }
            ?>

            $("#popup-link").click(function () {
                $("#popup-share").show("slow");
                $("#popup-share-link").val(reachableStreamUrl($("#combo-box option:selected").attr("data-url")));
            });

            $("#popup-close").click(function () {
                $("#popup-share").hide("slow");
            });
        });
    </script>
    <div class="jp-logo"><img id="logo-img" onload='resizeToMaxHeight(this, 40);' src="<?php echo $this->logo ?>" /></div>
    <div id="popup-share">
        <a class="close-round" href="#" id="popup-close"></a>
        <input id="popup-share-link" type="text" readonly="readonly" />
    </div>
    <div class="jp-stream stream-player-label">
        <div class="jp-stream-text"><?php echo _("Select stream:"); ?></div>

        <form id="form1" method="post" action="">
            <select id="combo-box">
                <?php
                foreach ($ids as $id) {
                    $streamData = Application_Model_StreamSetting::getStreamData($id);
                    $url = $streamData["{$id}_public_url"];
                    $serverType = $streamData["{$id}_output"];

                    $label = "(" . $streamData["{$id}_host"] . ") " . $streamData["{$id}_description"] . " - " . $streamData["{$id}_bitrate"] . " kbit/s";
                    echo sprintf("<option class='stream' value='%s' data-url='%s' server-type='%s'>%s</option>", $id, $url, $serverType, $label);
                }
                ?>
            </select>
        </form>
    </div>
    <audio id="stream_audio_el" controls autoplay preload="auto"></audio>
</div>
