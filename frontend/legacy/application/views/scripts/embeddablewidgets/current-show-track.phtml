        </p>

        <?php echo $this->form; ?>
    </fieldset>

    <!-- ───── Embed-code blocks ───── -->
    <h3 style="margin-top: 1.5em;"><?php echo _("Embeddable code"); ?></h3>
    <fieldset class="padded">

