<?php
// RASTATIME 2026-05-22 — Settings page for the Current Show /
// Current Track public embed widgets.  Combines preview + embed-
// code copy + empty-state label customisation into one page so the
// operator can see the effect of label edits immediately in the
// preview iframes.
//
// Page width capped at 800 px to match the Weekly-Schedule page
// (operator request 2026-05-22) — easier to scan and matches the
// rest of the Settings surface visually.

$publicUrl = rtrim($this->publicUrl, '/');
// Preview iframes deliberately force ?theme=dark so the operator
// sees the widget on a dark backdrop that matches the RASTATIME
// admin theme; the actual embed code (further down) doesn't force
// a theme so the public widget still follows the visitor's
// prefers-color-scheme by default.
$showUrl       = $publicUrl . '/embed/now-playing-show';
$trackUrl      = $publicUrl . '/embed/now-playing-track';
$showUrlDark   = $showUrl  . '?theme=dark';
$trackUrlDark  = $trackUrl . '?theme=dark';
?>
<div id="widget-current-show-track"
     class="prefpanel ui-widget simple-formblock clearfix padded-strong"
     style="max-width: 800px;">

    <h2 style="text-align:center"><?php echo _("Current Show / Track Widgets"); ?></h2>
    <div style="clear:both"></div>

    <?php if (!empty($this->saved)): ?>
        <div class="success" style="margin-bottom: 1em; padding: 0.6em 1em;
             background: #2a4a2a; color: #cdc; border-radius: 4px;">
            <?php echo _("Labels saved.  Refresh any open preview to see the new text."); ?>
        </div>
    <?php endif; ?>

    <p style="margin-bottom: 1.5em; color: #666;">
        <?php echo _("Two drop-in iframe widgets for your station's public homepage.  "
            . "Each widget is 300 px wide and shows the current item on line 1 "
            . "plus the next item on line 2.  Both widgets share the labels "
            . "you configure below.");
        ?>
    </p>

