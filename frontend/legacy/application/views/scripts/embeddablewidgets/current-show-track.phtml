                    style="border: 1px solid #444; background: #222;"></iframe>
        </div>
        <div>
            <label style="display: block; margin-bottom: 0.4em;">
                <strong><?php echo _("Current Track widget"); ?></strong>
            </label>
            <iframe src="<?php echo htmlspecialchars($trackUrlDark, ENT_QUOTES, 'UTF-8'); ?>"
