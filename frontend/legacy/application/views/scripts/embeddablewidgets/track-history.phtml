    <!-- Auto-Expiry-style show/hide for the min-seconds input:
         visible only when the exclude-short checkbox is on.  Plain
         JS — the admin runs jQuery but we don't depend on it here. -->
    <script>
    (function () {
        var cb   = document.getElementById('exclude_short_tracks');
        var sec  = document.getElementById('min_seconds');
        if (!cb || !sec) { return; }
        // Zend renders labels as <dt> + inputs as <dd> inside a
        // <dl>, so we hide the whole <dt>/<dd> pair containing
        // the seconds input rather than just the input itself.
        var secRow   = sec.closest('dd');
        var secLabel = secRow ? secRow.previousElementSibling : null;
        function sync() {
            var on = !!cb.checked;
            if (secRow)   { secRow.style.display   = on ? '' : 'none'; }
            if (secLabel) { secLabel.style.display = on ? '' : 'none'; }
        }
        cb.addEventListener('change', sync);
        sync();
    })();
    </script>

