    // RASTATIME 2026-11-14 - field descriptions as help icons (tooltip.js)
    jQuery(function ($) {
        if ($.rtDescriptionTooltips) {
            $.rtDescriptionTooltips('#widget_song_request_form', { where: 'label' });
        }
    });
    </script>

    <!-- ───── Preview (dark backdrop to match the admin theme) ───── -->
    <h3 style="margin-top: 1.5em;"><?php echo _('Preview'); ?></h3>
    <fieldset class="padded">
        <iframe src="<?php echo $e($previewUrl); ?>"
                width="100%" height="420" frameborder="0"
                style="border: 1px solid #444; background: #222; max-width: 560px; display: block;"></iframe>
        <p style="margin-top: 0.6em; color: #666;">
            <?php echo $e(_('The preview is live: a click on "Request" in it files a real request.')); ?>
        </p>
    </fieldset>

    <!-- ───── Embed-code block ───── -->
    <h3 style="margin-top: 1.5em;"><?php echo _('Embeddable code'); ?></h3>
    <fieldset class="padded">
        <label style="display: block; margin-top: 0.8em;"><strong>
            <?php echo _('Song Request widget'); ?>:
        </strong></label>
        <textarea style="width: 98%; font-family: monospace;" rows="3" readonly="readonly"
        ><iframe src="<?php echo $e($embedUrl); ?>" width="100%" height="420" frameborder="0" scrolling="no" style="border: 0; background: transparent;"></iframe>
<script src="<?php echo $e($widgetsJs); ?>" async></script></textarea>

        <p style="margin-top: 0.8em; color: #666;">
            <?php echo $e(_('The script line lets the widget grow and shrink with its content (once per page is enough); without it the iframe keeps the height in the code and the list scrolls inside it.')); ?>
        </p>

        <p style="margin-top: 1em; color: #666;">
            <?php echo _('Optional URL parameter: '); ?>
            <code>theme=auto|dark|light</code>
            <?php echo $e(_('(auto follows the visitor\'s device).')); ?>
            <?php echo _('Example: '); ?>
            <code>...song-request?theme=dark</code>.
            <?php echo $e(_('See the operator manual chapter "Song Requests" for how request shows play the requests.')); ?>
