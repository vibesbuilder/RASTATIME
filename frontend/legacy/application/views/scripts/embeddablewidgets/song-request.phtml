$publicUrl = rtrim($this->publicUrl, '/');
$widgetsJs = $publicUrl . '/embed/widgets.js';
$previewUrl = $publicUrl . '/embed/song-request?theme=dark';
$embedUrl = $publicUrl . '/embed/song-request';
$st = $this->status;
$e = static fn ($s) => htmlspecialchars((string) $s, ENT_QUOTES, 'UTF-8');
$names = static fn (array $rows) => implode(', ', array_map(static fn ($r) => $r['name'], $rows));
$settingsLink = '<a href="' . $e($this->baseUrl('preference')) . '">' . $e(_('Settings → General')) . '</a>';
$poolSet = !empty($st['pool']);
?>
<div id="widget-song-request"
     class="prefpanel ui-widget simple-formblock clearfix padded-strong"
     style="max-width: 800px;">

    <h2 style="text-align:center"><?php echo _('Song Request Widget'); ?></h2>
    <div style="clear:both"></div>

    <?php if (!empty($this->saved)): ?>
        <div class="success" style="margin-bottom: 1em; padding: 0.6em 1em;
             background: #2a4a2a; color: #cdc; border-radius: 4px;">
            <?php echo $e(_('Texts saved.  The preview below shows them.')); ?>
        </div>
    <?php endif; ?>

    <p style="margin-bottom: 1.5em; color: #666;">
        <?php echo $e(_('Drop-in iframe widget for your station\'s public website.  Listeners search the tracks of the song request pool and ask for one with a click; the requested tracks air in your request shows.  The search covers the whole pool, the list without a search shows the first 500 tracks.')); ?>
    </p>

    <!-- ───── Status ───── -->
    <h3 style="margin-top: 1.5em;"><?php echo _('Status'); ?></h3>
    <fieldset class="padded">
        <style>
            .sr-status-table td { padding: 4px 0; vertical-align: top; }
            .sr-status-table td.sr-st-label { padding-right: 12px; font-weight: 600; white-space: nowrap; }
        </style>
        <table class="sr-status-table" style="width: 100%; border-collapse: collapse;">
            <tr>
                <td class="sr-st-label" style="width: 38%;"><?php echo _('Song request pool'); ?></td>
                <td style="padding: 4px 0;">
                    <?php if ($poolSet): ?>
                        <?php echo $e($names($st['pool'])); ?>
                        <span style="color: #888;">(<?php echo $settingsLink; ?>)</span>
                    <?php else: ?>
                        <span style="color: #d9534f;"><?php echo $e(_('Not set - the widget says "Song requests are currently unavailable."')); ?></span>
                        <?php echo sprintf($e(_('Pick the smart blocks under %s.')), $settingsLink); ?>
                    <?php endif; ?>
                </td>
            </tr>
            <tr>
                <td class="sr-st-label"><?php echo _('Tracks listeners can request'); ?></td>
                <td style="padding: 4px 0;"><?php echo $e(number_format($st['requestable'])); ?></td>
            </tr>
            <tr>
                <td class="sr-st-label"><?php echo _('Open requests'); ?></td>
                <td style="padding: 4px 0;">
                    <?php echo $e(sprintf(_('%1$d waiting, %2$d scheduled'), $st['pending'], $st['queued'])); ?>
                    <?php if ($st['last_request']): ?>
                        <span style="color: #888;">- <?php echo $e(sprintf(_('last request %s'), $st['last_request'])); ?></span>
                    <?php endif; ?>
                </td>
            </tr>
            <tr>
                <td class="sr-st-label"><?php echo _('Request shows'); ?></td>
                <td style="padding: 4px 0;">
                    <?php if (!empty($st['request_shows'])): ?>
                        <?php echo $e(implode(', ', $st['request_shows'])); ?>
                    <?php else: ?>
                        <span style="color: #d9534f;"><?php echo $e(_('None - requests are taken but never played.')); ?></span>
                    <?php endif; ?>
                    <div style="color: #888; font-size: 0.9em;">
                        <?php echo $e(_('Shows whose autoloading playlist holds a smart block with "Use requests":')); ?>
                        <?php echo $st['request_blocks'] ? $e($names($st['request_blocks'])) : $e(_('none')); ?>
                    </div>
                </td>
            </tr>
            <tr>
                <td class="sr-st-label"><?php echo _('Covers'); ?></td>
                <td style="padding: 4px 0;">
                    <?php if ($st['covers']): ?>
                        <?php echo $e(_('Shown')); ?>
                    <?php else: ?>
                        <?php echo $e(_('Not shown - "Public RASTATIME API" is off')); ?>
                        <span style="color: #888;">(<?php echo $settingsLink; ?>)</span>
                    <?php endif; ?>
                </td>
            </tr>
        </table>
    </fieldset>

    <!-- ───── Listener texts (RASTATIME 2026-11-14) ───── -->
    <h3 style="margin-top: 1.5em;"><?php echo _('Listener texts'); ?></h3>
    <fieldset class="padded" id="sr-texts">
        <p style="margin-bottom: 1em; color: #666;">
            <?php echo $e(_('Every text the widget shows to listeners.  Leave a field empty to keep the standard text: the greyed text in the field shows it, in the station language (Settings → General → Default Language).  Your own text is shown as typed, whatever the station language.')); ?>
        </p>
        <?php echo $this->form; ?>
    </fieldset>
    <style>
    /* one label column, so the twelve fields line up (longest label + icon ~160 px) */
    #widget_song_request_form dt { width: 170px; white-space: nowrap; }
