<?php
// RASTATIME 2026-05-22 — Settings page for the Next-Shows /
// Latest-Shows public embed widgets.  Same shape as the Current
// Show/Track page: preview iframes (dark backdrop) + label form +
// embed-code block, driven by either the show the operator picks
// from the dropdown or the show name they type into the manual
// input.  Dropdown wins when both are filled (matches the
// ?show_id > ?show precedence the public widget uses).
//
// Page width and styling mirror current-show-track.phtml so the
// Widgets pages feel consistent.

$publicUrl       = rtrim($this->publicUrl, '/');
$widgetsJs       = $publicUrl . '/embed/widgets.js'; // RASTATIME 2026-11-12 - self-sizing widgets
$pickedId        = (int) $this->previewShowId;
$pickedName      = (string) $this->previewShowName;
$hasSelection    = ($pickedId > 0) || ($pickedName !== '');

// Build the show-identifier query-string fragment.  show_id is
// preferred when present (matches the public widget's URL-level
// precedence); otherwise fall back to ?show=Name (URL-encoded so
// names with spaces survive intact).
if ($pickedId > 0) {
    $qsCommon = 'show_id=' . $pickedId;
} elseif ($pickedName !== '') {
    $qsCommon = 'show=' . rawurlencode($pickedName);
} else {
    $qsCommon = '';
}

// Preview iframes force ?theme=dark so the widget renders legibly
// on the admin's dark chrome; the public embed code stays neutral
// so the visitor's OS preference wins by default.
$nextPreviewUrl   = $publicUrl . '/embed/next-shows'   . ($qsCommon ? '?' . $qsCommon . '&theme=dark' : '?theme=dark');
$latestPreviewUrl = $publicUrl . '/embed/latest-shows' . ($qsCommon ? '?' . $qsCommon . '&theme=dark' : '?theme=dark');
$nextEmbedUrl     = $publicUrl . '/embed/next-shows'   . ($qsCommon ? '?' . $qsCommon : '');
$latestEmbedUrl   = $publicUrl . '/embed/latest-shows' . ($qsCommon ? '?' . $qsCommon : '');
?>
<div id="widget-next-latest-shows"
     class="prefpanel ui-widget simple-formblock clearfix padded-strong"
     style="max-width: 800px;">

    <h2 style="text-align:center"><?php echo _("Next / Latest Shows Widgets"); ?></h2>
    <div style="clear:both"></div>

    <?php if (!empty($this->saved)): ?>
        <div class="success" style="margin-bottom: 1em; padding: 0.6em 1em;
             background: #2a4a2a; color: #cdc; border-radius: 4px;">
            <?php echo _("Labels saved.  Refresh any open preview to see the new text."); ?>
        </div>
    <?php endif; ?>

    <p style="margin-bottom: 1.5em; color: #666;">
        <?php echo _("Two drop-in iframe widgets for your station's public homepage.  "
            . "Each widget is 300 px wide and lists the upcoming (or most recent) "
            . "instances of a single recurring show.  Pick a show from the dropdown "
            . "below (one entry per show name — multi-instance names are bundled) "
            . "or type a show name into the manual input to see the preview and "
            . "to get a ready-to-paste embed snippet.");
        ?>
    </p>

    <!-- ───── Show picker + Labels form ───── -->
    <h3 style="margin-top: 1.5em;"><?php echo _("Show & labels"); ?></h3>
    <fieldset class="padded">
        <p style="margin-bottom: 1em; color: #666;">
            <?php echo _("The labels appear in the widget when the picked show "
                . "has no upcoming (resp. no past) instances.  Leave a field "
                . "blank to fall back to the English default shown in the "
                . "placeholder.");
            ?>
            <br><br>
            <?php echo _("<strong>Show selection:</strong> the dropdown takes "
                . "precedence over the manual name field — when both are filled, "
                . "the dropdown wins (matching the <code>?show_id</code> &gt; "
                . "<code>?show</code> rule the public widget URL uses).  "
                . "The manual name field is useful for shows you want to filter "
                . "by string rather than id, or for generating embed snippets "
                . "for shows that aren't (yet) in the dropdown.");
            ?>
        </p>

        <?php echo $this->form; ?>
    </fieldset>
    <script>
    // RASTATIME 2026-11-10 - colour picker + clear button next to the
    // text colour field (empty = the theme colours) and the background
    // colour field (empty = transparent)
    [
        ['widget_shows_text_color', '#ffffff', <?php echo json_encode(_('Theme colors')); ?>],
        ['widget_shows_bg_color', '#000000', <?php echo json_encode(_('Transparent')); ?>]
    ].forEach(function (cfg) {
        var text = document.getElementById(cfg[0]);
        if (!text) { return; }
        var valid = function (v) { return /^#[0-9a-fA-F]{6}$/.test(v); };
        var picker = document.createElement('input');
        picker.type = 'color';
        picker.className = 'rt-accent-picker';
        picker.value = valid(text.value) ? text.value.toLowerCase() : cfg[1];
        picker.style.marginLeft = '0.5em';
        picker.addEventListener('input', function () { text.value = picker.value; });
        text.addEventListener('input', function () {
            var v = text.value.trim();
            if (valid(v)) { picker.value = v.toLowerCase(); }
        });
        var clear = document.createElement('button');
        clear.type = 'button';
        clear.className = 'btn';
        clear.style.marginLeft = '0.5em';
        clear.textContent = cfg[2];
        clear.addEventListener('click', function () { text.value = ''; });
        text.parentNode.insertBefore(clear, text.nextSibling);
        text.parentNode.insertBefore(picker, text.nextSibling);
    });
    </script>

    <!-- ───── Preview (dark backdrop to match the admin theme) ───── -->
    <h3 style="margin-top: 1.5em;"><?php echo _("Preview"); ?></h3>
    <?php if (!$hasSelection): ?>
        <p style="color: #999; font-style: italic;">
            <?php echo _("Pick a show above (or type a name) and click Save "
                . "to see the preview and the ready-to-paste embed snippets."); ?>
        </p>
    <?php else: ?>
        <fieldset class="padded" style="display: flex; gap: 2em; flex-wrap: wrap;">
            <div>
                <label style="display: block; margin-bottom: 0.4em;">
                    <strong><?php echo _("Next Shows widget"); ?></strong>
                </label>
                <iframe src="<?php echo htmlspecialchars($nextPreviewUrl, ENT_QUOTES, 'UTF-8'); ?>"
                        width="300" height="140" frameborder="0" scrolling="no"
                        style="border: 1px solid #444; background: #222;"></iframe>
            </div>
            <div>
                <label style="display: block; margin-bottom: 0.4em;">
                    <strong><?php echo _("Latest Shows widget"); ?></strong>
                </label>
                <iframe src="<?php echo htmlspecialchars($latestPreviewUrl, ENT_QUOTES, 'UTF-8'); ?>"
                        width="300" height="120" frameborder="0" scrolling="no"
                        style="border: 1px solid #444; background: #222;"></iframe>
            </div>
        </fieldset>
    <?php endif; ?>

    <!-- ───── Embed-code blocks ───── -->
    <h3 style="margin-top: 1.5em;"><?php echo _("Embeddable code"); ?></h3>
    <?php if (!$hasSelection): ?>
        <p style="color: #999; font-style: italic;">
            <?php echo _("Pick a show first to generate the embed code with "
                . "the show identifier baked into the URL."); ?>
        </p>
    <?php else: ?>
        <fieldset class="padded">

            <label style="display: block; margin-top: 0.8em;"><strong>
                <?php echo _("Next Shows widget"); ?>:
            </strong></label>
            <textarea style="width: 98%; font-family: monospace;" rows="3" readonly="readonly"
            ><iframe src="<?php echo htmlspecialchars($nextEmbedUrl, ENT_QUOTES, 'UTF-8'); ?>" width="100%" height="140" frameborder="0" scrolling="no" style="border: 0; background: transparent; max-width: 300px;"></iframe>
<script src="<?php echo htmlspecialchars($widgetsJs, ENT_QUOTES, 'UTF-8'); ?>" async></script></textarea>

            <label style="display: block; margin-top: 0.8em;"><strong>
                <?php echo _("Latest Shows widget"); ?>:
            </strong></label>
            <textarea style="width: 98%; font-family: monospace;" rows="3" readonly="readonly"
            ><iframe src="<?php echo htmlspecialchars($latestEmbedUrl, ENT_QUOTES, 'UTF-8'); ?>" width="100%" height="120" frameborder="0" scrolling="no" style="border: 0; background: transparent; max-width: 300px;"></iframe>
<script src="<?php echo htmlspecialchars($widgetsJs, ENT_QUOTES, 'UTF-8'); ?>" async></script></textarea>

            <p style="margin-top: 0.8em; color: #666;">
                <?php /* RASTATIME 2026-11-12 - self-sizing widgets */ echo _("The script line lets the widget grow and shrink with its content (once per page is enough); without it the iframe keeps the height in the code."); ?>
            </p>

            <p style="margin-top: 1em; color: #666;">
                <?php echo _("Copy the snippet above and paste it into your "
                    . "website's HTML to embed the widget.  Optional URL "
                    . "parameters (the first one starts with <code>?</code>, "
                    . "every additional one is joined with <code>&amp;</code>): "); ?>
                <code>show_id=N</code>,
                <code>show=Name</code>,
                <code>limit=1..20</code>,
                <code>theme=auto|dark|light</code>,
                <code>cache=10..3600</code>,
                <code>overflow=ellipsis|marquee</code>,
                <code>title=0|1</code>,
                <code>size=10..32</code>,
                <code>bold=0|1</code>,
                <code>font=system|archivo|arial|verdana|georgia|serif|mono</code>,
                <code>color=rrggbb</code>,
                <code>bgcolor=rrggbb</code>,
                <code>timezone=Europe/Berlin</code>.
                <?php echo _("Example: "); ?>
                <code>...?show=BBC%20News&amp;theme=dark&amp;limit=8</code>.
                <?php echo _("See the operator manual chapter "
                    . "\"Public Embed Widgets\" for the full reference.");
                ?>
            </p>
        </fieldset>
    <?php endif; ?>

</div>

<?php /* RASTATIME 2026-11-12 - the previews grow with their content, as on the website */ ?>
<script src="<?php echo htmlspecialchars($widgetsJs, ENT_QUOTES, 'UTF-8'); ?>" async></script>
