<?php
// RASTATIME 2026-11-03 - archiving: the producers (one person or a team;
// "Editorial Teams" until 2026-11-04, the table stays cc_editor_profile and
// cba.media calls them editors), first section of Settings → Archiving
// (settings.phtml).  A show chooses one producer (Edit Show -> Archiving).
// A producer needs no login; linking a user is optional.
$h = fn ($v) => htmlspecialchars((string) $v, ENT_QUOTES, 'UTF-8');
$form = $this->teamForm;
$e = $form['edit'];
?>
<div class="ui-widget prefpanel clearfix padded-strong rt-editors" id="producers">
    <h2><?php echo _("Producers"); ?></h2>
    <p class="rt-editors-note">
        <?php echo _("Who makes the shows - one person or a team each. Each show chooses its producer under Edit Show → Archiving; the name is sent to cba.media as editor and appears in Analytics → Participants. A producer needs no login."); ?>
    </p>
    <?php if (!$this->ready): ?>
        <p class="rt-editors-error"><?php echo _("The archiving tables are missing - run the database migrations 0074 and 0075 first."); ?></p>
    <?php else: ?>
        <?php if ($form['message']): ?><p class="rt-editors-ok"><?php echo $h($form['message']); ?></p><?php endif; ?>
        <?php if ($form['error']): ?><p class="rt-editors-error"><?php echo $h($form['error']); ?></p><?php endif; ?>

        <form method="post" action="<?php echo $h(Config::getBasePath() . 'archiving/editors'); ?>" class="rt-editors-form" id="rt_editor_form">
            <input type="hidden" name="csrf" value="<?php echo $h($this->csrf); ?>" />
            <input type="hidden" name="id" id="rt_editor_id" value="<?php echo (int) $e['id']; ?>" />
            <h3 id="rt_editor_heading"><?php echo $e['id'] ? _("Edit producer") : _("Add a producer"); ?></h3>
            <div class="rt-editors-row">
                <label for="rt_editor_name"><?php echo _("Name"); ?></label>
                <input type="text" name="name" id="rt_editor_name" class="input_text" maxlength="255" required value="<?php echo $h($e['name']); ?>" />
            </div>
            <div class="rt-editors-row">
                <label for="rt_editor_email"><?php echo _("Email (optional)"); ?></label>
                <input type="email" name="email" id="rt_editor_email" class="input_text" maxlength="255" value="<?php echo $h($e['email']); ?>" />
            </div>
            <div class="rt-editors-row">
                <label for="rt_editor_user"><?php echo _("User (optional)"); ?></label>
                <select name="subjs_id" id="rt_editor_user" class="input_select">
                    <option value="0"><?php echo _("- no login -"); ?></option>
                    <?php foreach ($this->users as $u): ?>
                        <option value="<?php echo (int) $u['id']; ?>"<?php echo (int) $u['id'] === (int) $e['subjs_id'] ? ' selected' : ''; ?>>
                            <?php echo $h($u['login'] . ($u['full_name'] !== '' ? ' (' . $u['full_name'] . ')' : '')); ?>
                        </option>
                    <?php endforeach; ?>
                </select>
            </div>
            <div class="rt-editors-row rt-editors-check">
                <label><input type="checkbox" name="active" id="rt_editor_active" value="1"<?php echo $e['active'] ? ' checked' : ''; ?> />
                    <?php echo _("Active (offered in the show form)"); ?></label>
            </div>
            <div class="rt-editors-row">
                <button type="submit" class="btn btn-new"><?php echo _("Save"); ?></button>
                <button type="button" class="btn" id="rt_editor_new"<?php echo $e['id'] ? '' : ' style="display:none"'; ?>><?php echo _("New producer"); ?></button>
            </div>
        </form>

        <?php if (empty($this->profiles)): ?>
            <p class="rt-editors-empty"><?php echo _("No producer yet."); ?></p>
        <?php else: ?>
            <table class="datatable rt-editors-table">
                <thead>
                    <tr>
                        <th><?php echo _("Name"); ?></th>
                        <th><?php echo _("Email"); ?></th>
                        <th><?php echo _("User"); ?></th>
                        <th><?php echo _("Shows"); ?></th>
                        <th><?php echo _("Active"); ?></th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    <?php foreach ($this->profiles as $i => $p): ?>
                        <tr class="<?php echo $i & 1 ? 'even' : 'odd'; ?><?php echo $p['active'] ? '' : ' rt-editors-inactive'; ?>"
                            data-id="<?php echo (int) $p['id']; ?>" data-name="<?php echo $h($p['name']); ?>"
                            data-email="<?php echo $h($p['email']); ?>" data-user="<?php echo (int) $p['subjs_id']; ?>"
                            data-active="<?php echo $p['active'] ? '1' : '0'; ?>">
                            <td><?php echo $h($p['name']); ?></td>
                            <td><?php echo $h($p['email']); ?></td>
                            <td><?php echo $h($p['login']); ?></td>
                            <td><?php echo (int) $p['shows']; ?></td>
                            <td><?php echo $p['active'] ? _("yes") : _("no"); ?></td>
                            <td class="rt-editors-actions">
                                <a href="#" class="rt-editor-edit"><?php echo _("Edit"); ?></a>
                                <form method="post" action="<?php echo $h(Config::getBasePath() . 'archiving/editors'); ?>" class="rt-editor-delete-form">
                                    <input type="hidden" name="csrf" value="<?php echo $h($this->csrf); ?>" />
                                    <input type="hidden" name="op" value="delete" />
                                    <input type="hidden" name="id" value="<?php echo (int) $p['id']; ?>" />
                                    <a href="#" class="rt-editor-delete"><?php echo _("Delete"); ?></a>
                                </form>
                            </td>
                        </tr>
                    <?php endforeach; ?>
                </tbody>
            </table>
        <?php endif; ?>
    <?php endif; ?>
</div>
<script>
(function ($) {
  var addTitle = <?php echo json_encode(_("Add a producer")); ?>, editTitle = <?php echo json_encode(_("Edit producer")); ?>;
  var confirmText = <?php echo json_encode(_("Delete \"%s\"? The producer is removed from every show.")); ?>;
  function fill(id, name, email, user, active) {
    $("#rt_editor_id").val(id);
    $("#rt_editor_name").val(name);
    $("#rt_editor_email").val(email);
    $("#rt_editor_user").val(String(user));
    $("#rt_editor_active").prop("checked", active);
    $("#rt_editor_heading").text(id ? editTitle : addTitle);
    $("#rt_editor_new").toggle(!!id);
  }
  $(".rt-editor-edit").on("click", function (ev) {
    ev.preventDefault();
    var $tr = $(this).closest("tr");
    fill($tr.data("id"), $tr.data("name"), $tr.data("email") || "", $tr.data("user") || 0, $tr.data("active") == 1);
    $("#rt_editor_name").focus();
  });
  $("#rt_editor_new").on("click", function () {
    fill(0, "", "", 0, true);
    $("#rt_editor_name").focus();
  });
  $(".rt-editor-delete").on("click", function (ev) {
    ev.preventDefault();
    var name = $(this).closest("tr").data("name");
    if (confirm(confirmText.replace("%s", name))) {
      $(this).closest("form").trigger("submit");
    }
  });
})(jQuery);
</script>
