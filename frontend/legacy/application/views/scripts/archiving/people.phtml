<?php
// RASTATIME 2026-11-24 - Analytics → People Involved → Host Names (operator
// Go option B, §23.133): the register of host names (cc_person) that Edit
// Show → What → "Host names" suggests from.  One name = one person; a
// person in several shows counts once in People Involved.  Rename (in every
// show), merge two spellings of the same person, delete (from every show;
// a show left without names gets no "Hosts involved" value).
$h = fn ($v) => htmlspecialchars((string) $v, ENT_QUOTES, 'UTF-8');
$base = Config::getBasePath();
$e = $this->edit;
?>
<div class="ui-widget prefpanel clearfix padded-strong rt-participants rt-people">
    <h2><?php echo _("Host Names"); ?></h2>
    <p class="rt-participants-note">
        <?php echo _("Every host name used in a show (Edit Show → What → \"Host names\"). One name stands for one person: a person who hosts several shows counts once in People Involved. Two spellings of the same person are merged here; two different people with the same name are told apart in the name, e.g. with a letter in brackets."); ?>
        <a href="<?php echo $h($base . 'archiving/participants'); ?>"><?php echo _("Back to People Involved"); ?></a>
    </p>
    <?php if (!$this->ready): ?>
        <p class="rt-participants-warn"><?php echo _("The table of host names is missing - run the database migration 0089 first."); ?></p>
    <?php else: ?>
        <?php if ($this->message): ?><p class="rt-editors-ok"><?php echo $h($this->message); ?></p><?php endif; ?>
        <?php if ($this->error): ?><p class="rt-editors-error"><?php echo $h($this->error); ?></p><?php endif; ?>

        <?php if (empty($this->people)): ?>
            <p class="rt-participants-empty"><?php echo _("No host names yet. They are added in Edit Show → What → \"Host names\"."); ?></p>
        <?php else: ?>
            <form method="post" action="<?php echo $h($base . 'archiving/people-op'); ?>" class="rt-editors-form rt-people-form" id="rt_people_form"<?php echo $e['id'] ? '' : ' style="display:none"'; ?>>
                <input type="hidden" name="csrf" value="<?php echo $h($this->csrf); ?>" />
                <input type="hidden" name="id" id="rt_people_id" value="<?php echo (int) $e['id']; ?>" />
                <input type="hidden" name="op" id="rt_people_op" value="rename" />
                <h3><?php echo _("Edit name"); ?></h3>
                <div class="rt-editors-row">
                    <label for="rt_people_name"><?php echo _("Name"); ?></label>
                    <input type="text" name="name" id="rt_people_name" class="input_text" maxlength="128" value="<?php echo $h($e['name']); ?>" />
                </div>
                <div class="rt-editors-row">
                    <button type="submit" class="btn" data-op="rename"><?php echo _("Save"); ?></button>
                    <button type="button" class="btn" id="rt_people_cancel"><?php echo _("Cancel"); ?></button>
                </div>
                <div class="rt-editors-row">
                    <label for="rt_people_into"><?php echo _("Same person as"); ?></label>
                    <select name="into" id="rt_people_into" class="input_select">
                        <option value=""></option>
                        <?php foreach ($this->people as $p): ?>
                            <option value="<?php echo (int) $p['id']; ?>"><?php echo $h($p['name']); ?></option>
                        <?php endforeach; ?>
                    </select>
                </div>
                <div class="rt-editors-row">
                    <button type="submit" class="btn" data-op="merge"><?php echo _("Merge"); ?></button>
                    <button type="submit" class="btn" data-op="delete"><?php echo _("Delete"); ?></button>
                </div>
            </form>

            <table class="datatable rt-participants-table rt-people-table">
                <thead>
                    <tr>
                        <th><?php echo _("Name"); ?></th>
                        <th class="num"><?php echo _("Shows"); ?></th>
                        <th><?php echo _("Show name"); ?></th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    <?php $i = 0; foreach ($this->people as $p): ?>
                        <tr class="<?php echo $i++ & 1 ? 'even' : 'odd'; ?>">
                            <td><?php echo $h($p['name']); ?></td>
                            <td class="num<?php echo $p['shows'] ? '' : ' rt-participants-missing'; ?>"><?php echo (int) $p['shows']; ?></td>
                            <td><?php echo $h($p['show_names']); ?></td>
                            <td class="rt-editors-actions"><a href="#" class="rt-people-edit" data-id="<?php echo (int) $p['id']; ?>" data-name="<?php echo $h($p['name']); ?>"><?php echo _("Edit"); ?></a></td>
                        </tr>
                    <?php endforeach; ?>
                </tbody>
            </table>
        <?php endif; ?>
    <?php endif; ?>
</div>
<script>
(function ($) {
  var $form = $("#rt_people_form");
  var mergeText = <?php echo json_encode(_('Merge "%1$s" into "%2$s"? Its shows get "%2$s" instead.'), JSON_UNESCAPED_UNICODE); ?>;
  var deleteText = <?php echo json_encode(_('Delete "%s"? The name is removed from every show.'), JSON_UNESCAPED_UNICODE); ?>;
  var pickText = <?php echo json_encode(_('Please choose the person to merge into.'), JSON_UNESCAPED_UNICODE); ?>;
  var op = "rename";
  function syncInto() {
    var id = String($("#rt_people_id").val());
    $("#rt_people_into option").each(function () {
      $(this).prop("disabled", $(this).val() === id);
    });
  }
  syncInto();
  $(".rt-people-edit").on("click", function (ev) {
    ev.preventDefault();
    $("#rt_people_id").val($(this).data("id"));
    $("#rt_people_name").val($(this).data("name"));
    $("#rt_people_into").val("");
    syncInto();
    $form.show();
    $("html, body").scrollTop($form.offset().top - 80);
    $("#rt_people_name").trigger("focus");
  });
  $("#rt_people_cancel").on("click", function () {
    $form.hide();
  });
  $form.find("button[data-op]").on("click", function () {
    op = $(this).data("op");
  });
  $form.on("submit", function (ev) {
    var name = $.trim($("#rt_people_name").val());
    var original = $(".rt-people-edit[data-id='" + $("#rt_people_id").val() + "']").data("name") || name;
    if (op === "merge") {
      var into = $("#rt_people_into option:selected");
      if (!into.val()) {
        alert(pickText);
        ev.preventDefault();
        return;
      }
      if (!confirm(mergeText.replace(/%1\$s/g, original).replace(/%2\$s/g, into.text()))) {
        ev.preventDefault();
        return;
      }
    }
    if (op === "delete" && !confirm(deleteText.replace("%s", original))) {
      ev.preventDefault();
      return;
    }
    $("#rt_people_op").val(op);
  });
})(jQuery);
</script>
