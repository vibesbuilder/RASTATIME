<?php
// RASTATIME 2026-11-03 - archiving stage 1: Analytics → People Involved
// (menu entry since 2026-11-04, before: part of the Yearly Report).
// People involved per own production for one year (station time):
// episodes that aired (ended, not deleted, no legacy rebroadcast), the
// show's value, how many episodes have their own value, and the sum over
// the episodes.  Only shows with "Own production" count (operator
// 2026-11-04; all shows while migration 0077 is missing).
$h = fn ($v) => htmlspecialchars((string) $v, ENT_QUOTES, 'UTF-8');
$base = Config::getBasePath();
$r = $this->report;
$t = $r['totals'];
$rows = $this->missingOnly ? array_filter($r['rows'], fn ($x) => $x['participants'] === null) : $r['rows'];
?>
<div class="ui-widget prefpanel clearfix padded-strong rt-participants">
    <h2><?php echo _("People Involved"); ?></h2>
    <p class="rt-participants-note">
        <?php echo _("People involved in the station's own productions, for the yearly statistics. The number is set per show (Edit Show → What → \"Own production\" → \"Number of involved people\") and can differ for a single episode (Archive Online in the calendar). Only shows with \"Own production\" count; counted are episodes that aired, legacy rebroadcasts are left out."); ?>
    </p>
    <?php if (!$this->ready): ?>
        <p class="rt-participants-warn"><?php echo _("The archiving tables are missing - run the database migrations 0074 and 0075 first."); ?></p>
    <?php endif; ?>
    <form method="get" action="<?php echo $h($base . 'archiving/participants'); ?>" class="rt-participants-filter">
        <label for="rt_participants_year"><?php echo _("Year"); ?></label>
        <select name="year" id="rt_participants_year" class="input_select" onchange="this.form.submit()">
            <?php foreach ($this->years as $y): ?>
                <option value="<?php echo (int) $y; ?>"<?php echo $y === $r['year'] ? ' selected' : ''; ?>><?php echo (int) $y; ?></option>
            <?php endforeach; ?>
        </select>
        <label class="rt-participants-check"><input type="checkbox" name="missing" value="1"<?php echo $this->missingOnly ? ' checked' : ''; ?> onchange="this.form.submit()" />
            <?php echo _("Only shows without a value"); ?></label>
        <a class="btn" href="<?php echo $h($base . 'archiving/participants-csv?year=' . (int) $r['year']); ?>"><?php echo _("Download CSV"); ?></a>
    </form>
    <?php if ($this->isCurrentYear): ?>
        <p class="rt-participants-note"><?php echo sprintf(_("%d so far (up to %s)."), (int) $r['year'], $h($this->today)); ?></p>
    <?php endif; ?>

    <div class="rt-participants-totals">
        <div><strong><?php echo (int) $t['shows']; ?></strong><span><?php echo _("Own productions aired"); ?></span></div>
        <div><strong><?php echo (int) $t['episodes']; ?></strong><span><?php echo _("Episodes aired"); ?></span></div>
        <div><strong><?php echo (int) $t['participants']; ?></strong><span><?php echo _("People involved (sum over the shows)"); ?></span></div>
        <div><strong><?php echo (int) $t['person_episodes']; ?></strong><span><?php echo _("Participations"); ?></span></div>
        <div class="<?php echo $t['missing'] ? 'rt-participants-missing' : ''; ?>"><strong><?php echo (int) $t['missing']; ?></strong><span><?php echo _("Shows without a value"); ?></span></div>
    </div>
    <p class="rt-participants-note">
        <?php echo _("A person in several shows counts once per show in \"People involved\". Participations add up the people of every episode."); ?>
    </p>

    <?php if (empty($rows)): ?>
        <p class="rt-participants-empty"><?php echo $this->missingOnly ? _("Every show of this year has a value.") : _("No show aired in this year."); ?></p>
    <?php else: ?>
        <table class="datatable rt-participants-table">
            <thead>
                <tr>
                    <th><?php echo _("Show name"); ?></th>
                    <th class="num"><?php echo _("Episodes aired"); ?></th>
                    <th class="num"><?php echo _("People involved"); ?></th>
                    <th class="num"><?php echo _("Episodes with own value"); ?></th>
                    <th class="num"><?php echo _("Participations"); ?></th>
                    <th><?php echo _("Producer"); ?></th>
                </tr>
            </thead>
            <tbody>
                <?php $i = 0; foreach ($rows as $row): ?>
                    <tr class="<?php echo $i++ & 1 ? 'even' : 'odd'; ?>">
                        <td><?php echo $h($row['name']); ?><?php if ($row['is_repeat']): ?> <span class="rt-participants-tag"><?php echo _("Repeat"); ?></span><?php endif; ?></td>
                        <td class="num"><?php echo (int) $row['episodes']; ?></td>
                        <td class="num<?php echo $row['participants'] === null ? ' rt-participants-missing' : ''; ?>"><?php echo $row['participants'] === null ? '&ndash;' : (int) $row['participants']; ?></td>
                        <td class="num"><?php echo $row['overrides'] ?: ''; ?></td>
                        <td class="num"><?php echo $row['person_episodes'] === null ? '&ndash;' : (int) $row['person_episodes']; ?></td>
                        <td><?php echo $h($row['team']); ?></td>
                    </tr>
                <?php endforeach; ?>
            </tbody>
        </table>
    <?php endif; ?>
</div>
