<script>
(function ($) {
    // a channel's fields only while its switch is on (or while one of them was refused)
    function syncChannels() {
        $(".rt-alerts-channel").each(function () {
            $(this).toggle($("#" + $(this).data("switch")).prop("checked") || $(this).find(".rt-alerts-error").length > 0);
        });
    }
    $(".rt-alerts-switch").on("change", syncChannels);
    syncChannels();

    $(".rt-alerts-test").on("click", function () {
        var channel = $(this).data("channel");
        var $msg = $(".rt-alerts-test-msg[data-channel='" + channel + "']");
        $msg.text("…").removeClass("rt-alerts-error rt-alerts-ok");
        $.post(<?php echo json_encode($base . 'alerts/test'); ?>, {
            channel: channel,
            csrf_token: <?php echo json_encode($this->csrf); ?>,
            format: "json"
        }, function (resp) {
            if (resp && resp.ok) {
                $msg.text(<?php echo json_encode(_("Sent.")); ?>).addClass("rt-alerts-ok");
            } else {
                $msg.text((resp && resp.error) || <?php echo json_encode(_("Failed.")); ?>).addClass("rt-alerts-error");
            }
        }, "json").fail(function () {
            $msg.text(<?php echo json_encode(_("Request failed.")); ?>).addClass("rt-alerts-error");
        });
    });
})(jQuery);
</script>
