<icecast>
    <!-- IMPORTANT!
         Especially for inexperienced users:
         Start out by ONLY changing all passwords and restarting Icecast.
         For detailed setup instructions please refer to the documentation.
         It's also available here: http://icecast.org/docs/
    -->

    <!-- location and admin are two strings that are e.g. visible
         on the server info page of the icecast web interface -->
    <location>Earth</location>
    <!-- If you are listing streams on a YP, this MUST be a working email! -->
    <admin>icemaster@localhost</admin>
    <!-- This is the hostname other people will use to connect to your server.
         It affects mainly the urls generated by Icecast for playlists and YP
         listings. You MUST configure it properly for YP listings to work!
         This is NOT your homepage address, it's the hostname for THIS server.
    -->
    <hostname>192.168.1.64</hostname>

    <limits>
        <!-- Global maximum number of clients.
             This includes all kinds of clients, not only listeners.
        -->
        <clients>100</clients>
        <sources>8</sources>
        <queue-size>524288</queue-size>
        <client-timeout>30</client-timeout>
        <header-timeout>15</header-timeout>
        <source-timeout>10</source-timeout>
        <!-- This sets the burst size in [bytes]. This is the amount the
             the server sends to a listener that connects to a stream.
             This allows for a significantly reducing in startup time.
             Most people won't need to change from the default 64k.
             Applies to all mountpoints.
        -->
        <burst-size>65535</burst-size>
    </limits>

    <authentication>
        <!-- Sources log in with username 'source' -->
        <source-password>CHANGEME</source-password>
        <!-- Relays log in with username 'relay' -->
        <relay-password>CHANGEME</relay-password>

        <!-- Admin logs in with the username given below -->
        <admin-user>admin</admin-user>
        <admin-password>CHANGEME</admin-password>
    </authentication>

    <!-- set the mountpoint for a shoutcast source to use, the default if not
         specified is to have none.
    <shoutcast-mount>/live.nsv</shoutcast-mount>
    -->

    <!-- Uncommenting this enables publishing to the streaming directory at:
         https://dir.xiph.org/
         Please read the Icecast documentation about publishing to directories
         very carefully, as it is not enough to just uncomment this.
    -->
    <!--
    <yp-directory url="https://dir.xiph.org/cgi-bin/yp-cgi">
        <option name="timeout" value="15" />
    </yp-directory>
    -->

    <!-- You may have multiple <listen-socket> elements -->
    <listen-socket>
        <port>8000</port>
        <!-- <bind-address>127.0.0.1</bind-address> -->
        <!-- <shoutcast-mount>/stream</shoutcast-mount> -->
    </listen-socket>
    <!--
    <listen-socket>
        <port>8080</port>
    </listen-socket>
    -->
    <!--
    <listen-socket>
        <port>8443</port>
        <tls>auto_no_plain</tls>
    </listen-socket>
    -->


    <!-- Global header settings
         Headers defined here will be returned for every HTTP request to Icecast.

         The ACAO header makes Icecast public content/API by default
         This will make streams easier embeddable (some HTML5 functionality needs it).
         Also it allows direct access to e.g. /status-json.xsl from other sites.
         If you don't want this, comment out the following line or read up on CORS.
    -->
    <http-headers>
        <header type="cors" name="Access-Control-Allow-Origin" />
        <header type="cors" name="Access-Control-Allow-Headers" />
        <header type="cors" name="Access-Control-Expose-Headers" />
    </http-headers>


    <!-- Relaying
         You don't need this if you only have one server.
         Please refer to the documentation for a detailed explanation.
    -->
    <!--
    <master-server>127.0.0.1</master-server>
    <master-server-port>8001</master-server-port>
    <master-update-interval>120</master-update-interval>
    <master-password>CHANGEME</master-password>
    -->

    <!-- Setting this makes all relays on-demand unless overridden, this is
         useful for master relays which do not have <relay> definitions here.
         The default is false -->
    <!--<relays-on-demand>true</relays-on-demand>-->

    <!-- Basic relay with one upstream server -->
    <!--
    <relay>
        <local-mount>/different.ogg</local-mount>
        <on-demand>false</on-demand>

        <upstream type="normal">
            <uri>http://localhost:8080/example.ogg</uri>
            <relay-shoutcast-metadata>false</relay-shoutcast-metadata>
        </upstream>
    </relay>
    -->

    <!-- Relay with multiple upstream servers and default settings -->
    <!--
    <relay>
        <local-mount>/different.ogg</local-mount>
        <on-demand>false</on-demand>

        <upstream type="normal">
            <server>master0.example.org</server>
        </upstream>
        <upstream type="normal">
            <server>master1.example.org</server>
        </upstream>
        <upstream type="normal">
            <server>master2.example.org</server>
            <port>8080</port>
        </upstream>
        <upstream type="default">
            <port>8000</port>
            <mount>/example.ogg</mount>
        </upstream>
    </relay>
    -->

    <!-- Mountpoints
         Only define <mount> sections if you want to use advanced options,
         like alternative usernames or passwords
         All <mount> sections below are disabled by default,
         to activate them remove the comment markers around them and reload.
    -->

    <!-- Default settings for all mounts that don't have a specific <mount type="normal">.
    -->
    <!--
    <mount type="default">
        <public>false</public>
        <intro>/server-wide-intro.ogg</intro>
        <max-listener-duration>3600</max-listener-duration>
        <authentication>
        </authentication>
        <http-headers>
                <header name="foo" value="bar" />
        </http-headers>
    </mount>
    -->

    <!-- ====================================================================
         RASTATIME 2026-09-09: public output mounts with a standby fallback.

         RASTATIME-LIQUIDSOAP is restarted on purpose now and then (planned
         restart at a track boundary, nightly window, memory limit).  Its
         Icecast sources drop for 1-2 s; without a fallback Icecast would
         disconnect every listener.  RASTATIME-STANDBY (a second, tiny
         Liquidsoap rendered by PLAYOUT as standby.liq) streams silence to
         /<mount>-standby with the same encoders, and these blocks move the
         listeners there and back (<fallback-override>) so nobody is
         disconnected.  Mount names must match the stream outputs in
         Settings -> Streams plus the "-standby" suffix.
         ==================================================================== -->
    <mount type="normal">
        <mount-name>/rastatime</mount-name>
        <fallback-mount>/rastatime-standby</fallback-mount>
        <fallback-override>1</fallback-override>
        <fallback-when-full>1</fallback-when-full>
    </mount>
    <mount type="normal">
        <mount-name>/rastatime-aac</mount-name>
        <fallback-mount>/rastatime-aac-standby</fallback-mount>
        <fallback-override>1</fallback-override>
        <fallback-when-full>1</fallback-when-full>
    </mount>
    <mount type="normal">
        <mount-name>/rastatime-ogg</mount-name>
        <fallback-mount>/rastatime-ogg-standby</fallback-mount>
        <fallback-override>1</fallback-override>
        <fallback-when-full>1</fallback-when-full>
    </mount>
    <mount type="normal">
        <mount-name>/rastatime-standby</mount-name>
        <hidden>1</hidden>
        <public>0</public>
    </mount>
    <mount type="normal">
        <mount-name>/rastatime-aac-standby</mount-name>
        <hidden>1</hidden>
        <public>0</public>
    </mount>
    <mount type="normal">
        <mount-name>/rastatime-ogg-standby</mount-name>
        <hidden>1</hidden>
        <public>0</public>
    </mount>

    <!-- ====================================================================
         RASTATIME: Live Broadcasting input mounts.

         /main  - "Master Source" — overrides any scheduled playout.
                  Authenticated against live_stream_master_username /
                  live_stream_master_password in cc_pref.

         /show  - "Show Source" — only authenticated for hosts of the
                  currently scheduled show (Airtime auth) or the show's
                  custom credentials.

         Both mounts use Icecast 2.5 URL-auth so credentials are checked
         against the RASTATIME PHP API at request time, and event-bindings
         so the API gets notified the moment a DJ connects or disconnects.
         The notify URL flips master_dj_switch / live_dj_switch in cc_pref;
         RASTATIME-PLAYOUT will eventually consume that to mux Master >
         Show > Scheduled.

         The mounts are hidden from the public listing — they are inputs,
         not outputs.  Outgoing /rastatime192 et al. continue to be
         pushed by RASTATIME-PLAYOUT via FFmpeg.
         ==================================================================== -->
    <mount type="normal">
        <mount-name>/main</mount-name>
        <hidden>1</hidden>
        <public>0</public>

        <!-- ===================================================================
             RASTATIME 2026-05-13 — Icecast 2.4.4 syntax.

             Source-side auth (BUTT and friends pushing to /main):
               Icecast 2.4 has NO URL-based source-auth (that was new in 2.5
               and didn't work reliably with our PHP API anyway).  Source
               auth runs against the mount-specific <password> element below.
               The username on the source-client side stays "source" (the
               Icecast default); only the password is mount-specific.

               IMPORTANT: this static password is the one the operator must
               configure in BUTT (or any other source client) on the
               broadcaster's machine to take over as Master.  We chose a
               human-friendly literal here for the test setup; rotate it
               for production by editing this file + the matching cc_pref
               entry (live_stream_master_password) so the Frontend UI shows
               the same value.

             Listener auth (mpv / FFmpeg-streamer / public clients reading
             /main as a listener):
               Stays URL-based against the PHP icecast-listener-allow
               endpoint, which compares against
               stream.internal_listener.* in libretime.conf.

             Source-connect notification:
               Icecast 2.4 fires the mount_add / mount_remove URLs once
               per source-event lifecycle (this REPLACES 2.5's
               <event-bindings>, which 2.4 doesn't recognise).  We point
               them at the RASTATIME-PLAYOUT HTTP listener on :8770 so
               its source-switcher state machine immediately knows the
               Master DJ is on/off.  (Updating the legacy cc_pref
               master_dj_switch column is currently out of band — the
               PHP /api/update-source-status path is no longer wired;
               the dashboard reads source-state from the playout's
               own state instead.)
             =================================================================== -->
        <!-- RASTATIME 2026-05-14 — Source auth via stream_auth URL.
             Icecast 2.4 documents <option name="stream_auth"> as the
             URL-based pre-admission source-auth hook.  Unlike
             mount_add (post-admission, no user/pass), stream_auth
             fires BEFORE the source is admitted and POSTs
             user+pass+mount+ip etc to our PHP endpoint, so we can
             validate against the LibreTime DB for real (cc_pref for
             /main, cc_subjs+cc_show_hosts for /show).

             No static <password> here — stream_auth is the sole
             auth gate, which gives us multi-DJ-per-mount auth
             (impossible with the basic <password> element, which
             only supports one credential pair per mount).
             Operator-override / DB-down fallback ("source" +
             "master-secret") is implemented inside the PHP. -->
        <authentication type="url">
            <!-- RASTATIME 2026-05-14 — listener_add deliberately
                 omitted: Icecast 2.4 was rejecting roughly half of
                 the parallel listener-add calls from the playout's
                 mpv + 3 FFmpeg-streamer burst with "400 Bad Request"
                 even though the Apache-side PHP endpoint returned
                 200.  The combination of light auth-php and PHP body
                 reformat didn't change the symptom — Icecast 2.4's
                 url-auth parser is finicky under burst load.  Since
                 /main and /show are <hidden>1</hidden> +
                 <public>0</public> and only reachable from 127.0.0.1
                 (Windows firewall blocks them on LAN-facing
                 interfaces), removing listener_add is acceptable —
                 the only realistic listeners are the playout's own
                 mpv + FFmpeg streamers.  Source auth via <password>
                 above stays — no DJ can push without the right
                 credentials. -->
            <!-- RASTATIME 2026-05-14 — Phase B.4 later-list #2:
                 per-DJ source auth against the LibreTime DB via
                 stream_auth, plus DIRECT-to-playout notification for
                 the source lifecycle.  Three URL options:
                   * stream_auth  — pre-admission auth gate.  Icecast
                     POSTs user+pass+mount+ip to our PHP; PHP validates
                     against the DB and returns "icecast-auth-user: 1"
                     to admit or 401 to reject.
                   * mount_add    — post-admission notification.
                     Icecast hits the playout source-switcher on
                     :8770 DIRECTLY (no PHP middle-hop).  Query-
                     string carries source+status; the listener
                     reads them from urlparse(self.path).query.
                   * mount_remove — disconnect notification, same
                     direct route to :8770.
                 Direct-to-:8770 instead of via PHP because we
                 discovered empirically that PHP's async curl
                 (popen + 'start /B') reports popen=ok but the
                 child curl was not reliably delivering to :8770
                 (Windows fcgid+start quirk).  Icecast itself is a
                 long-lived process making proper outbound HTTP,
                 with full retry semantics — much more dependable
                 than spawning a detached child shell from PHP.

                 As of this refactor, public/icecast-source-auth.php
                 only handles ``stream_auth``.  Its sibling
                 public/icecast-source-disconnect.php (used to be
                 the mount_remove target) is a no-op stub now;
                 left in place for safe rollback but not wired.

                 An additional safety net: the playout's source-
                 switcher polls /admin/listmounts every 10 s and
                 reconciles internal state with what Icecast
                 actually reports — see backend/playout/
                 libretime_playout/source_switcher.py.  That
                 catches the occasional 2.4 ``mount_remove`` that
                 simply never fires (root cause unidentified;
                 the watchdog sidesteps it).

                 XML note: ``&`` in the query string is escaped as
                 ``&amp;`` per XML rules; Icecast resolves it back
                 to a real ``&`` before making the request. -->
            <option name="stream_auth"
                    value="http://127.0.0.1/icecast-source-auth.php"/>
            <option name="mount_add"
                    value="http://127.0.0.1:8770/source-event?source=master&amp;status=on"/>
            <option name="mount_remove"
                    value="http://127.0.0.1:8770/source-event?source=master&amp;status=off"/>
        </authentication>
    </mount>

    <mount type="normal">
        <mount-name>/show</mount-name>
        <hidden>1</hidden>
        <public>0</public>
        <!-- Same /main wiring story, but for the Show-DJ slot.  See
             /main mount above for the stream_auth-based rationale.
             Different DJs each authenticate with their own LibreTime
             credentials; PHP looks them up in cc_subjs+cc_show_hosts
             to verify they're assigned to the currently-running show
             (Variant A — strict mode). -->
        <authentication type="url">
            <!-- RASTATIME 2026-05-14 — listener_add was deliberately
                 removed: Icecast 2.4 was rejecting roughly half of
                 the parallel listener-add calls from the playout's
                 mpv + 3 FFmpeg-streamer burst with "400 Bad Request"
                 (visible in icecast access.log as
                  `"GET /main HTTP/1.1" 400 0 ... "Lavf/62.3.100" 7`)
                 even though the Apache-side PHP endpoint returned
                 200.  The combination of light auth-php and PHP body
                 reformat didn't change the symptom — Icecast 2.4's
                 url-auth parser is finicky under burst load.
                 Since /main and /show are <hidden>1</hidden> +
                 <public>0</public> AND only reachable from
                 127.0.0.1 (Windows firewall blocks them on the
                 LAN-facing interface), removing listener_add is
                 acceptable: the only realistic listeners are the
                 playout's own mpv + FFmpeg streamers.  Source
                 auth via <password> above stays — no DJ can push
                 without the right credentials. -->
            <!-- RASTATIME 2026-05-14 — Phase B.4 later-list #2:
                 per-DJ source auth via stream_auth + direct-to-
                 playout mount_add/remove.  See /main above for the
                 architectural rationale.

                 /show auth ruleset in strict mode (Variant A):
                   * Username "source" + password "show-secret" →
                     operator override (DB-down fallback).
                   * Else: a show MUST be running right now AND
                     the supplied user+pass must match either
                       (a) cc_show.live_stream_user / live_stream_pass
                           when the show has live_stream_using_custom_auth,
                       (b) cc_subjs JOIN cc_show_hosts for that show
                           with md5(pass) === cc_subjs.pass when the
                           show has live_stream_using_airtime_auth.
                   * Anything else → 401, source rejected. -->
            <option name="stream_auth"
                    value="http://127.0.0.1/icecast-source-auth.php"/>
            <option name="mount_add"
                    value="http://127.0.0.1:8770/source-event?source=show&amp;status=on"/>
            <option name="mount_remove"
                    value="http://127.0.0.1:8770/source-event?source=show&amp;status=off"/>
        </authentication>
    </mount>

    <!-- RASTATIME 2026-05-13 — low-latency monitor for the Line-In
         capture mount.  The global default <burst-size>65535</burst-size>
         (~2.7 s at 192 kbit/s) is desirable on the PUBLIC mounts
         (/rastatime192, /rastatime-aac, /rastatime-ogg) — listeners
         expect instant audio when they tune in.  But it adds ~2.7 s of
         permanent latency for the LOCAL playout monitor reading
         /linein-capture, which is undesirable when an operator wants
         "near real-time" feedback of their own mic.

         burst-size=0 disables the burst-on-connect for this mount
         only.  Public mounts are unaffected.  Hidden + non-public
         because external listeners should never tune into the raw
         capture mount; it exists only to fan out to the public
         streamers and the local mpv monitor. -->
    <mount type="normal">
        <mount-name>/linein-capture</mount-name>
        <hidden>1</hidden>
        <public>0</public>
        <burst-size>0</burst-size>
    </mount>

    <!-- Normal mounts -->
    <!--
    <mount type="normal">
        <mount-name>/example-complex.ogg</mount-name>

        <max-listeners>1</max-listeners>
        <dump-file>/tmp/dump-example1.ogg</dump-file>
        <burst-size>65536</burst-size>
        <fallback-mount>/example2.ogg</fallback-mount>
        <fallback-override>true</fallback-override>
        <fallback-when-full>true</fallback-when-full>
        <intro>/example_intro.ogg</intro>
        <hidden>true</hidden>
        <public>true</public>
        <authentication>
        </authentication>
        <http-headers>
                <header type="cors" name="Access-Control-Allow-Origin" value="http://webplayer.example.org" />
                <header name="baz" value="quux" />
        </http-headers>

        <event-bindings>
            <event type="exec" trigger="source-connect">
                <option name="executable" value="/home/icecast/bin/stream-start" />
            </event>
            <event type="exec" trigger="source-disconnect">
                <option name="executable" value="/home/icecast/bin/stream-stop" />
            </event>
        </event-bindings>
    </mount>
    -->

    <!--
    <mount type="normal">
        <mount-name>/auth_example.ogg</mount-name>
        <authentication>
        </authentication>
        <event-bindings>
            <event type="url" trigger="source-connect">
                <option name="url" value="http://myauthserver.net/notify_mount.php" />
                <option name="action" value="mount_add" />
            </event>
            <event type="url" trigger="source-disconnect">
                <option name="url" value="http://myauthserver.net/notify_mount.php" />
                <option name="action" value="mount_remove" />
            </event>
        </event-bindings>
    </mount>
    -->

    <!-- Relays can also go into a <mount type="normal"> section -->
    <!--
    <mount type="normal">
        <mount-name>/relay_example.ogg</mount-name>
        <relay>
            <upstream type="normal">
                <uri>http://master0.example.org:8000/example.ogg</uri>
            </upstream>
        </relay>
    </mount>
    -->

    <paths>
        <logdir>C:/rastatime/logs</logdir>
        <!-- RASTATIME 2026-05-13 — absolute paths because NSSM launches
             icecast.exe with a Working-Directory that is NOT the
             install dir (System32 / NSSM's own cwd), and Icecast 2.4
             resolves relative <webroot>/<adminroot> against the cwd.
             That made http://localhost:8000/ return
             "404 Could not parse XSLT file" because Icecast couldn't
             find status.xsl.  Absolute paths sidestep the issue. -->
        <webroot>C:/Tools/Icecast/web</webroot>
        <adminroot>C:/Tools/Icecast/admin</adminroot>

        <!-- Aliases: treat requests for 'source' path as being for 'dest' path
             May be made specific to a port or bound address using the "port"
             and "bind-address" attributes.
          -->
        <!--
        <alias source="/foo" destination="/bar"/>
        -->
        <!-- Aliases: can also be used for simple redirections as well,
             this example will redirect all requests for http://server:port/ to
             the status page
        -->
        <alias source="/" destination="/status.xsl"/>
    </paths>

    <logging>
        <accesslog>access.log</accesslog>
        <errorlog>error.log</errorlog>
        <!-- <playlistlog>playlist.log</playlistlog> -->
        <loglevel>information</loglevel> <!-- "debug", "information", "warning", or "error" -->
        <logsize>10000</logsize> <!-- Max size of a logfile -->
        <!-- If logarchive is enabled (1), then when logsize is reached
             the logfile will be moved to [error|access|playlist].log.DATESTAMP,
             otherwise it will be moved to [error|access|playlist].log.old.
             Default is non-archive mode (i.e. overwrite)
        -->
        <!-- <logarchive>true</logarchive> -->
    </logging>

    <security>
        <tls-context>
            <!-- The certificate file containng public and optionally private key.
                Must be PEM encoded.
                <tls-certificate>./icecast.pem</tls-certificate>
            -->
            <!-- The private key if not contained in <tls-certificate>.
                Must be PEM encoded.
                <tls-key>./icecast.key</tls-key>
            -->
        </tls-context>

        <!-- It is generally helpful to set a PRNG seed, what seed to set depends on your OS. -->
        <!-- Useful on all operating systems is a seed file for Icecast to update.
             This should be at some location that is (semi-)permanent such as /var/lib or /var/cache
             A size of 1024 [byte] is suggested.
             The file can be shared with trusted applications (other instances of Icecast).
             But should be protected against read and write access by untrusted applications.
        <prng-seed type="read-write" size="1024">/path/to/storage/icecast.prng-seed</prng-seed>
        -->
        <!-- If none of above is available on your OS you can add a static seed.
             This is by far not as secure as the above.
             The value should be at least 64 characters long if from [a-zA-Z0-9].
             You MUST keep this parameter secret. It MUST NOT be shared with other instances.
             You SHOULD change this parameter often.
        <prng-seed type="static">U4V5etZF...</prng-seed>
        -->

    </security>
</icecast>
