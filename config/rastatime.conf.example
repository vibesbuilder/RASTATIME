# RASTATIME runtime configuration
# Copy this file to C:\rastatime\config\rastatime.conf and fill in your values.
# All fields can also be overridden via environment variables using the
# RASTATIME_ prefix, e.g. RASTATIME_GENERAL_API_KEY.

general:
  public_url: http://localhost
  # RASTATIME: address the backend services (analyzer, playout) use to call
  # this web application on the machine itself.  Optional; default is
  # http://127.0.0.1 (plus the path of public_url).  Set it when the legacy
  # app is not served on the loopback, e.g. http://192.168.1.64.
  # Environment override: RASTATIME_INTERNAL_URL.
  # internal_url: http://127.0.0.1
  api_key: change-before-production
  secret_key: change-before-production-use-at-least-50-random-chars
  timezone: Europe/Berlin

storage:
  path: C:/rastatime/media

database:
  host: localhost
  port: 5432
  name: rastatime
  user: rastatime
  password: rastatime

rabbitmq:
  host: localhost
  port: 5672
  vhost: /rastatime
  user: rastatime
  password: rastatime

# RASTATIME 2026-09-10 - DJ inputs (Liquidsoap harbors).  Settings ->
# Streams shows these ports and mounts to DJs; PLAYOUT renders the
# harbors from them.  Keep the port away from Icecast (8000).  Logins are
# checked against the web application (Master Source credentials, the
# show's Live Stream Input); stream.harbor.*_password is only the
# fallback while PLAYOUT is unreachable (user "source").
# stream:
#   inputs:
#     main:
#       mount: main
#       port: 8001
#     show:
#       mount: show
#       port: 8001
#   harbor:
#     main_password: change-me
#     show_password: change-me
