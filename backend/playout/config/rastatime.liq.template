# =====================================================================
# rastatime.liq — Liquidsoap script template for RASTATIME
#
# RASTATIME 2026-05-26 — Seamless-Bus-Mix Phase C3
# (production-ready outline; placeholders rendered by
#  rastatime_playout.liquidsoap_config at Pypo start time).
#
# This script is the long-running Liquidsoap subprocess that owns local
# playback, the Icecast outputs and the crossfades (it replaced the
# former mpv + 3x FfmpegStreamer stack, deleted 2026-09-10).  It
# is driven by the Python LiquidsoapPlayoutEngine over telnet (see
# backend/playout/rastatime_playout/engine/liquidsoap_telnet.py).
#
# Placeholders rendered into the final .liq file
# ----------------------------------------------
# (NB: written here without the leading dollar so the renderer does
#  NOT replace them inside this doc block — the actual placeholders
#  below use the dollar prefix.)
#
#   {TELNET_HOST}                   default 127.0.0.1
#   {TELNET_PORT}                   default 1234
#   {LOG_FILE}                      default C:/rastatime/logs/liquidsoap.log
#   {CROSSFADE_BLOCK}               RASTATIME 2026-09-27: the queue
#                                   crossfade - `cross(...)` around the
#                                   request queue with a transition
#                                   function that reads the shape from
#                                   the interactive string `rt_cross`
#                                   (set by PLAYOUT before each push /
#                                   skip).  Track and Show crossfade
#                                   durations come from Settings ->
#                                   General (cc_pref).
#   {LOCAL_OUTPUT_BLOCK}            either output.portaudio(fallible=false,
#                                   mksafe(bridge)) for soundcard
#                                   monitoring (bridge = buffer.adaptative,
#                                   RASTATIME_LIQUIDSOAP_LOCAL_OUTPUT_ADAPTIVE), or a
#                                   commented stub.  Toggled via
#                                   RASTATIME_LIQUIDSOAP_LOCAL_OUTPUT
#                                   (default true on Windows).
#   {HARBOR_INPUTS_BLOCK}           Phase-C4: input.harbor(...) blocks
#                                   for DJ Master + DJ Show sources.
#                                   Rendered only when stream.harbor.
#                                   {main,show}_password are set in
#                                   rastatime.conf.  Empty stub
#                                   otherwise.
#   {BUS_SOURCE_BLOCK}              Phase-C4: defines the `bus` source
#                                   either as plain `scheduled`
#                                   (no harbor) or as
#                                   `switch(track_sensitive=true,
#                                           [(source.is_ready(master_dj),
#                                             master_dj),
#                                            (source.is_ready(show_dj),
#                                             show_dj),
#                                            (true, scheduled)])`
#                                   (with harbor enabled).
#   {ICECAST_OUTPUTS}               rendered output.icecast(...) blocks,
#                                   one per stream_output_N entry in
#                                   cc_pref that is enabled=true.
#                                   Indefinite retry with 5 s backoff.
#
# Phase-C4 will additionally inject input.harbor + switch(...) for the
# DJ-source bus.  Phase-C5 will inject output.file for recording.
# Phase-C6 will wrap the stream with crossfade(...) + amplify(...) for
# replay-gain.  Until those land, the script just plays the
# request.queue with no transitions and no DJ sources.
# =====================================================================

# ---------------------------------------------------------------------
# Settings — applied before any source/output is constructed.
# ---------------------------------------------------------------------

# Telnet server — the line-protocol interface the Python
# LiquidsoapPlayoutEngine talks to.  127.0.0.1 only (no external
# access); the credentials-free Liquidsoap telnet server MUST stay
# loopback-bound to avoid full remote command execution.
settings.server.telnet.set(true)
settings.server.telnet.bind_addr.set("${TELNET_HOST}")
settings.server.telnet.port.set(${TELNET_PORT})
# RASTATIME 2026-09-09 - keep PLAYOUT's two telnet clients connected.
# The default drops a silent client after 30 s; both clients then
# reconnect every 2 min, and every new telnet connection leaks ~262 KB
# on the Windows build (~16 MB/h, the whole idle growth left after the
# event-driven source switcher).  Only loopback clients exist.
settings.server.timeout.set(-1.)

# Single log sink (RASTATIME 2026-09-18): stdout only - NSSM rotates
# it into 10-MB liquidsoap-stdout-<timestamp>.log slices and the
# nightly log janitor archives them.  The file sink is OFF: it
# duplicated every line into an unrotated liquidsoap.log (1 GB in
# 23 days).  The path stays set so flipping file.set(true) is all a
# debugging session needs.  Log level 3 (= info) for production;
# bump to 4 (= debug) when chasing weird Icecast / harbor issues.
settings.log.file.path.set("${LOG_FILE}")
settings.log.file.set(false)
settings.log.stdout.set(true)
settings.log.level.set(3)

# RASTATIME 2026-09-05 - "There are currently N sources, possible
# source leak!" fires at settings.clock.leak_warning (default 50).  Our
# chain has ~45 static sources and every bus transition / queue
# crossfade adds 10-13 short-lived ones (fade_in/fade_out/audio.add/
# source.dynamic/track_audio_amplify) that are collected afterwards;
# 50-63 is normal here, not a leak (clock.dump_all_sources, verified
# 2026-09-05).  200 keeps the warning meaningful for a real leak.
settings.clock.leak_warning.set(200)

# Audio frame size — keep Liquidsoap's default of 0.04 s (40 ms).
# Smaller values reduce latency but cost CPU; larger values batch
# more samples per frame but make crossfades less precise.  0.04 s
# matches the Phase-A burn-in conditions we already validated.

# Disable Liquidsoap's "scripted fallback to silence on any error"
# autosafety net.  We want loud failures during Phase-C development;
# the explicit fallback([request_queue, blank()]) below gives us a
# controlled silence-on-empty path without masking real bugs.
# (settings.scheduler.log.set is the v2.4-flavour name; older Liquidsoaps
#  had settings.frame.audio.sample_rate.set etc. — we use only the
#  options we know are stable on the burn-in build.)

${ICY_METADATA_BLOCK}

# ---------------------------------------------------------------------
# Sources — what audio comes in
# ---------------------------------------------------------------------

# Scheduled tracks: requests pushed by the Python engine via
# request.queue.push.  request.queue is a "primary source" — it
# becomes available only when an item is queued.  We wrap it in
# fallback(..., [scheduled_q, blank()]) so the output.icecast blocks
# downstream always have a frame to encode, even when the scheduler
# has not yet pushed the next track (e.g. silent gap between shows).
#
# track_sensitive=false here is CRITICAL: blank() never emits a
# track-end event, so the OBVIOUS choice (track_sensitive=true)
# would cause Liquidsoap to wait FOREVER for blank() to "finish"
# before switching back to scheduled_q once new requests arrive.
# Sichtbares Symptom: erste push klappt, danach schaltet die
# fallback nie mehr von silence_fallback weg.  Phase-C8 reality-
# test 2026-05-26 hat genau das aufgedeckt.
# RASTATIME 2026-09-05 - synchronous request queue (memory-leak fix).
# Verbatim copy of Liquidsoap 2.4.4's stdlib `request.queue`
# (libs/request.liq) with ONE change: the underlying request.dynamic
# is created with synchronous=true (plus `native` dropped, it does not
# exist in this build).
#
# Why: the savonet Windows build (OCaml 4.14) leaks ~5 KB in every
# Unix.select call of the Duppy scheduler (win32unix select.c,
# SELECTDATA + read_pipe_poll worker; savonet/liquidsoap #1122).  The
# asynchronous fetch task that a `scheduled.push` starts keeps polling
# `next()` every retry_delay (0.1 s) once the queue is empty or a
# request failed - forever, ~33 selects/s, 0.15-0.8 MB/s on the live
# instance (3.4 GB after two hours on 2026-09-05).  With
# synchronous=true the push resolves the request inline in the telnet
# handler (local, already downloaded files: milliseconds) and no
# polling task exists: replicas stayed flat and every push started at
# once, also after a failed push.  `timeout` (set at the call site)
# bounds that inline resolution so an unreadable file cannot hold the
# push - and Pypo's telnet call - for the default 20 s.
#
# Do NOT switch this back to plain request.queue without re-measuring
# the process memory (Get-Process liquidsoap, PrivateMemorySize64).
def request.queue_sync(
  ~id=null,
  ~interactive=true,
  ~prefetch=null,
  ~queue=[],
  ~timeout=null
) =
  id = string.id.default(default="request.queue_sync", id)
  initial_queue = ref(queue)
  queue = ref([])
  fetch = ref(fun () -> ())
  started = ref(false)

  def next() =
    if
      queue() != []
    then
      let [r, ...q] = queue()
      queue := q
      (r : request)
    else
      null
    end
  end

  def push(r) =
    if
      started()
    then
      log.info(
        label=id,
        "Pushing #{r} on the queue."
      )
      queue := [...queue(), r]
      fn = fetch()
      fn()
    else
      log.info(
        label=id,
        "Pushing #{r} on the initial queue."
      )
      initial_queue := [...initial_queue(), r]
    end
  end

  def push_uri(uri) =
    r = request.create(uri)
    push(r)
  end

  default =
    fun () ->
      request.dynamic(
        id=id,
        prefetch=prefetch,
        timeout=timeout,
        synchronous=true,
        available={not list.is_empty(queue())},
        next
      )

  s = default()

  def add(r) =
    log.severe(
      label=s.id(),
      "Please use #{s.id()}.push instead of #{s.id()}.add()"
    )

    s.add(r)
  end

  def set_queue(q) =
    if started() then queue := q else initial_queue := q end
    s.set_queue([])
  end

  def get_queue() =
    [...s.queue(), ...initial_queue(), ...queue()]
  end

  s =
    s.{
      add=add,
      push=push.{uri=push_uri},
      length={list.length(queue()) + list.length(s.queue())},
      set_queue=set_queue,
      queue=get_queue
    }

  s.on_wake_up(
    synchronous=true,
    fun () ->
      begin
        started := true
        s.set_queue(initial_queue())
        initial_queue := []
      end
  )

  fetch := s.fetch

  if
    interactive
  then
    def push(uri) =
      r = request.create(uri)
      push(r)
      "#{request.id(r)}"
    end

    # RASTATIME 2026-11-02 - no "flush_and_skip" here: the stdlib's
    # telnet.liq already registers that command on the underlying
    # request.dynamic at wake-up, and the second registration logged
    # "scheduled.flush_and_skip already registered!" at every start.
    # PLAYOUT uses scheduled.flush + scheduled.skip, never this one.

    s.register_command(
      description="Push a new request in the queue.",
      usage="push <uri>",
      "push",
      push
    )

    def show_queue(_) =
      queue = s.queue()
      string.concat(
        separator=" ",
        list.map(fun (r) -> string(request.id(r)), queue)
      )
    end

    s.register_command(
      description="Display current queue content.",
      usage="queue",
      "queue",
      show_queue
    )

    def skip(_) =
      s.skip()
      "Done."
    end

    s.register_command(
      description="Skip current song.",
      usage="skip",
      "skip",
      skip
    )
  end

  s
end

scheduled_q = request.queue_sync(id="scheduled", timeout=5.0)

# RASTATIME 2026-09-13 - the silence arm carries the Off Air Metadata.
# Every fall from the queue into silence inserts one metadata packet
# (off_air=true + the operator's text); icy_label (ICY block above)
# turns it into the ICY title, so Icecast shows "back on air soon"
# instead of the last track.  The bus switch does the same when it
# lands on the scheduled arm while the queue is empty
# (bus_arm_scheduled in the rendered bus block).
silence_fallback = blank(id="silence_fallback")
def offair_mark() =
  silence_fallback.insert_metadata([("off_air", "true"), ("title", offair_text())])
end
def scheduled_keep(_, new) = new end
def scheduled_offair(_, new) =
  offair_mark()
  new
end

# RASTATIME 2026-09-27 - track / show crossfade (rendered block).  `cross`
# wraps the request queue ONLY: the silence arm stays outside, so a track
# that ends into silence just plays out and a track that starts out of
# silence starts at once - no transition is computed against blank().
# PLAYOUT queues the next track a few seconds ahead (cross needs the
# partner before the old track enters its last BUFFER seconds) and tells
# the transition function which shape to use via `var.set rt_cross`.
${CROSSFADE_BLOCK}

scheduled   = fallback(
                track_sensitive=false,
                # no replay of an old packet when the arm changes: the queue's
                # next track and the silence mark bring their own (2026-09-13)
                replay_metadata=false,
                transitions=[scheduled_keep, scheduled_offair],
                [scheduled_x, silence_fallback]
              )
# Transitions do not fire for the very first selection: mark the silence
# once at startup, so Icecast shows the Off Air text from the first frame
# (harmless if PLAYOUT pushes a track right away - its metadata follows).
offair_mark()

# RASTATIME 2026-09-04 - `scheduled.flush`: drop every PENDING request
# (the one playing is untouched).  request.queue only auto-registers
# push/queue/skip, and skip cannot reach requests that never started
# playing: while a line-in or webstream holds the bus, pushes pile up
# unheard and spill out together the moment the bus falls back to the
# scheduled branch (2026-09-04 11:07: four jingles from 11:00 played
# back-to-back over the next line-in).  Pypo calls this from
# engine.stop(), i.e. on every event transition.
server.register(
  namespace="scheduled",
  description="Drop all pending (not yet playing) requests",
  "flush", fun (_) -> begin scheduled_q.set_queue([]); "Done" end
)

# RASTATIME 2026-09-27 - `scheduled.remaining`: "<rid> <seconds>" - the
# request the queue is on (its RID, as `scheduled.push` returned it) and
# the audio left in it (cue-based; -1 = unknown / idle).  PLAYOUT asks at
# a successor's start whether the predecessor would run on (overbook ->
# cut) or is inside its crossfade tail; measured here, because a track
# that started late (or a clipped row) makes the computed value wrong.
# The RID matters: once cross has pulled the queued successor, the
# queue's current request IS the successor - a skip would hit it (third
# rehearsal 22:20:49).
scheduled_rid = ref("")
scheduled_q.on_track(synchronous=true, fun (m) -> scheduled_rid := m["rid"])
server.register(
  namespace="scheduled",
  description="<rid> <seconds of audio left> of the request the queue is on (-1 = unknown)",
  "remaining", fun (_) -> "#{scheduled_rid()} #{source.remaining(scheduled_q)}"
)

# ---------------------------------------------------------------------
# Phase-C4 — DJ-Source Bus via input.harbor (optional)
# ---------------------------------------------------------------------
#
# input.harbor turns Liquidsoap into a tiny Icecast-source-receiver:
# BUTT/Mixxx connect to ``liquidsoap-host:<port>/<mount>`` with the
# configured password, and we wire the resulting source into the bus
# via switch(...).  source.is_ready(...) returns true automatically
# when a DJ-client is connected; switch picks the first true predicate.
#
# Renderer-Verhalten:
#   * stream.harbor.main_password gesetzt → master_dj block + switch-arm
#   * stream.harbor.show_password gesetzt → show_dj block + switch-arm
#   * beide unset → keine input.harbor, ``bus = scheduled``
${HARBOR_INPUTS_BLOCK}

# ---------------------------------------------------------------------
# Phase-E — Scheduled Webstreams via dynamic input.http (optional)
# ---------------------------------------------------------------------
#
# input.http with start=false is initialised idle (no HTTP connection).
# Pypo's _on_webstream_start calls the telnet sequence
#   webstream.set_url <url>
#   webstream.gain.set <linear_factor>
#   webstream.start
# at show-start time, and webstream.stop at show-end.  source.is_ready
# (set true when input.http has buffered enough audio) drives the switch
# arm — when not connected the source falls through to scheduled.
#
# Why not request.queue.push for webstreams: tested 2026-05-29 and
# request.queue treats HTTP URLs as endless files via procol.external,
# fails the mime-type sniff for "text/html" redirect endpoints, and
# times out after 29 s.  Phase-E reality-test logs in
# C:/rastatime/logs/liquidsoap.log around 10:55:00 + 11:01:05 captured
# the exact failure mode.  input.http is the canonical Liquidsoap
# pattern for persistent HTTP audio sources.
#
# Renderer-Verhalten:
#   * Liquidsoap-Engine aktiv (always in Phase-D+) → webstream source +
#     amplify-wrapper + switch-arm gerendert
#   * Legacy-Pfade ohne Liquidsoap → leerer Stub (kein input.http)
${WEBSTREAM_INPUT_BLOCK}

# ---------------------------------------------------------------------
# Phase-F — Scheduled Line-Inputs via dynamic input.http (optional)
# ---------------------------------------------------------------------
#
# Phase F (2026-05-29) reuses the existing FfmpegLineinCapture Python
# subprocess (managed by Pypo) which captures the operator-selected
# dshow audio device and streams it to a local Icecast mount
# (http://localhost:8000/linein-capture by default).  Liquidsoap
# consumes that local stream via input.http — exactly the same pattern
# as scheduled webstreams (Phase E), only with a fixed URL.
#
# Why NOT input.portaudio directly:
#   * No set_device method at runtime → device switching would require
#     a Liquidsoap restart (5-10 s on-air glitch per show).
#   * No auto-reconnect on USB-cable unplug (FfmpegLineinCapture has a
#     watchdog that handles this transparently today).
#   * device_id is a PortAudio-integer-index, not the Windows audio
#     endpoint GUID we use in the frontend library.
#
# Why NOT input.external.rawaudio with ffmpeg-pipe:
#   * PR savonet/liquidsoap#5139 (2026-05-06): subprocess-EOF can crash
#     Liquidsoap.  Avoided entirely by keeping ffmpeg as a Pypo-managed
#     subprocess + consuming over HTTP.
#
# Pypo's _on_linein_start (in Liquidsoap mode) starts both the
# FfmpegLineinCapture (with the device GUID from the schedule item)
# AND sends the telnet sequence:
#   linein.url http://localhost:8000/linein-capture
#   linein.start
# at show-start time, and linein.stop at show-end (plus stops the
# FfmpegLineinCapture subprocess).
#
# Renderer-Verhalten:
#   * Liquidsoap-Engine aktiv (always in Phase-D+) → linein source +
#     buffer-wrapper + switch-arm gerendert
#   * Legacy-Pfade ohne Liquidsoap → leerer Stub (kein input.http)
${LINEIN_INPUT_BLOCK}

# ---------------------------------------------------------------------
# Crossfade between scheduled tracks
# ---------------------------------------------------------------------
#
# Since 2026-09-27 the crossfade lives in the rendered CROSSFADE_BLOCK
# above (`scheduled_x = cross(...)` around the request queue).  It still
# wraps the scheduled source ONLY - never the bus: DJ sources
# (input.harbor) and webstreams (input.http) are continuous live audio
# and the cross operator rejects self-syncing sources ("Error 7",
# Phase E reality-test 2026-05-29).  Input switches get their own
# transition in the bus block (Default Show Crossfade Duration).

# Bus-Auswahl: switch über Master/Show/Webstream/Scheduled wenn aktiv,
# sonst direkt ``bus = scheduled``.  Renderer-Verhalten siehe oben.
${BUS_SOURCE_BLOCK}

# ---------------------------------------------------------------------
# Phase-C6 — ReplayGain on the bus
# ---------------------------------------------------------------------

# Per-track gain (ReplayGain / EBU R128): since 2026-09-29 applied on the
# request queue in front of the crossfade (CROSSFADE_BLOCK, scheduled_g) -
# amplify(override=...) takes the annotate value replaygain_track_gain at a
# TRACK START, and the bus sees metadata without track marks at crossfade
# transitions, so a bus-level amplify kept the gain of the first track of
# a run.  Webstreams have their own gain on their arm (webstream.gain);
# Line-In and DJ sources play at the level they deliver.

${LOUDNESS_BLOCK}

${STEREOTOOL_BLOCK}

# RASTATIME 2026-09-13 - Stream Label / Off Air text: rewrite every packet
# that carries title, artist, show_name or off_air so its title IS the
# label (icy_rewrite, ICY block above); other packets pass untouched.
# RASTATIME 2026-09-28 - Live Text Info: every metadata packet (before the ICY
# rewrite, so the raw fields are seen) becomes one POST to PLAYOUT when the
# feature is on (livetext_report in the ICY block above).
bus.on_metadata(synchronous=true, livetext_report)
bus = metadata.map(id="icy_rewrite", update=true, strip=false, insert_missing=false, icy_rewrite, bus)

${ALERT_BLANK_BLOCK}

${WEBSTREAM_WATCHDOG_BLOCK}

# ---------------------------------------------------------------------
# Outputs — where the audio goes
# ---------------------------------------------------------------------
#
# One output.icecast block per enabled stream_output_N row in cc_pref.
# The Python renderer (rastatime_playout.liquidsoap_config) substitutes
# the {ICECAST_OUTPUTS} placeholder with the rendered blocks, e.g.::
#
#   output.icecast(
#     %ffmpeg(format="mp3", %audio(codec="libmp3lame", b="128k")),
#     host="localhost",
#     port=8000,
#     password="…",
#     mount="/rastatime",
#     name="RASTATIME",
#     description="…",
#     icy_song=icy_label,   # ICY title per the Stream Label setting (2026-09-13)
#     fallible=true,
#     bus,
#   )
#
# fallible=true allows the output to fail on Icecast-unavailable;
# Liquidsoap then auto-reconnects on its built-in back-off schedule.
# (The 2.4.x `on_error` callback for tighter control over the retry
# wait has a more involved record-typed signature; Phase-C8 may
# refine this with a custom callback once the operator validates the
# default retry behaviour is fast enough.)
${ICECAST_OUTPUTS}

# ---------------------------------------------------------------------
# Phase-C5 — Per-show recording via output.file
# ---------------------------------------------------------------------
#
# output.file with id="recording" so the operator-side Pypo can drive
# its lifecycle via telnet:
#
#   var.set recording_path = "C:/rastatime/recordings/2026-05-27/2026-05-27 18-00 - Show Name.mp3"
#   recording.start
#   ... show plays ...
#   recording.stop
#
# Recording-source = `bus` (post-switch / post-crossfade / post-amplify)
# so what ends up in the file is bit-identical to what the public
# Icecast listeners hear.  No second round-trip through Icecast
# (vs the legacy FfmpegRecorder which pulled /rastatime via HTTP) —
# saves one encode/decode cycle and avoids the 404-race on bring-up.
#
# fallible=true + start=false: by default the output sits idle, neither
# blocking the bus nor writing to disk.  Pypo activates it per show.
#
# Filename comes from an ``interactive.string`` whose value the
# operator-side telnet ``var.set recording_path = "..."`` command
# updates before each ``recording.start``.  Default placeholder is a
# sentinel path so a wild ``recording.start`` without a prior var.set
# lands somewhere obvious + recoverable rather than overwriting a
# random file.  MP3@320kbps fixed per Phase-C5-decision 2026-05-27 —
# Operator chose 320k (archive-grade quality) over Pypo's historical
# PlayoutConfig.record_bitrate 256 / FfmpegRecorder 192 defaults.
#
# NB: in the .liq script we must use the `interactive.string(...)`
# API to declare the variable + dereference its current value.
# `var.get` / `var.set` are TELNET-side commands only — using `var.get`
# in script-code yields `Error 4: Undefined variable var` at parse
# time.  interactive.string returns a function `() -> string` that we
# call from the output.file's filename-function slot.
recording_path = interactive.string(
  "recording_path",
  "C:/rastatime/recordings/_uninitialized.mp3"
)

# Mechanismus B (verified 2026-05-27 in test_c5_mechanism_b.py):
# the explicit ``recording.stop`` -> ``var.set recording_path = NEW``
# -> ``recording.start`` triple-command forces Liquidsoap to
# re-evaluate the filename-function on the new start, opening NEW.
# Reality-test: fresh start lag = 100.6 % of expected (= ~zero lag,
# the small over-shoot is buffer alignment), back-to-back lag =
# 100.3 % with a 31 ms telnet round-trip.  No reopen_when callback
# needed; the start/stop sequence does the path re-evaluation
# naturally.  Older versions of this template used a reopen_when
# ref-based callback to detect path changes mid-stream -- that
# pattern had a ~30 s polling lag and is no longer needed.
#
# NOTE: start=false was the original design but Liquidsoap-2.4.4
# does NOT honour `recording.start` correctly with start=false
# (the file simply never opens, no error, silent failure).
# C5 falls back to default start=true and the
# LiquidsoapPlayoutEngine issues `recording_stop` right after
# engine init to silence the initial sentinel-file write before
# Pypo's first _on_show_record_start hook fires.
# RASTATIME 2026-10-18 - encoder from Settings -> Local Machine -> Show
# Recording (format + bitrate; was a fixed MP3 320k).  The playout picks
# the file extension of the same render (recording_path.build_output_path).
output.file(
  id="recording",
  ${SHOW_RECORDING_ENCODER},
  {recording_path()},
  fallible=true,
  bus,
)

# ---------------------------------------------------------------------
# RASTATIME 2026-06-05 — 24/7 hourly archive recording (optional)
# ---------------------------------------------------------------------
# A second output.file on the `bus`, always on, rotating to a new file
# at each clock-hour boundary — independent of shows, so it captures the
# gaps per-show recording misses (AutoDJ filler, silence, unscheduled
# content, emergencies).  Rendered ONLY when the operator enables it in
# Settings -> Local Machine ("24/7 Recording") and sets a folder;
# otherwise a comment stub.  Phase-1 reality-test 2026-06-05 proved
# hourly rotation + dual-output clock coexistence on Liquidsoap 2.4.4.
${HOURLY_RECORDING_BLOCK}

# ---------------------------------------------------------------------
# Local monitor — what the operator hears at the studio speakers.
# Rendered by rastatime_playout.liquidsoap_config based on the
# RASTATIME_LIQUIDSOAP_LOCAL_OUTPUT env-var (default true; operator
# can disable for headless server installs).
# Uses output.portaudio (cross-platform) — the savonet Windows build
# of Liquidsoap 2.4.4 does NOT ship output.wasapi, so portaudio is
