# =====================================================================
# rastatime.liq — Liquidsoap script template for RASTATIME
#
# RASTATIME 2026-05-26 — Seamless-Bus-Mix Phase C3
# (production-ready outline; placeholders rendered by
#  libretime_playout.liquidsoap_config at Pypo start time).
#
# This script is the long-running Liquidsoap subprocess that replaces
# mpv + 3x FfmpegStreamer + the PHP-side crossfade calculations.  It
# is driven by the Python LiquidsoapPlayoutEngine over telnet (see
# backend/playout/libretime_playout/engine/liquidsoap_telnet.py).
#
# Placeholders rendered into the final .liq file
# ----------------------------------------------
# (NB: written here without the leading dollar so the renderer does
#  NOT replace them inside this doc block — the actual placeholders
#  below use the dollar prefix.)
#
#   {TELNET_HOST}                   default 127.0.0.1
#   {TELNET_PORT}                   default 1234
#   {LOG_FILE}                      default C:/rastatime/logs/liquidsoap.log
#   {CROSSFADE_DURATION}            default 2.0 (seconds) — used in
#                                   crossfade(duration=..., bus).
#                                   Operator can set this from
#                                   cc_pref.default_crossfade_seconds.
#   {LOCAL_OUTPUT_BLOCK}            either output.wasapi(fallible=true, bus)
#                                   for soundcard monitoring, or a
#                                   commented stub.  Toggled via
#                                   RASTATIME_LIQUIDSOAP_LOCAL_OUTPUT
#                                   (default true on Windows).
#   {ICECAST_OUTPUTS}               rendered output.icecast(...) blocks,
#                                   one per stream_output_N entry in
#                                   cc_pref that is enabled=true.
#                                   Indefinite retry with 5 s backoff.
#
# Phase-C4 will additionally inject input.harbor + switch(...) for the
# DJ-source bus.  Phase-C5 will inject output.file for recording.
# Phase-C6 will wrap the stream with crossfade(...) + amplify(...) for
# replay-gain.  Until those land, the script just plays the
# request.queue with no transitions and no DJ sources.
# =====================================================================

# ---------------------------------------------------------------------
# Settings — applied before any source/output is constructed.
# ---------------------------------------------------------------------

# Telnet server — the line-protocol interface the Python
# LiquidsoapPlayoutEngine talks to.  127.0.0.1 only (no external
# access); the credentials-free Liquidsoap telnet server MUST stay
# loopback-bound to avoid full remote command execution.
settings.server.telnet.set(true)
settings.server.telnet.bind_addr.set("${TELNET_HOST}")
settings.server.telnet.port.set(${TELNET_PORT})

# Log to file so the operator can debug after-the-fact.  Path matches
# Pypo's logs/ convention.  Log level 3 (= info) for production; bump
# to 4 (= debug) when chasing weird Icecast / harbor issues.
settings.log.file.path.set("${LOG_FILE}")
settings.log.stdout.set(true)
settings.log.level.set(3)

# Audio frame size — keep Liquidsoap's default of 0.04 s (40 ms).
# Smaller values reduce latency but cost CPU; larger values batch
# more samples per frame but make crossfades less precise.  0.04 s
# matches the Phase-A burn-in conditions we already validated.

# Disable Liquidsoap's "scripted fallback to silence on any error"
# autosafety net.  We want loud failures during Phase-C development;
# the explicit fallback([request_queue, blank()]) below gives us a
# controlled silence-on-empty path without masking real bugs.
# (settings.scheduler.log.set is the v2.4-flavour name; older Liquidsoaps
#  had settings.frame.audio.sample_rate.set etc. — we use only the
#  options we know are stable on the burn-in build.)

# ---------------------------------------------------------------------
# Sources — what audio comes in
# ---------------------------------------------------------------------

# Scheduled tracks: requests pushed by the Python engine via
# request.queue.push.  request.queue is a "primary source" — it
# becomes available only when an item is queued.  We wrap it in
# fallback(..., [scheduled_q, blank()]) so the output.icecast blocks
# downstream always have a frame to encode, even when the scheduler
# has not yet pushed the next track (e.g. silent gap between shows).
#
# track_sensitive=false here is CRITICAL: blank() never emits a
# track-end event, so the OBVIOUS choice (track_sensitive=true)
# would cause Liquidsoap to wait FOREVER for blank() to "finish"
# before switching back to scheduled_q once new requests arrive.
# Sichtbares Symptom: erste push klappt, danach schaltet die
# fallback nie mehr von silence_fallback weg.  Phase-C8 reality-
# test 2026-05-26 hat genau das aufgedeckt.
scheduled_q = request.queue(id="scheduled")
scheduled   = fallback(
                track_sensitive=false,
                [scheduled_q, blank(id="silence_fallback")]
              )

# Phase C4 will add:
#   master_dj = input.harbor("master", port=8001, password=..., buffer=2., icy=true)
#   show_dj   = input.harbor("show",   port=8002, password=..., buffer=2., icy=true)
#   live      = switch(track_sensitive=true, [
#                 ({var.get(default=false, "master_dj_active")}, master_dj),
#                 ({var.get(default=false, "show_dj_active")},   show_dj),
#                 ({true},                                       scheduled),
#               ])
# For Phase C3 the broadcast bus is just the scheduled queue:
bus = scheduled

# ---------------------------------------------------------------------
# Phase-C6 — Crossfade + ReplayGain on the bus
# ---------------------------------------------------------------------

# Crossfade between consecutive request.queue items.  Track-sensitive
# inside the operator so a partial track never gets clipped by an
# incoming next-track event mid-frame.  Duration in seconds is
# substituted from cc_pref.default_crossfade_seconds (operator-set,
# defaults to 2.0 s if unset).  Set duration=0. to disable
# crossfades entirely.
bus = crossfade(duration=${CROSSFADE_DURATION}, bus)

# Replay-gain via amplify(override=...) — Liquidsoap multiplies the
# bus by the "replaygain_track_gain" metadata field when present.
# The LiquidsoapPlayoutEngine sets this field in the annotate:
# envelope (from cc_files.replay_gain + cc_pref.replay_gain_modifier
# for files, or cc_webstream.input_gain_db for webstreams).  Tracks
# without the metadata field play at unity gain — same passthrough
# behaviour mpv has when gain_db is None.
bus = amplify(override="replaygain_track_gain", 1., bus)

# ---------------------------------------------------------------------
# Outputs — where the audio goes
# ---------------------------------------------------------------------
#
# One output.icecast block per enabled stream_output_N row in cc_pref.
# The Python renderer (libretime_playout.liquidsoap_config) substitutes
# the {ICECAST_OUTPUTS} placeholder with the rendered blocks, e.g.::
#
#   output.icecast(
#     %ffmpeg(format="mp3", %audio(codec="libmp3lame", b="128k")),
#     host="localhost",
#     port=8000,
#     password="…",
#     mount="/rastatime",
#     name="RASTATIME",
#     description="…",
#     fallible=true,
#     bus,
#   )
#
# fallible=true allows the output to fail on Icecast-unavailable;
# Liquidsoap then auto-reconnects on its built-in back-off schedule.
# (The 2.4.x `on_error` callback for tighter control over the retry
# wait has a more involved record-typed signature; Phase-C8 may
# refine this with a custom callback once the operator validates the
# default retry behaviour is fast enough.)
${ICECAST_OUTPUTS}

# ---------------------------------------------------------------------
# Local monitor — what the operator hears at the studio speakers.
# Rendered by libretime_playout.liquidsoap_config based on the
# RASTATIME_LIQUIDSOAP_LOCAL_OUTPUT env-var (default true on Windows;
# operator can disable for headless server installs).
# Static WASAPI default-device is the current default — runtime
# device switching from the Dashboard is a Phase-D follow-up.
# ---------------------------------------------------------------------
${LOCAL_OUTPUT_BLOCK}

# ---------------------------------------------------------------------
# Phase-C5 will add the recording output here:
#   output.file(
#     %ffmpeg(format="mp3", %audio(codec="libmp3lame", b="192k")),
#     {recording_filename_for_current_show()},
#     bus,
#     fallible=true,
#     reopen_when={recording_should_reopen()},
#     on_close={recording_post_process()},
#   )
# ---------------------------------------------------------------------
