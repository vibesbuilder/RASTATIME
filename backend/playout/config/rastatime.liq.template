#   output.file(
#     %ffmpeg(format="mp3", %audio(codec="libmp3lame", b="192k")),
#     {recording_filename_for_current_show()},
#     bus,
#     fallible=true,
#     reopen_when={recording_should_reopen()},
#     on_close={recording_post_process()},
#   )
# ---------------------------------------------------------------------
