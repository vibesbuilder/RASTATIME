# =====================================================================
# rastatime.liq — Liquidsoap script template for RASTATIME
#
# RASTATIME 2026-05-26 — Seamless-Bus-Mix Phase C3
# (production-ready outline; placeholders rendered by
#  libretime_playout.liquidsoap_config at Pypo start time).
#
# This script is the long-running Liquidsoap subprocess that replaces
# mpv + 3x FfmpegStreamer + the PHP-side crossfade calculations.  It
# is driven by the Python LiquidsoapPlayoutEngine over telnet (see
# backend/playout/libretime_playout/engine/liquidsoap_telnet.py).
#
# Placeholders rendered into the final .liq file
# ----------------------------------------------
# (NB: written here without the leading dollar so the renderer does
#  NOT replace them inside this doc block — the actual placeholders
#  below use the dollar prefix.)
#
#   {TELNET_HOST}                   default 127.0.0.1
#   {TELNET_PORT}                   default 1234
#   {LOG_FILE}                      default C:/rastatime/logs/liquidsoap.log
#   {CROSSFADE_DURATION}            default 2.0 (seconds) — used in
#                                   crossfade(duration=..., bus).
#                                   Operator can set this from
#                                   cc_pref.default_crossfade_seconds.
#   {LOCAL_OUTPUT_BLOCK}            either output.portaudio(fallible=true, bus)
#                                   for soundcard monitoring, or a
#                                   commented stub.  Toggled via
#                                   RASTATIME_LIQUIDSOAP_LOCAL_OUTPUT
#                                   (default true on Windows).
#   {HARBOR_INPUTS_BLOCK}           Phase-C4: input.harbor(...) blocks
#                                   for DJ Master + DJ Show sources.
#                                   Rendered only when stream.harbor.
#                                   {main,show}_password are set in
#                                   libretime.conf.  Empty stub
#                                   otherwise.
#   {BUS_SOURCE_BLOCK}              Phase-C4: defines the `bus` source
#                                   either as plain `scheduled`
#                                   (no harbor) or as
#                                   `switch(track_sensitive=true,
#                                           [(source.is_ready(master_dj),
#                                             master_dj),
#                                            (source.is_ready(show_dj),
#                                             show_dj),
#                                            (true, scheduled)])`
#                                   (with harbor enabled).
#   {ICECAST_OUTPUTS}               rendered output.icecast(...) blocks,
#                                   one per stream_output_N entry in
#                                   cc_pref that is enabled=true.
#                                   Indefinite retry with 5 s backoff.
#
# Phase-C4 will additionally inject input.harbor + switch(...) for the
# DJ-source bus.  Phase-C5 will inject output.file for recording.
# Phase-C6 will wrap the stream with crossfade(...) + amplify(...) for
# replay-gain.  Until those land, the script just plays the
# request.queue with no transitions and no DJ sources.
# =====================================================================

# ---------------------------------------------------------------------
# Settings — applied before any source/output is constructed.
# ---------------------------------------------------------------------

# Telnet server — the line-protocol interface the Python
# LiquidsoapPlayoutEngine talks to.  127.0.0.1 only (no external
# access); the credentials-free Liquidsoap telnet server MUST stay
# loopback-bound to avoid full remote command execution.
settings.server.telnet.set(true)
settings.server.telnet.bind_addr.set("${TELNET_HOST}")
settings.server.telnet.port.set(${TELNET_PORT})

# Log to file so the operator can debug after-the-fact.  Path matches
# Pypo's logs/ convention.  Log level 3 (= info) for production; bump
# to 4 (= debug) when chasing weird Icecast / harbor issues.
settings.log.file.path.set("${LOG_FILE}")
settings.log.stdout.set(true)
settings.log.level.set(3)

# Audio frame size — keep Liquidsoap's default of 0.04 s (40 ms).
# Smaller values reduce latency but cost CPU; larger values batch
# more samples per frame but make crossfades less precise.  0.04 s
# matches the Phase-A burn-in conditions we already validated.

# Disable Liquidsoap's "scripted fallback to silence on any error"
# autosafety net.  We want loud failures during Phase-C development;
# the explicit fallback([request_queue, blank()]) below gives us a
# controlled silence-on-empty path without masking real bugs.
# (settings.scheduler.log.set is the v2.4-flavour name; older Liquidsoaps
#  had settings.frame.audio.sample_rate.set etc. — we use only the
#  options we know are stable on the burn-in build.)

# ---------------------------------------------------------------------
# Sources — what audio comes in
# ---------------------------------------------------------------------

# Scheduled tracks: requests pushed by the Python engine via
# request.queue.push.  request.queue is a "primary source" — it
# becomes available only when an item is queued.  We wrap it in
# fallback(..., [scheduled_q, blank()]) so the output.icecast blocks
# downstream always have a frame to encode, even when the scheduler
# has not yet pushed the next track (e.g. silent gap between shows).
#
# track_sensitive=false here is CRITICAL: blank() never emits a
# track-end event, so the OBVIOUS choice (track_sensitive=true)
# would cause Liquidsoap to wait FOREVER for blank() to "finish"
# before switching back to scheduled_q once new requests arrive.
# Sichtbares Symptom: erste push klappt, danach schaltet die
# fallback nie mehr von silence_fallback weg.  Phase-C8 reality-
# test 2026-05-26 hat genau das aufgedeckt.
scheduled_q = request.queue(id="scheduled")
scheduled   = fallback(
                track_sensitive=false,
                [scheduled_q, blank(id="silence_fallback")]
              )

# ---------------------------------------------------------------------
# Phase-C4 — DJ-Source Bus via input.harbor (optional)
# ---------------------------------------------------------------------
#
# input.harbor turns Liquidsoap into a tiny Icecast-source-receiver:
# BUTT/Mixxx connect to ``liquidsoap-host:<port>/<mount>`` with the
# configured password, and we wire the resulting source into the bus
# via switch(...).  source.is_ready(...) returns true automatically
# when a DJ-client is connected; switch picks the first true predicate.
#
# Renderer-Verhalten:
#   * stream.harbor.main_password gesetzt → master_dj block + switch-arm
#   * stream.harbor.show_password gesetzt → show_dj block + switch-arm
#   * beide unset → keine input.harbor, ``bus = scheduled``
${HARBOR_INPUTS_BLOCK}

# ---------------------------------------------------------------------
# Phase-E — Scheduled Webstreams via dynamic input.http (optional)
# ---------------------------------------------------------------------
#
# input.http with start=false is initialised idle (no HTTP connection).
# Pypo's _on_webstream_start calls the telnet sequence
#   webstream.set_url <url>
#   webstream.gain.set <linear_factor>
#   webstream.start
# at show-start time, and webstream.stop at show-end.  source.is_ready
# (set true when input.http has buffered enough audio) drives the switch
# arm — when not connected the source falls through to scheduled.
#
# Why not request.queue.push for webstreams: tested 2026-05-29 and
# request.queue treats HTTP URLs as endless files via procol.external,
# fails the mime-type sniff for "text/html" redirect endpoints, and
# times out after 29 s.  Phase-E reality-test logs in
# C:/rastatime/logs/liquidsoap.log around 10:55:00 + 11:01:05 captured
# the exact failure mode.  input.http is the canonical Liquidsoap
# pattern for persistent HTTP audio sources.
#
# Renderer-Verhalten:
#   * Liquidsoap-Engine aktiv (always in Phase-D+) → webstream source +
#     amplify-wrapper + switch-arm gerendert
#   * Legacy-Pfade ohne Liquidsoap → leerer Stub (kein input.http)
${WEBSTREAM_INPUT_BLOCK}

# ---------------------------------------------------------------------
# Phase-C6 — Crossfade between scheduled tracks
# ---------------------------------------------------------------------
#
# Crossfade ONLY around the scheduled source — NOT around the whole
# bus.  DJ-Sources (input.harbor) and Webstreams (input.http) are
# continuous live audio: they don't need track-level crossfades, just
# instant switch-in / switch-out.  Wrapping crossfade around the
# switch-output crashes Liquidsoap with "Error 7: Invalid value: This
# source may control its own latency and cannot be used with this
# operator." — the crossfade operator rejects self-syncing sources.
# Phase E reality-test 2026-05-29 caught this in liquidsoap-stdout.log
# after adding input.http to the switch (input.harbor alone slipped
# through, possibly because of its internal buffer=N parameter, but
# the two together tripped the source-graph latency check).
#
# Duration in seconds substituted from cc_pref.default_crossfade_seconds
# (operator-set, defaults to 2.0 s if unset).  Set duration=0. to
# disable crossfades.  fade_in / fade_out control the fade-zone length;
# 0.0 = hard cuts between ALL tracks (Phase-D Stück-B default — short
# jingles play at full length).
scheduled = crossfade(
  duration=${CROSSFADE_DURATION},
  fade_in=${CROSSFADE_FADE_SECONDS},
  fade_out=${CROSSFADE_FADE_SECONDS},
  scheduled,
)

# Bus-Auswahl: switch über Master/Show/Webstream/Scheduled wenn aktiv,
# sonst direkt ``bus = scheduled``.  Renderer-Verhalten siehe oben.
${BUS_SOURCE_BLOCK}

# ---------------------------------------------------------------------
# Phase-C6 — ReplayGain on the bus
# ---------------------------------------------------------------------

# Replay-gain via amplify(override=...) — Liquidsoap multiplies the
# bus by the "replaygain_track_gain" metadata field when present.
# The LiquidsoapPlayoutEngine sets this field in the annotate:
# envelope (from cc_files.replay_gain + cc_pref.replay_gain_modifier
# for files, or cc_webstream.input_gain_db for webstreams).  Tracks
# without the metadata field play at unity gain — same passthrough
# behaviour mpv has when gain_db is None.
bus = amplify(override="replaygain_track_gain", 1., bus)

# ---------------------------------------------------------------------
# Outputs — where the audio goes
# ---------------------------------------------------------------------
#
# One output.icecast block per enabled stream_output_N row in cc_pref.
# The Python renderer (libretime_playout.liquidsoap_config) substitutes
# the {ICECAST_OUTPUTS} placeholder with the rendered blocks, e.g.::
#
#   output.icecast(
#     %ffmpeg(format="mp3", %audio(codec="libmp3lame", b="128k")),
#     host="localhost",
#     port=8000,
#     password="…",
#     mount="/rastatime",
#     name="RASTATIME",
#     description="…",
#     fallible=true,
#     bus,
#   )
#
# fallible=true allows the output to fail on Icecast-unavailable;
# Liquidsoap then auto-reconnects on its built-in back-off schedule.
# (The 2.4.x `on_error` callback for tighter control over the retry
# wait has a more involved record-typed signature; Phase-C8 may
# refine this with a custom callback once the operator validates the
# default retry behaviour is fast enough.)
${ICECAST_OUTPUTS}

# ---------------------------------------------------------------------
# Phase-C5 — Per-show recording via output.file
# ---------------------------------------------------------------------
#
# output.file with id="recording" so the operator-side Pypo can drive
# its lifecycle via telnet:
#
#   var.set recording_path = "C:/rastatime/recordings/2026-05-27/2026-05-27 18-00 - Show Name.mp3"
#   recording.start
#   ... show plays ...
#   recording.stop
#
# Recording-source = `bus` (post-switch / post-crossfade / post-amplify)
# so what ends up in the file is bit-identical to what the public
# Icecast listeners hear.  No second round-trip through Icecast
# (vs the legacy FfmpegRecorder which pulled /rastatime via HTTP) —
# saves one encode/decode cycle and avoids the 404-race on bring-up.
#
# fallible=true + start=false: by default the output sits idle, neither
# blocking the bus nor writing to disk.  Pypo activates it per show.
#
# Filename comes from an ``interactive.string`` whose value the
# operator-side telnet ``var.set recording_path = "..."`` command
# updates before each ``recording.start``.  Default placeholder is a
# sentinel path so a wild ``recording.start`` without a prior var.set
# lands somewhere obvious + recoverable rather than overwriting a
# random file.  MP3@320kbps fixed per Phase-C5-decision 2026-05-27 —
# Operator chose 320k (archive-grade quality) over Pypo's historical
# PlayoutConfig.record_bitrate 256 / FfmpegRecorder 192 defaults.
#
# NB: in the .liq script we must use the `interactive.string(...)`
# API to declare the variable + dereference its current value.
# `var.get` / `var.set` are TELNET-side commands only — using `var.get`
# in script-code yields `Error 4: Undefined variable var` at parse
# time.  interactive.string returns a function `() -> string` that we
# call from the output.file's filename-function slot.
recording_path = interactive.string(
  "recording_path",
  "C:/rastatime/recordings/_uninitialized.mp3"
)

# Mechanismus B (verified 2026-05-27 in test_c5_mechanism_b.py):
# the explicit ``recording.stop`` -> ``var.set recording_path = NEW``
# -> ``recording.start`` triple-command forces Liquidsoap to
# re-evaluate the filename-function on the new start, opening NEW.
# Reality-test: fresh start lag = 100.6 % of expected (= ~zero lag,
# the small over-shoot is buffer alignment), back-to-back lag =
# 100.3 % with a 31 ms telnet round-trip.  No reopen_when callback
# needed; the start/stop sequence does the path re-evaluation
# naturally.  Older versions of this template used a reopen_when
# ref-based callback to detect path changes mid-stream -- that
# pattern had a ~30 s polling lag and is no longer needed.
#
# NOTE: start=false was the original design but Liquidsoap-2.4.4
# does NOT honour `recording.start` correctly with start=false
# (the file simply never opens, no error, silent failure).
# C5 falls back to default start=true and the
# LiquidsoapPlayoutEngine issues `recording_stop` right after
# engine init to silence the initial sentinel-file write before
# Pypo's first _on_show_record_start hook fires.
output.file(
  id="recording",
  %ffmpeg(format="mp3", %audio(codec="libmp3lame", b="320k")),
  {recording_path()},
  fallible=true,
  bus,
)

# ---------------------------------------------------------------------
# Local monitor — what the operator hears at the studio speakers.
# Rendered by libretime_playout.liquidsoap_config based on the
# RASTATIME_LIQUIDSOAP_LOCAL_OUTPUT env-var (default true; operator
# can disable for headless server installs).
# Uses output.portaudio (cross-platform) — the savonet Windows build
# of Liquidsoap 2.4.4 does NOT ship output.wasapi, so portaudio is
# the natural choice for a Windows soundcard sink.  Runtime device
# switching from the Dashboard is a Phase-D follow-up.
# ---------------------------------------------------------------------
${LOCAL_OUTPUT_BLOCK}

# Phase-C5 recording output is defined above (output.file
# id="recording") between the Icecast outputs and the local
# monitor.  Operator-side Pypo drives its lifecycle via
# engine.recording_start(path) / engine.recording_stop()
# (LiquidsoapPlayoutEngine wrappers around the telnet commands
# recording.stop -> var.set recording_path = ... -> recording.start).
