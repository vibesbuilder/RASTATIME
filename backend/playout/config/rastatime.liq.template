# ---------------------------------------------------------------------
# Source switching — master_dj > show_dj > scheduled
# ---------------------------------------------------------------------
#
# Liquidsoap's switch(track_sensitive=true, [(predicate, source), ...])
# picks the first source whose predicate returns true.  The Python
# engine flips Liquidsoap variables (master_dj.enable, show_dj.enable)
# via var.set when the operator toggles in the Dashboard.
#
# Track-sensitive switching = source change only at request boundaries
# (no mid-track cut).  Crossfade between sources is added separately.
# TODO Phase C.
# stream = switch(track_sensitive=true, [
#   ({master_dj_enabled()}, master_dj),
#   ({show_dj_enabled()},   show_dj),
#   ({true},                scheduled),  # always-on fallback
# ])

# Crossfade between consecutive request.queue items.  Default 2 s
# is what the operator has in cc_pref today (default_crossfade_seconds).
# TODO Phase C — read value from preference at start, or set
# dynamically via var.set.
# stream = crossfade(duration=2., stream)

