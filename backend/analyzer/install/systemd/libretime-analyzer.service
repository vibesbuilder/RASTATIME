[Unit]
Description=RASTATIME Media Analyzer Service
PartOf=libretime.target

[Service]
NoNewPrivileges=true
CapabilityBoundingSet=
PrivateDevices=true
PrivateTmp=true
PrivateUsers=true
ProtectClock=true
ProtectControlGroups=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectProc=invisible
ProtectSystem=full

Environment=PYTHONOPTIMIZE=2
Environment=RASTATIME_CONFIG_FILEPATH=@@CONFIG_FILEPATH@@
Environment=RASTATIME_LOG_FILEPATH=@@LOG_DIR@@/analyzer.log
WorkingDirectory=@@WORKING_DIR@@/analyzer

ExecStart=/usr/local/bin/rastatime-analyzer
Restart=always

User=libretime
Group=libretime

[Install]
WantedBy=multi-user.target
